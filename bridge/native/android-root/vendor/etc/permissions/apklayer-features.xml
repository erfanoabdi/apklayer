<?xml version="1.0" encoding="utf-8"?>
<!-- What an apklayer device declares (the vendor half of Android's feature list); only what the host layers really provide. -->
<permissions>
    <feature name="android.hardware.touchscreen" />
    <feature name="android.hardware.faketouch" />
    <feature name="android.hardware.screen.landscape" />
    <feature name="android.hardware.screen.portrait" />
    <feature name="android.hardware.audio.output" />
    <!-- the audio HAL's capture (every backend records the host's default source) and WifiManager over the host's network (HostNetwork), as Android-x86 declares on Ethernet;
         Play filters by them: CAMERA/RECORD_AUDIO/CHANGE_WIFI_STATE imply camera/microphone/wifi as required (Punishing: Gray Raven was "App not supported" without them) -->
    <feature name="android.hardware.microphone" />
    <feature name="android.hardware.wifi" />
</permissions>
