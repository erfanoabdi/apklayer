# Properties a desktop instance defines itself (loaded after the tree's build.prop files; ro.* are write-once, so these
# only fill what the build files lack). The display values are refined at instance start from the real output.
ro.sf.lcd_density=160
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.boot.hardware=apklayer
ro.hardware=apklayer
ro.hardware.egl=apklayer
ro.hardware.vulkan=apklayer
ro.hardware.gralloc=apklayer
ro.zygote=zygote64
ro.product.cpu.abilist=arm64-v8a
# SurfaceFlinger pre-compiles shaders at startup by rendering into dummy buffers of many formats; one of them cannot be wrapped as a
# render target on the VM's virtio-gpu (Skia: "WrapBackendTexture failed to wrap the texture into a renderable target"). An optimisation
# only: shaders compile at first use instead. To revisit when the failing format is known.
service.sf.prime_shader_cache=0
ro.hyphen.data.dir=/system/usr/hyphen-data
# Use Android's existing gralloc-backed BLOB input and BufferQueue output pools.
debug.stagefright.c2-poolmask=786432
media.c2.hal.selection=aidl
# Android shared-memory queues use the host kernel memfd backend.
sys.use_memfd=true

# keymint (keymaster_configuration.cpp) waits for this property to exist before it registers its services; a build without a vendor image has none of its own: the system patch level
ro.vendor.build.security_patch=2026-10-01
