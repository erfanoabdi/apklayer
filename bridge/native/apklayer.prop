# Properties a desktop instance defines itself (loaded before the tree's build.prop, cli/stack.cpp; ro.* are write-once, so these
# win over the tree's values). The display values are refined at instance start from the real output.
# The version stays the tree's (Android 17, SDK 37): the framework jar apps run against is built from the same tree.
ro.sf.lcd_density=160
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.boot.hardware=apklayer
ro.hardware=apklayer
ro.hardware.egl=apklayer
ro.hardware.vulkan=apklayer
ro.hardware.gralloc=apklayer
ro.zygote=zygote64
# The device an instance presents (what a device's vendor partition defines; the GSI's system values say "generic", which apps take for an emulator).
# Android's Build.* and the native readers both see these; the fingerprint and the CPU ABI lists are derived at stack start (cli/stack.cpp).
# The default is a Google Pixel 5 (redfin, Snapdragon 765G): the same values as bridge/native/profiles/pixel5.prop (tools/device-profile.sh), whose CPU half
# is `berberis.cpuinfo=pixel5` below (the translator's /proc/cpuinfo and MIDR_EL1). `apklayer prop set` overrides any of them per instance; tools/device-profile.sh
# off sets the instance back to the generic desktop (profiles/desktop.prop). ro.hardware stays "apklayer": the graphics and gralloc modules are chosen by it.
berberis.cpuinfo=pixel5
ro.product.brand=google
ro.product.manufacturer=Google
ro.product.model=Pixel 5
ro.product.device=redfin
ro.product.name=redfin
ro.product.board=redfin
ro.board.platform=lito
ro.bootloader=slider-1.2-7683913
ro.soc.manufacturer=Qualcomm
ro.soc.model=SM7250
ro.hardware.chipname=SM7250
ro.build.product=redfin
ro.product.system.brand=google
ro.product.system.manufacturer=Google
ro.product.system.model=Pixel 5
ro.product.system.device=redfin
ro.product.system.name=redfin
ro.product.vendor.brand=google
ro.product.vendor.manufacturer=Google
ro.product.vendor.model=Pixel 5
ro.product.vendor.device=redfin
ro.product.vendor.name=redfin
ro.product.odm.brand=google
ro.product.odm.manufacturer=Google
ro.product.odm.model=Pixel 5
ro.product.odm.device=redfin
ro.product.odm.name=redfin
ro.product.product.brand=google
ro.product.product.manufacturer=Google
ro.product.product.model=Pixel 5
ro.product.product.device=redfin
ro.product.product.name=redfin
ro.product.system_ext.brand=google
ro.product.system_ext.manufacturer=Google
ro.product.system_ext.model=Pixel 5
ro.product.system_ext.device=redfin
ro.product.system_ext.name=redfin
# a release build, as a shipped device reports (the tree is userdebug/test-keys, which root detectors flag); ro.debuggable is the tree's 0. The display id,
# flavor and description that embed them are derived at stack start (cli/stack.cpp).
ro.build.type=user
ro.build.tags=release-keys
ro.system.build.type=user
ro.system.build.tags=release-keys
# a release build's builder (Build.USER/HOST), not the machine that built the tree
ro.build.user=android-build
ro.build.host=localhost
# a phone-class device (the GSI's system build.prop has none; Robolectric's says "robolectric", an emulator image "emulator")
ro.build.characteristics=nosdcard
# SurfaceFlinger pre-compiles shaders at startup by rendering into dummy buffers of many formats; one of them cannot be wrapped as a
# render target on the VM's virtio-gpu (Skia: "WrapBackendTexture failed to wrap the texture into a renderable target"). An optimisation
# only: shaders compile at first use instead. To revisit when the failing format is known.
service.sf.prime_shader_cache=0
ro.hyphen.data.dir=/system/usr/hyphen-data
# Use Android's existing gralloc-backed BLOB input and BufferQueue output pools.
debug.stagefright.c2-poolmask=786432
media.c2.hal.selection=aidl
# Android shared-memory queues use the host kernel memfd backend.
sys.use_memfd=true

# keymint (keymaster_configuration.cpp) waits for this property to exist before it registers its services; a build without a vendor image has none of its own: the system patch level
ro.vendor.build.security_patch=2026-10-01
# what init derives on a device (property_service.cpp: the vendor API level); Java read Robolectric's 202604 before SystemProperties used the store
ro.vendor.api_level=202604
# no local hwservicemanager (HIDL HALs come from the host, libhidl 0001/0002). libhwbinder takes one as installed when /system/bin/hwservicemanager
# exists, which on a Halium device is the device's own, and then waits for this property (always_sets_disabled is the tree's): say it is off.
hwservicemanager.disabled=true
# MediaProvider's database backup (DatabaseBackupAndRecovery: leveldb through its FUSE daemon) needs that daemon, and there is no FUSE here: each
# volume attach otherwise waits 20 s for one (getFuseDaemonForFileWithWait)
persist.sys.fuse.backup.internal_db_backup=false
persist.sys.fuse.backup.external_volume_backup=false
persist.sys.fuse.backup.public_db_backup=false
