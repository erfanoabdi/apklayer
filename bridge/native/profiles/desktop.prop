# Device profile: the generic Linux desktop apklayer used before the Pixel 5 became the default (2026-11-13). tools/device-profile.sh desktop writes these as instance
# overrides, so one instance can present the old identity; the CPU is then the translator's generic Cortex-A55/A53 (no berberis.cpuinfo).
ro.product.brand=lineage
ro.product.manufacturer=LineageOS
ro.product.model=Linux desktop
ro.product.device=desktop
ro.product.name=lineage_desktop
ro.product.board=apklayer
ro.board.platform=apklayer
ro.bootloader=apklayer
ro.soc.manufacturer=apklayer
ro.soc.model=apklayer
ro.hardware.chipname=apklayer
ro.build.product=desktop
ro.build.characteristics=default
ro.product.system.brand=lineage
ro.product.system.manufacturer=LineageOS
ro.product.system.model=Linux desktop
ro.product.system.device=desktop
ro.product.system.name=lineage_desktop
ro.product.vendor.brand=lineage
ro.product.vendor.manufacturer=LineageOS
ro.product.vendor.model=Linux desktop
ro.product.vendor.device=desktop
ro.product.vendor.name=lineage_desktop
ro.product.odm.brand=lineage
ro.product.odm.manufacturer=LineageOS
ro.product.odm.model=Linux desktop
ro.product.odm.device=desktop
ro.product.odm.name=lineage_desktop
