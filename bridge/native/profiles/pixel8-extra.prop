# The Pixel 8 (shiba) properties a retail device sets to the same value on every unit: verified boot as a locked, green device, A/B and
# file-based encryption, the launch API level, the heap the Dalvik runtime hands apps, telephony as a phone without a SIM. Loaded after
# apklayer.prop by cli/stack.cpp loadProperties (ro.* is write-once: an instance override of the same name still wins). Left out on purpose:
# what differs per unit (serial number, vbmeta digest and size, baseband version, IMEI) and what this build cannot honestly claim.
ro.product.first_api_level=34
ro.boot.verifiedbootstate=green
ro.boot.flash.locked=1
ro.boot.vbmeta.device_state=locked
ro.boot.veritymode=enforcing
ro.boot.slot_suffix=_a
ro.boot.bootloader=shusky-15.2-12157576
ro.build.ab_update=true
ro.virtual_ab.enabled=true
ro.crypto.state=encrypted
ro.crypto.type=file
dalvik.vm.heapsize=512m
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapstartsize=8m
dalvik.vm.heapmaxfree=8m
dalvik.vm.heapminfree=512k
dalvik.vm.heaptargetutilization=0.75
gsm.sim.state=ABSENT
gsm.network.type=Unknown
gsm.operator.alpha=
gsm.operator.numeric=
gsm.operator.iso-country=
gsm.operator.isroaming=false
ro.telephony.sim.count=1
ro.config.low_ram=false
ro.zram.enabled=true
persist.sys.dalvik.vm.lib.2=libart.so
dalvik.vm.usejit=true
dalvik.vm.dex2oat64.enabled=true
dalvik.vm.dex2oat-Xms=64m
dalvik.vm.dex2oat-Xmx=512m
dalvik.vm.image-dex2oat-Xms=64m
dalvik.vm.image-dex2oat-Xmx=64m
dalvik.vm.dex2oat-threads=6
dalvik.vm.isa.arm64.variant=cortex-a76
dalvik.vm.isa.arm64.features=default
dalvik.vm.isa.arm.variant=cortex-a76
dalvik.vm.isa.arm.features=default
ro.vndk.version=33
init.svc.adbd=stopped
init.svc.zygote=running
init.svc.zygote_secondary=running
init.svc.servicemanager=running
init.svc.surfaceflinger=running
# What a retail Android 13 Pixel reports the same on every unit and the tree's build.prop lacks (2026-11-14, from the identity matrix): adb needs an
# authorised host, the USB state of an unlocked phone with no cable data, the A/B and dynamic-partition boot flags, the file-based encryption names.
ro.adb.secure=1
sys.usb.state=mtp
sys.usb.config=mtp
ro.bootmode=unknown
ro.boot.dynamic_partitions=true
ro.boot.vbmeta.hash_alg=sha256
ro.boot.vbmeta.invalidate_on_error=yes
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.dm_default_key.options_format.version=2
ro.carrier=unknown
ro.com.android.dateformat=MM-dd-yyyy
ro.com.android.dataroaming=true
# The remaining keys a retail Pixel 8 (shiba) sets to the same value on every unit (2026-11-15; identity matrix: 231 of Android's 635 properties).
# No device dump is kept; the names come from where a device's init gets them: the AOSP tree's system/core/rootdir init.rc, init.usb.rc, the apex init.rc
# files and the build system's partition props (ro.<partition>.build.* are derived in cli/stack.cpp setDerivedProperties), and redfin's device make files.
# Left out on purpose: per-unit values (serial, IMEI, baseband, vbmeta digest), boot timings, and what would change behavior here (ro.hardware.*, ro.sf.*,
# ro.hwui.*, debug.*, bluetooth/vendor feature flags, locale and timezone).
ro.boot.hardware.revision=MP1.0
ro.boot.hardware.sku=GD1YQ
ro.boot.avb_version=1.2
ro.boot.vbmeta.avb_version=1.2
ro.boot.boot_devices=soc/1d84000.ufshc
ro.boot.dtb_idx=0
ro.boot.dtbo_idx=0
ro.boot.force_normal_boot=1
ro.boot.mode=normal
ro.boot.bootreason=reboot
ro.boot.first_stage_console=0
ro.boot.init_fatal_panic=false
ro.boot.wificountrycode=00
ro.product.vendor.cpu.abilist=arm64-v8a,armeabi-v7a,armeabi
ro.product.vendor.cpu.abilist32=armeabi-v7a,armeabi
ro.product.vendor.cpu.abilist64=arm64-v8a
ro.product.odm.cpu.abilist=arm64-v8a,armeabi-v7a,armeabi
ro.product.vendor_dlkm.brand=google
ro.product.vendor_dlkm.device=redfin
ro.product.vendor_dlkm.manufacturer=Google
ro.product.vendor_dlkm.model=Pixel 5
ro.product.vendor_dlkm.name=redfin
ro.product.ab_ota_partitions=boot,dtbo,odm,product,system,system_ext,vbmeta,vbmeta_system,vendor,vendor_boot
ro.vendor.product.cpu.abilist=arm64-v8a,armeabi-v7a,armeabi
ro.vendor.product.cpu.abilist32=armeabi-v7a,armeabi
ro.vendor.product.cpu.abilist64=arm64-v8a
ro.apk_verity.mode=2
ro.control_privapp_permissions=enforce
ro.incremental.enable=yes
ro.fuse_bpf.enabled=true
ro.storage_manager.enabled=true
ro.storage_manager.show_opt_in=false
ro.sys.sdcardfs=false
ro.sys.usb.storage.type=mtp
ro.sys.usb.default.config=none
ro.vold.primary_physical=0
ro.config.alarm_alert=Alarm_Classic.ogg
ro.config.notification_sound=Eureka.ogg
ro.config.ringtone=Ring_Synth_04.ogg
ro.config.media_vol_steps=15
ro.config.vc_call_vol_steps=7
ro.config.sync=true
ro.com.android.wifi-watchlist=true
ro.com.android.prov_mobiledata=false
ro.com.android.mobiledata=false
ro.telephony.default_network=9
ro.telephony.iwlan_operation_mode=legacy
ro.opa.eligible_device=true
ro.setupwizard.rotation_locked=true
ro.recovery_ui_proportion=0.1
ro.logd.size.stats=64K
ro.lmk.use_psi=true
ro.lmk.debug=false
ro.lmk.kill_heaviest_task=true
ro.lmk.kill_timeout_ms=100
ro.lmk.swap_free_low_percentage=10
ro.lmk.thrashing_limit=30
ro.lmk.thrashing_limit_decay=50
ro.lmk.psi_partial_stall_ms=70
ro.lmk.psi_complete_stall_ms=700
ro.audio.monitorRotation=true
ro.camera.notify_nfc=1
ro.usb.bpt=1
sys.boot.reason=reboot
sys.init.perf_lsm_hooks=1
sys.oem_unlock_allowed=0
sys.rescue_boot_count=1
sys.retaildemo.enabled=0
sys.user.0.ce_available=true
init.svc.logd=running
init.svc.logd-reinit=stopped
init.svc.vold=running
init.svc.netd=running
init.svc.installd=running
init.svc.lmkd=running
init.svc.statsd=running
init.svc.tombstoned=running
