// Headers shared by the graphics HAL modules (Soong does not allow ../ include paths).
cc_library_headers {
    name: "libapklayer_gralloc_common_headers",
    export_include_dirs: ["common"],
}

// The host graphics HAL's C API (bridge/hals/graphics/include, copied here by scripts/sync-aosp.sh; the host side is the
// single source). Its functions are not linked: bionic_translation resolves them from the glibc process at load time.
cc_library_headers {
    name: "libapklayer_graphics_host_headers",
    export_include_dirs: ["host-include"],
}
