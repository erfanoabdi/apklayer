// apklayer's gralloc mapper (stable-C IMapper v5), loaded by libui as mapper.apklayer.so in every process that handles
// GraphicBuffers. The host graphics HAL's functions resolve when bionic_translation loads it (allow_undefined_symbols).
cc_library_shared {
    name: "mapper.apklayer",
    srcs: ["Mapper.cpp"],
    local_include_dirs: ["../common", "../host-include"],
    header_libs: ["libdrm_headers", "libbase_headers", "libimapper_stablec", "libimapper_providerutils"],
    shared_libs: [
        "android.hardware.graphics.allocator-V2-ndk",
        "android.hardware.graphics.common-V7-ndk",
        "libbase",
        "libcutils",
        "libgralloctypes",
        "liblog",
    ],
    allow_undefined_symbols: true,
    cpp_std: "c++20",
    cflags: ["-Wall", "-Werror"],
}
