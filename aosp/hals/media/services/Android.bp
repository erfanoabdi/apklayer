// Actual AOSP media services, loaded by the existing native-process launcher.
cc_library_shared {
    name: "libapklayer_mediaserver",
    srcs: ["MediaServices.cpp"],
    include_dirs: ["frameworks/av/services/mediaextractor"],
    shared_libs: ["libmediaextractorservice", "libmediaplayerservice", "libresourcemanagerservice", "libbinder", "libbinder_ndk", "libutils", "liblog"],
    compile_multilib: "64",
    cflags: ["-Wall", "-Werror", "-Wno-main"],
}
