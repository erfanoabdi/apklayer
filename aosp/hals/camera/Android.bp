// The camera provider HAL front: Goldfish's AIDL camera provider (goldfish/: copied unmodified from device/generic/goldfish/hals/camera,
// which is a Soong namespace other modules cannot use) with BackendCamera over the instance's backend (bridge/hals/camera).
cc_library_shared {
    name: "libapklayer_camera",
    srcs: [
        "Service.cpp",
        "BackendCamera.cpp",
        "goldfish/AFStateMachine.cpp",
        "goldfish/AutoNativeHandle.cpp",
        "goldfish/BaseQemuCamera.cpp",
        "goldfish/CachedStreamBuffer.cpp",
        "goldfish/CameraDevice.cpp",
        "goldfish/CameraDeviceSession.cpp",
        "goldfish/CameraProvider.cpp",
        "goldfish/converters.cpp",
        "goldfish/exif.cpp",
        "goldfish/HwCamera.cpp",
        "goldfish/jpeg.cpp",
        "goldfish/metadata_utils.cpp",
        "goldfish/service_entry.cpp",
        "goldfish/StreamBufferCache.cpp",
        "goldfish/utils.cpp",
        "goldfish/yuv.cpp",
    ],
    local_include_dirs: ["goldfish", "host-include"],
    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libcamera_metadata",
        "libcutils",
        "libexif",
        "libfmq",
        "libgralloctypes",
        "libjpeg",
        "liblog",
        "libsync",
        "libui",
        "libutils",
    ],
    static_libs: [
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
        "android.hardware.camera.common-V1-ndk",
        "android.hardware.camera.device-V3-ndk",
        "android.hardware.camera.provider-V3-ndk",
        "libaidlcommonsupport",
        "libyuv_static",
    ],
    version_script: "exports.map",
    allow_undefined_symbols: true, // apklayer_camera_*: the backend, a host library (APKLAYER_HOST_LIBS)
    compile_multilib: "64",
    cflags: ["-Wno-main", "-DLOG_TAG=\"apklayer.camera\""], // Goldfish's sources build with the tree's default warnings (they trip -Wall -Werror)
}
