// The real Android keystore on the device libraries: keystore2 (the tree's Rust source, copied as keystore2_main.rs plus an exported `main`) and the
// reference software KeyMint (service.cpp of hardware/interfaces/security/keymint/aidl/default), each as a library whose main btload calls.
rust_ffi_shared {
    name: "libapklayer_keystore2",
    crate_name: "apklayer_keystore2",
    srcs: ["keystore2_main.rs"],
    rustlibs: [
        "libandroid_logger",
        "libandroid_security_flags_rust",
        "libbinder_rs",
        "liblog_rust",
        "libkeystore2",
        "liblegacykeystore-rust",
        "librusqlite",
    ],
    prefer_rlib: true,
}

cc_library_shared {
    name: "libapklayer_keymint",
    vendor: true,
    cflags: ["-Wall", "-Wextra"],
    defaults: ["keymint_cpp_impl_hal_aidl_ndk_shared"],
    shared_libs: [
        "android.hardware.security.rkp-V3-ndk",
        "android.hardware.security.sharedsecret-V1-ndk",
        "android.hardware.security.secureclock-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libcppbor",
        "libcrypto",
        "libkeymaster_portable",
        "libkeymint",
        "liblog",
        "libpuresoftkeymasterdevice",
        "libutils",
    ],
    srcs: ["keymint_service.cpp"],
    compile_multilib: "64",
    allow_undefined_symbols: true,
}

// The software Gatekeeper and gatekeeperd (the lock screen credential's checker, for auth-bound keys): the tree's own sources, each as a library whose
// main btload calls. The HAL compiles the tree's GateKeeper.cpp, SharedSecret.cpp and service.cpp through gatekeeper_service.cpp; gatekeeperd takes
// main.cpp as a copy (gatekeeperd_main.cpp), which includes the tree's gatekeeperd.cpp.
cc_library_shared {
    name: "libapklayer_gatekeeper",
    vendor: true,
    cflags: ["-Wall", "-Werror"],
    include_dirs: ["hardware/interfaces/gatekeeper/aidl/software"],
    shared_libs: [
        "android.hardware.gatekeeper-V1-ndk",
        "android.hardware.security.sharedsecret-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libcrypto",
        "libcutils",
        "libgatekeeper",
        "libhardware",
        "libkeymaster_portable",
        "liblog",
        "libutils",
    ],
    static_libs: ["libscrypt_static"],
    srcs: ["gatekeeper_service.cpp"],
    compile_multilib: "64",
    allow_undefined_symbols: true,
}

cc_library_shared {
    name: "libapklayer_gatekeeperd",
    // gatekeeperd_defaults' own srcs would resolve here: its libraries as they are
    defaults: ["keymint_use_latest_hal_aidl_ndk_shared"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-Wunused"],
    shared_libs: [
        "libbinder",
        "libbinder_ndk",
        "libgatekeeper",
        "libgsi",
        "liblog",
        "libhardware",
        "libbase",
        "libutils",
        "libcrypto",
        "libhidlbase",
        "android.hardware.gatekeeper-V1-ndk",
        "android.hardware.gatekeeper@1.0",
        "libgatekeeper_aidl",
        "android.security.authorization-ndk",
    ],
    static_libs: ["libscrypt_static"],
    include_dirs: ["system/core/gatekeeperd", "external/scrypt/lib/crypto"],
    srcs: ["gatekeeperd_main.cpp"],
    compile_multilib: "64",
    allow_undefined_symbols: true,
}
