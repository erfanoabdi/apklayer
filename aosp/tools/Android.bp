cc_library_shared {
    name: "libapklayer_servicetool",
    srcs: ["servicetool.cpp"],
    shared_libs: ["libbinder", "libutils", "liblog"],
    compile_multilib: "64",
    cflags: ["-Wall", "-Werror", "-Wno-main"],
}

// HIDL through the host hwbinder context (docs/HALIUM.md): the device role of the two-instance test (atrace@1.0 as the test HAL), and
// HIDL clients that list a device's cameras and codecs.
cc_library_shared {
    name: "libapklayer_hidltool",
    srcs: ["hidltool.cpp"],
    shared_libs: [
        "libhidlbase",
        "libutils",
        "liblog",
        "android.hardware.atrace@1.0",
        "android.hardware.camera.provider@2.4",
        "android.hardware.camera.common@1.0",
        "android.hardware.media.c2@1.0",
        "android.hidl.manager@1.0",
    ],
    compile_multilib: "64",
    cflags: ["-Wall", "-Werror", "-Wno-main"],
}

// Whole-stack smoke test: a layer with GraphicBuffers shown through SurfaceFlinger.
cc_library_shared {
    name: "libapklayer_sftest",
    srcs: ["sftest.cpp"],
    shared_libs: ["libgui", "libui", "libutils", "libbinder", "liblog", "libcutils"],
    cflags: ["-Wall", "-Werror", "-Wno-main"],
}

// Per-app screenshot: SurfaceFlinger's captureDisplay of one app's virtual display, written as PNG (apklayer screenshot).
cc_library_shared {
    name: "libapklayer_screenshot",
    srcs: ["screenshot.cpp"],
    shared_libs: ["libgui", "libui", "libutils", "libbinder", "liblog", "libz"],
    compile_multilib: "64",
    cflags: ["-Wall", "-Werror", "-Wno-main"],
}

// EGL window-surface smoke test: GL ES rendering into a BufferQueue layer through libapklayer_egl.
cc_library_shared {
    name: "libapklayer_gltest",
    srcs: ["gltest.cpp"],
    shared_libs: ["libgui", "libui", "libutils", "libbinder", "liblog", "libcutils", "libEGL"],
    header_libs: ["libEGL_headers"],
    cflags: ["-Wall", "-Werror", "-Wno-main"],
}

// Original Android Vulkan loader + real host command/readback regression.
cc_library_shared {
    name: "libapklayer_vktest",
    srcs: ["vktest.cpp"],
    header_libs: ["vulkan_headers", "hwvulkan_headers", "jni_headers", "libnativewindow_headers", "libarect_headers"],  // vk_android_native_buffer.h, android/hardware_buffer.h and its android/rect.h
    shared_libs: ["libdl", "libnativewindow"],  // AHardwareBuffer_allocate/describe/getNativeHandle
    cflags: ["-Wall", "-Werror", "-Wno-main", "-Wno-missing-field-initializers"],
}
