// Properties: the instance's Android property overrides (`apklayer prop`) over apklayer's device defaults (bridge/native/apklayer.prop).
// They are loaded when the instance's services start, so a change applies after a restart.
import { MaterialPalette, MaterialTypography, MaterialStyleMetrics, MaterialText, ScrollView, TonalButton, FilledButton, FilledCard } from "@material";
import { Backend, AppIcons, PropEntry } from "backend.slint";
import { Row, Tag, Heading } from "widgets.slint";

export component PropsPage {
    callback edit(entry: PropEntry);

    ScrollView {
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                max-width: 840px;
                padding: MaterialStyleMetrics.padding_16;
                padding-bottom: 96px;
                spacing: MaterialStyleMetrics.spacing_8;
                alignment: start;
                FilledCard {
                    VerticalLayout {
                        padding: MaterialStyleMetrics.padding_16;
                        spacing: MaterialStyleMetrics.spacing_12;
                        MaterialText {
                            text: "Android properties of instance " + Backend.instance + ". Overrides take effect the next time its services start; ro.* values are fixed while it runs.";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface;
                            wrap: word-wrap;
                        }
                        if Backend.instance-running : HorizontalLayout {
                            alignment: start;
                            TonalButton { text: "Restart instance"; icon: AppIcons.restart; clicked => { Backend.stop-instance(Backend.instance); } }
                        }
                    }
                }
                FilledCard {
                    VerticalLayout {
                        padding: MaterialStyleMetrics.padding_16;
                        spacing: MaterialStyleMetrics.spacing_12;
                        MaterialText {
                            text: "Colour scheme of instance " + Backend.instance + ": its apps and title bars, applied at once (apklayer settings has the other host settings).";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: MaterialStyleMetrics.spacing_8;
                            for choice in [{ label: "Follow the desktop", value: "" }, { label: "Light", value: "no" }, { label: "Dark", value: "yes" }] : HorizontalLayout {
                                if Backend.night-setting == choice.value : FilledButton { text: choice.label; }
                                if Backend.night-setting != choice.value : TonalButton { text: choice.label; clicked => { Backend.set-setting("night", choice.value); } }
                            }
                        }
                    }
                }
                FilledCard {
                    VerticalLayout {
                        padding: MaterialStyleMetrics.padding_16;
                        spacing: MaterialStyleMetrics.spacing_12;
                        MaterialText {
                            text: "Window style of instance " + Backend.instance + ": mobile (maximized, a navigation bar with Back and Home, no title bar) or desktop (floating windows). Automatic is mobile on a phone or in a mobile shell; applied at once. A single app: apklayer settings set window-mode.<package> ...";
                            style: MaterialTypography.body_medium;
                            color: MaterialPalette.on_surface;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: MaterialStyleMetrics.spacing_8;
                            for choice in [{ label: "Automatic", value: "" }, { label: "Mobile", value: "mobile" }, { label: "Desktop", value: "desktop" }] : HorizontalLayout {
                                if Backend.window-mode-setting == choice.value : FilledButton { text: choice.label; }
                                if Backend.window-mode-setting != choice.value : TonalButton { text: choice.label; clicked => { Backend.set-setting("window-mode", choice.value); } }
                            }
                        }
                    }
                }
                for p in Backend.props : Row {
                    text: p.key;
                    supporting-text: p.value + (p.live != "" && p.live != p.value ? "   (running: " + p.live + ")" : "");
                    clicked => { root.edit(p); }
                    if p.source == "instance" : Tag { text: "Override"; strong: true; }
                }
            }
        }
    }
}
