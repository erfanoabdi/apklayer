// Hardware: the selected instance's hardware providers (`apklayer providers`): per domain the backend (with its probe() answer), its options,
// Apply, and a live test against the running instance. A change restarts only that domain's service.
import { MaterialPalette, MaterialTypography, MaterialStyleMetrics, MaterialText, ScrollView, OutlinedCard, DropDownMenu, TextField, FilledButton,
         TonalButton, Icon } from "@material";
import { Backend, AppIcons, HwDomain, HwOption } from "backend.slint";

// one option's field: follows its value (a chosen file) unless being typed into
component OptionField {
    in property <HwOption> option;
    in property <string> domain;
    in property <int> backend;
    changed option => { if !field.has-focus { field.text = root.option.value; } }
    // a layout fills the component (a bare TextField would keep its preferred width)
    HorizontalLayout { field := TextField {
        label: root.option.key;
        accessible-label: root.domain + " " + root.option.key;
        supporting_text: root.option.default-value != "" ? "Default: " + root.option.default-value : root.option.file ? "A file" : "";
        text: root.option.value;
        trailing_icon: root.option.file ? AppIcons.folder : @image-url("");
        trailing_icon_clicked => { Backend.provider-file(root.domain, root.backend, root.option.key); }
        edited(t) => { Backend.provider-option(root.domain, root.backend, root.option.key, t); }
    } }
}

component DomainCard {
    in property <HwDomain> domain;
    property <int> chosen: root.domain.current;  // the menu's choice until Apply
    changed domain => { root.chosen = root.domain.current; }

    function icon(name: string) -> image {
        if name == "sensors" { return AppIcons.sensors; }
        if name == "gnss" { return AppIcons.location; }
        if name == "vibrator" { return AppIcons.vibration; }
        if name == "camera" { return AppIcons.camera; }
        AppIcons.board
    }

    VerticalLayout { OutlinedCard {
        VerticalLayout {
            padding: MaterialStyleMetrics.padding_16;
            spacing: MaterialStyleMetrics.spacing_12;
            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_16;
                VerticalLayout {
                    alignment: center;
                    Icon { width: MaterialStyleMetrics.icon_size_24; source: root.icon(root.domain.name); colorize: MaterialPalette.on_surface_variant; }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    MaterialText { text: root.domain.title; style: MaterialTypography.body_large; color: MaterialPalette.on_surface; overflow: elide; }
                    MaterialText {
                        text: root.domain.configured != "" ? root.domain.configured : "Not set: apps see none";
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                        overflow: elide;
                    }
                }
            }
            DropDownMenu {
                // DropDownMenu shows no text of its own before a selection
                label: "Backend" + (root.chosen >= 0 && root.chosen < root.domain.menu.length ? ": " + root.domain.menu[root.chosen].text : "");
                items: root.domain.menu;
                current_index: root.chosen;
                enabled: !Backend.busy;
                selected(i) => { root.chosen = i; }
            }
            for o in root.domain.backends[root.chosen].options : OptionField { option: o; domain: root.domain.name; backend: root.chosen; }
            HorizontalLayout {
                alignment: start;
                spacing: MaterialStyleMetrics.spacing_8;
                FilledButton {
                    text: "Apply";
                    accessible-label: "Apply " + root.domain.name;
                    enabled: !Backend.busy;
                    clicked => { Backend.set-provider(root.domain.name, root.chosen); }
                }
                if root.domain.test != "" : TonalButton {
                    text: root.domain.test;
                    icon: AppIcons.play;
                    enabled: Backend.instance-running && root.chosen == root.domain.current;
                    clicked => { Backend.test-provider(root.domain.name); }
                }
            }
        }
    } }
}

export component HardwarePage {
    ScrollView {
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                max-width: 840px;
                padding: MaterialStyleMetrics.padding_16;
                padding-bottom: 96px;
                spacing: MaterialStyleMetrics.spacing_8;
                alignment: start;
                MaterialText {
                    text: "What instance " + Backend.instance + " offers its apps as sensors, location, vibrator and camera. Apply restarts only that service; the test runs against the running instance.";
                    style: MaterialTypography.body_medium;
                    color: MaterialPalette.on_surface_variant;
                    wrap: word-wrap;
                }
                for d in Backend.hardware : DomainCard { domain: d; }
            }
        }
    }
}
