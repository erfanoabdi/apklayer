// What the C++ side (src/main.cpp) fills in and answers: the rows of the apklayer CLI and the actions on them.

// system: a system app (`apklayer install --system`); in-drawer: its launcher shows in the desktop's app drawer
export struct AppEntry { package: string, label: string, version: string, icon: image, running: bool, system: bool, in-drawer: bool }
export struct InstanceEntry { id: string, running: bool, binder: bool, root: string }
export struct PropEntry { key: string, value: string, source: string, live: string }
export struct InfoEntry { key: string, value: string }
// `apklayer permissions`: runtime ones (dangerous) can be granted and revoked; state: what the others' grant is ("Granted", "Not granted", ...)
export struct PermEntry { name: string, title: string, runtime: bool, granted: bool, state: string }

// a first-run step (src/setup.cpp): id binder|runtime|instance|system-apps|microg|fdroid; state: "", "Done", "Failed", "Skipped"
export struct SetupStep { id: string, title: string, detail: string, state: string, running: bool }

export global Backend {
    // the first run's checklist (FirstRunPage) and its choices
    in property <bool> first-run;
    in property <[SetupStep]> setup-steps;
    in property <bool> setup-running;
    in property <bool> setup-done;
    in property <float> setup-progress;    // of the running step: 0..1, negative while its size is unknown
    callback setup-start(bool, bool);  // with microG, with F-Droid
    callback setup-finish();
    // the update banner (UpdateBanner): an update of apklayer or its runtime, or stale apps to convert again; title "" hides it
    in property <string> update-title;
    in property <string> update-detail;
    in property <string> update-action;    // the button: "Update", "Convert again", "" none
    in property <string> update-notes-url;
    in property <bool> updating;
    in property <float> update-progress;
    callback update-now();
    callback open-notes();
    callback dismiss-update();

    in property <[AppEntry]> apps;
    in property <[InstanceEntry]> instances;
    in property <[PropEntry]> props;
    in property <[InfoEntry]> status;
    in property <AppEntry> current-app;   // the app selected with select-app, and its info rows
    in property <bool> has-current-app;
    in property <[InfoEntry]> app-info;
    in property <[PermEntry]> app-permissions;
    in property <string> permissions-note;  // why the list is empty (an install that predates the list)
    in property <string> instance: "default";
    in property <bool> instance-running;
    in property <bool> busy;               // a long action (install, uninstall, instance setup) runs
    in property <string> busy-text;
    in property <string> message;          // the latest result, shown in the snackbar
    in property <int> message-serial;
    in property <string> load-error;       // the last refresh's failing CLI call: an empty list is then no empty state      // bumped with every message (the same text twice shows twice)
    in property <string> binder-command;   // set when a new instance still needs its binder devices
    in property <string> binder-instance;
    in property <int> binder-serial;       // bumped to show the binder dialog
    in property <string> chosen-path;      // what the file chooser returned

    callback refresh();
    callback install-chooser();            // the desktop's file chooser (portal), then install
    callback install-path(string);
    callback open-app(string);
    callback stop-app(string);
    callback clear-data(string);
    callback uninstall(string);
    callback set-permission(string, string, bool);  // package, permission, granted
    callback set-drawer(string, bool);     // package, shown in the app drawer (`apklayer launcher show|hide`)
    callback select-app(string);
    callback select-instance(string);
    callback create-instance(string);
    callback remove-instance(string);
    callback setup-binder(string);         // pkexec the setup script
    callback stop-instance(string);
    callback set-prop(string, string);
    callback unset-prop(string);
    in property <string> night-setting;    // the instance's colour scheme override (`apklayer settings`): "" follows the desktop, "yes" dark, "no" light
    callback set-setting(string, string);  // key, value ("" unsets): applied at once in a running instance
}

export global AppIcons {
    out property <image> apps: @image-url("icons/apps.svg");
    out property <image> layers: @image-url("icons/layers.svg");
    out property <image> tune: @image-url("icons/tune.svg");
    out property <image> memory: @image-url("icons/memory.svg");
    out property <image> add: @image-url("icons/add.svg");
    out property <image> delete: @image-url("icons/delete.svg");
    out property <image> play: @image-url("icons/play_arrow.svg");
    out property <image> stop: @image-url("icons/stop.svg");
    out property <image> refresh: @image-url("icons/refresh.svg");
    out property <image> clean: @image-url("icons/cleaning_services.svg");
    out property <image> folder: @image-url("icons/folder_open.svg");
    out property <image> dark: @image-url("icons/dark_mode.svg");
    out property <image> light: @image-url("icons/light_mode.svg");
    out property <image> back: @image-url("icons/arrow_back.svg");
    out property <image> restart: @image-url("icons/restart_alt.svg");
    out property <image> audio: @image-url("icons/graphic_eq.svg");
    out property <image> battery: @image-url("icons/battery_full.svg");
    out property <image> location: @image-url("icons/location_on.svg");
    out property <image> board: @image-url("icons/developer_board.svg");
    out property <image> admin: @image-url("icons/admin_panel_settings.svg");
}
