// Apps: the M3 list-detail layout. Side by side when the window is expanded (>= 840 dp), else the list, and the detail over it with a back button.
import { MaterialPalette, MaterialTypography, MaterialStyleMetrics, MaterialText, ScrollView, FilledButton, TonalButton, OutlineButton,
         IconButton, OutlinedCard, HorizontalDivider, VerticalDivider, Switch, FilterChip } from "@material";
import { Backend, AppIcons, AppEntry } from "backend.slint";
import { Row, Tag, Heading } from "widgets.slint";
import { AddonsSection } from "addons.slint";
import { ConfigRows } from "settings.slint";

component AppDetail {
    in property <AppEntry> app;
    in property <bool> show-back;
    callback back();
    callback confirm(kind: string, target: string);

    ScrollView {
        VerticalLayout {
            padding: MaterialStyleMetrics.padding_24;
            spacing: MaterialStyleMetrics.spacing_16;
            alignment: start;
            if root.show-back : HorizontalLayout {
                alignment: start;
                IconButton { icon: AppIcons.back; tooltip: "Back"; clicked => { root.back(); } }
            }
            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_16;
                Rectangle {
                    width: MaterialStyleMetrics.size_72;
                    height: MaterialStyleMetrics.size_72;
                    border-radius: MaterialStyleMetrics.border_radius_16;
                    clip: true;
                    Image { width: 100%; height: 100%; source: root.app.icon; image-fit: contain; }
                }
                VerticalLayout {
                    alignment: center;
                    MaterialText { text: root.app.label; style: MaterialTypography.headline_small; color: MaterialPalette.on_surface; overflow: elide; }
                    MaterialText { text: root.app.package; style: MaterialTypography.body_medium; color: MaterialPalette.on_surface_variant; overflow: elide; }
                    if root.app.version != "" : MaterialText { text: "Version " + root.app.version; style: MaterialTypography.body_medium; color: MaterialPalette.on_surface_variant; overflow: elide; }
                }
                if root.app.system : VerticalLayout { alignment: center; Tag { text: "System"; } }
            }
            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;
                alignment: start;
                FilledButton { text: root.app.running ? "Open again" : "Open"; icon: AppIcons.play; enabled: !Backend.busy; clicked => { Backend.open-app(root.app.package); } }
                if root.app.running : TonalButton { text: "Stop"; icon: AppIcons.stop; clicked => { Backend.stop-app(root.app.package); } }
            }
            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;
                alignment: start;
                OutlineButton { text: "Clear data…"; icon: AppIcons.clean; enabled: !Backend.busy; clicked => { root.confirm("clear-data", root.app.package); } }
                OutlineButton { text: "Uninstall…"; icon: AppIcons.delete; enabled: !Backend.busy; clicked => { root.confirm("uninstall", root.app.package); } }
            }
            OutlinedCard {
                VerticalLayout {
                    padding-top: MaterialStyleMetrics.padding_8;
                    padding-bottom: MaterialStyleMetrics.padding_8;
                    Row {
                        text: "Show in app drawer";
                        supporting-text: root.app.system ? "A system app: hidden unless shown" : "The app's launcher in the desktop's app drawer";
                        clickable: false;
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                width: MaterialStyleMetrics.size_52;
                                checked: root.app.in-drawer;
                                enabled: !Backend.busy;
                                accessible-label: "Show in app drawer";
                                checked-state-changed(on) => { Backend.set-drawer(root.app.package, on); }
                            }
                        }
                    }
                    if root.app.translated : Row {
                        text: "Lite translation";
                        supporting-text: "Its ARM code without the optimizing translator: slower, for games that draw wrong otherwise. From its next start";
                        clickable: false;
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                width: MaterialStyleMetrics.size_52;
                                checked: root.app.lite;
                                enabled: !Backend.busy;
                                accessible-label: "Lite translation";
                                checked-state-changed(on) => { Backend.set-lite(root.app.package, on); }
                            }
                        }
                    }
                }
            }
            OutlinedCard {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_8;
                    MaterialText { text: "Window style of this app"; style: MaterialTypography.title_medium; color: MaterialPalette.on_surface; }
                    MaterialText { text: "Mobile (maximized, navigation bar) or desktop (floating window); the default follows the instance. Applied at once."; style: MaterialTypography.body_medium; color: MaterialPalette.on_surface_variant; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: MaterialStyleMetrics.spacing_8;
                        for choice in [{ label: "Default", value: "" }, { label: "Mobile", value: "mobile" }, { label: "Desktop", value: "desktop" }] : HorizontalLayout {
                            if Backend.app-window-mode-setting == choice.value : FilledButton { text: choice.label; }
                            if Backend.app-window-mode-setting != choice.value : TonalButton { text: choice.label; enabled: !Backend.busy; clicked => { Backend.set-setting("window-mode." + root.app.package, choice.value); } }
                        }
                    }
                }
            }
            if Backend.app-config.length > 0 : Heading { text: "Settings of this app"; }
            if Backend.app-config.length > 0 : MaterialText { text: "A change applies at the app's next cold start: stop the app (or it restarts on its own) for it to take effect."; style: MaterialTypography.body_medium; color: MaterialPalette.on_surface_variant; wrap: word-wrap; }
            if Backend.app-config.length > 0 : OutlinedCard {
                ConfigRows { entries: Backend.app-config; app: root.app.package; }
            }
            Heading { text: "Permissions"; }
            if Backend.permissions-note != "" : MaterialText {
                text: Backend.permissions-note; style: MaterialTypography.body_medium; color: MaterialPalette.on_surface_variant; wrap: word-wrap;
            }
            if Backend.app-permissions.length > 0 : OutlinedCard {
                VerticalLayout {
                    padding-top: MaterialStyleMetrics.padding_8;
                    padding-bottom: MaterialStyleMetrics.padding_8;
                    for p in Backend.app-permissions : Row {
                        text: p.title;
                        supporting-text: p.name;
                        clickable: false;
                        if p.runtime : VerticalLayout {
                            alignment: center;
                            Switch {
                                width: MaterialStyleMetrics.size_52;  // M3's track: the component only sets a minimum and would fill the row
                                checked: p.granted;
                                enabled: !Backend.busy;
                                accessible-label: "Allow " + p.title;
                                checked-state-changed(on) => { Backend.set-permission(root.app.package, p.name, on); }
                            }
                        }
                        if !p.runtime : Tag { text: p.state; }
                    }
                }
            }
            Heading { text: "App info"; }
            OutlinedCard {
                VerticalLayout {
                    padding-top: MaterialStyleMetrics.padding_8;
                    padding-bottom: MaterialStyleMetrics.padding_8;
                    for row in Backend.app-info : Row { text: row.key; supporting-text: row.value; clickable: false; }
                }
            }
        }
    }
}

export component AppsPage {
    in property <bool> two-pane;
    in-out property <bool> detail-open;     // compact: the detail covers the list
    callback confirm(kind: string, target: string);
    property <bool> show-detail: Backend.has-current-app && (root.two-pane || root.detail-open);
    property <bool> show-list: root.two-pane || !root.show-detail;
    property <bool> show-installed: true;   // the list's filters: user-installed apps, system apps
    property <bool> show-system: true;

    HorizontalLayout {
        if root.show-list : Rectangle {
            width: root.two-pane ? 360px : root.width;
            if Backend.apps.length == 0 : VerticalLayout {
                alignment: center;
                padding: MaterialStyleMetrics.padding_24;
                MaterialText { text: Backend.load-error != "" ? "Could not list the apps" : "No apps installed"; style: MaterialTypography.title_medium;
                               color: MaterialPalette.on_surface; horizontal-alignment: center; }
                MaterialText { text: Backend.load-error != "" ? Backend.load-error : "Install an .apk file with the button below."; style: MaterialTypography.body_medium; color: MaterialPalette.on_surface_variant;
                               horizontal-alignment: center; wrap: word-wrap; }
            }
            ScrollView {
                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_8;
                    padding-bottom: 96px;  // room for the FAB
                    alignment: start;
                    HorizontalLayout {
                        padding: MaterialStyleMetrics.padding_8;
                        spacing: MaterialStyleMetrics.spacing_8;
                        alignment: start;
                        FilterChip { text: "Installed"; checked <=> root.show-installed; }
                        FilterChip { text: "System"; checked <=> root.show-system; }
                    }
                    for app in Backend.apps : VerticalLayout {
                        if app.system ? root.show-system : root.show-installed : Row {
                            text: app.label;
                            supporting-text: app.package + (app.version == "" ? "" : " · " + app.version);
                            picture: app.icon;
                            selected: root.two-pane && Backend.has-current-app && app.package == Backend.current-app.package;
                            clicked => { Backend.select-app(app.package); root.detail-open = true; }
                            if app.system : Tag { text: "System"; }
                            if app.running : Tag { text: "Running"; strong: true; }
                        }
                    }
                    AddonsSection { confirm(k, t) => { root.confirm(k, t); } }
                }
            }
        }
        if root.two-pane : VerticalDivider { }
        if root.show-detail : AppDetail {
            app: Backend.current-app;
            show-back: !root.two-pane;
            back => { root.detail-open = false; }
            confirm(k, t) => { root.confirm(k, t); }
        }
        if root.two-pane && !root.show-detail : VerticalLayout {
            alignment: center;
            MaterialText { text: "Select an app"; style: MaterialTypography.title_medium; color: MaterialPalette.on_surface_variant; horizontal-alignment: center; }
        }
    }
}
