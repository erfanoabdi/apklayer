option('prebuilts', type: 'string', value: '',
  description: 'a joined checkout of the prebuilts branch (common/, <cpu>/: docs/INSTALL.md); empty: $APKLAYER_PREBUILTS. Without it only the native parts build')
option('android_libs', type: 'string', value: '',
  description: 'Android\'s libraries the runtime uses; empty: <prebuilts>/<cpu>/android-libs/lib64')
option('android_runtime', type: 'boolean', value: true,
  description: 'install the Android half too (framework jar with the JNI shim and instrumented, Robolectric, android-root): a complete runtime; the deb sets false (the runtime bundle brings it)')
option('gfxstream', type: 'string', value: '',
  description: 'gfxstream\'s source (the tree\'s hardware/google/gfxstream) for libapklayer-gles1.so, OpenGL ES 1 on hosts without it; empty: not built')
option('package_version', type: 'string', value: '',
  description: 'what `apklayer --version` prints (the release builds pass the package version); empty: the project version')
option('bionic_translation', type: 'string', value: '', deprecated: true,
  description: 'unused: bionic_translation is a subproject (subprojects/bionic_translation.wrap)')
option('audio_backend', type: 'combo', choices: ['auto', 'pipewire', 'pulse'], value: 'auto',
  description: 'the audio backends to build (bridge/hals/audio: libapklayer-audio-<backend>.so, picked per instance by `apklayer providers`); auto: every one whose library is found')
