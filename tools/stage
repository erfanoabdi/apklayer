#!/bin/sh
# tools/stage: files from the LineageOS tree's build (~/los24 in the OrbStack machine ubuntu22-x86) to where apklayer runs. Read-only on the tree.
#   tools/stage libs <dest> <lib.so>...  libraries and everything they need (DT_NEEDED, recursively), skipping what dest has; prints the copied names.
#                                        ANDROID_LIBS_SRC: source dirs separated by ":" (first match wins; default the arm64 system/lib64). Runs where the tree is.
#   tools/stage root                     the files Android processes read at fixed paths into the VM's native dir's android-root (its ~/.config/apklayer/env, else ~/arm64-native; on the Mac).
#                                        ANDROID_PRODUCT (default generic_arm64) picks the product; STAGE_DEST=<dir> writes a local directory instead.
#   tools/stage media [--dry-run]        software codecs and extractors from the media APEX outputs into the VM's Android library dir (tools/lib/stage-media.py)
#   tools/stage sysapps                  the tree's providers and system apps installed as apklayer apps on the VM
#   tools/stage vulkan [stage dir]       the Orb Vulkan loader build onto the VM (the loader keeps its SONAME; the mapping selects the renamed copy)
#   tools/stage x86_64                   everything an x86_64 machine needs, one tar file: build/x86_64/apklayer-x86_64-stage.tar (docs/X86_64.md)
#   tools/stage arm32                    the arm32 Android libraries of the 32-bit app process into build/arm32/android-libs (gsi_arm64's system/lib,
#                                        apklayer's modules' 32-bit outputs; then tools/armhf/build.sh: docs/ARM32.md)
# The VM is the one in tests/vm/local.conf.
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
repo="$(dirname "$here")"
tree=/home/erfanabdi/los24
ORB="${APKLAYER_ORB-orb -m ubuntu22-x86}"  # "env" when this runs inside the OrbStack machine
vm_config() { . "$repo/tests/vm/config.sh"; }
vm() { vm_auth ssh -o StrictHostKeyChecking=no "$VM" "$VM_PATHS $*"; }
# the VM's own runtime paths, as its CLI reads them (~/.config/apklayer/env, else the default layout): $N native dir, $L Android libraries
VM_PATHS='[ -f ~/.config/apklayer/env ] && . ~/.config/apklayer/env; N=${APKLAYER_NATIVE:-$HOME/arm64-native}; L=${APKLAYER_ANDROID_LIBS:-$HOME/android-arm64/lib64};'

stage_libs() {
    src="${ANDROID_LIBS_SRC:-$tree/out/target/product/generic_arm64/system/lib64}"
    dest="$1"; shift
    mkdir -p "$dest"
    queue="$*"
    while [ -n "$queue" ]; do
        set -- $queue; lib="$1"; shift; queue="$*"
        case "$lib" in libc.so|libm.so|libdl.so|libdl_android.so) continue;; esac  # bionic_translation provides these
        [ -e "$dest/$lib" ] && continue
        found=""
        oldifs="$IFS"; IFS=:
        for d in $src; do [ -e "$d/$lib" ] && { found="$d/$lib"; break; }; done
        IFS="$oldifs"
        [ -n "$found" ] || { echo "missing in $src: $lib" >&2; continue; }
        cp "$found" "$dest/$lib"; echo "$lib"
        queue="$queue $(readelf -d "$found" | sed -n 's/.*NEEDED.*\[\(.*\)\]/\1/p' | tr '\n' ' ')"
    done
}

stage_root() {
    OUT="$tree/out/target/product/${ANDROID_PRODUCT:-generic_arm64}"
    if [ -n "${STAGE_DEST:-}" ]; then
        sink() { mkdir -p "$STAGE_DEST/$1" && tar xf - -C "$STAGE_DEST/$1"; }
    else
        vm_config
        sink() { vm "mkdir -p \$N/android-root/$1 && tar xf - -C \$N/android-root/$1"; }
    fi
    # system/etc/security/cacerts: the CA store native TLS reads (Dart's dart:io "Failed to find root cert cache" without it)
    $ORB tar cf - -C "$OUT" system/etc/cgroups.json system/etc/task_profiles.json system/etc/task_profiles system/usr/hyphen-data system/etc/permissions system/etc/compatconfig system/etc/sysconfig system/etc/default-permissions system/etc/vintf/manifest.xml \
        system/fonts system/etc/fonts.xml system/etc/font_fallback.xml system/etc/security/cacerts system/framework/org.lineageos.platform-res.apk apex/com.android.i18n/etc apex/com.android.tzdata/etc | sink .
    # the optional shared libraries apps declare (<uses-library>, HostSharedLibraries) as JVM classes at the path their etc/permissions/<name>.xml names:
    # the javac output of each library module (architecture independent; the device's jar there is DEX)
    jars="$tree/out/soong/.intermediates/external/apache-http/org.apache.http.legacy.impl/android_common/repackaged-jarjar/javac/org.apache.http.legacy.jar"
    for m in base mock runner; do jars="$jars $tree/out/soong/.intermediates/frameworks/base/test-$m/android.test.$m.impl/android_common/repackaged-jarjar/javac/android.test.$m.jar"; done
    $ORB tar cf - --transform='s,^.*/,system/framework/,' -P $jars | sink .
    # the build properties the stack's property store loads (stack.cpp: android-root/props/system_build.prop)
    $ORB tar cf - -C "$OUT/system" --transform='s,^build.prop$,system_build.prop,' build.prop | sink props
    # Original audio policy tables are source XML assets, not generated libraries.
    $ORB tar cf - -C "$tree/frameworks/av/services/audiopolicy/config" --transform='s,^,vendor/etc/,' audio_policy_volumes.xml default_volume_tables.xml | sink .
    # apklayer's own half of the device configuration (features the host layers provide, the codec list, the vendor manifest).
    COPYFILE_DISABLE=1 tar cf - --exclude .DS_Store -C "$repo/bridge/native/android-root" vendor/etc | sink .
    # Protection levels of the framework's permissions (normal ones are granted at install, signature ones to platform-signed system apps).
    tsv="$(mktemp -d)"
    $ORB cat "$tree/frameworks/base/core/res/AndroidManifest.xml" | python3 "$here/gen/permission-levels.py" > "$tsv/apklayer-permission-levels.tsv"
    tar cf - -C "$tsv" apklayer-permission-levels.tsv | sink system/etc
    rm -rf "$tsv"
}

stage_sysapps() {
    vm_config
    OUT="$tree/out/target/product/generic_arm64"
    # tools/sysapps.list: package and APK (a glob: MediaProvider's Mainline module is a flattened APEX directory); system apps, so --system
    grep -v '^#' "$here/sysapps.list" | while IFS="$(printf '\t')" read -r pkg apk; do
        [ "$apk" != - ] || continue
        name="$(basename "$apk" .apk)"
        orb -m ubuntu22-x86 sh -c "cat \$(ls $OUT/$apk | head -1)" < /dev/null | vm "cat > ~/sys-$name.apk"
        vm "cd ~/apklayer; export XDG_RUNTIME_DIR=/run/user/1000; b/cli/apklayer install --system ~/sys-$name.apk 2>&1 | grep -a 'installed\|rror\|xception' | head -3" < /dev/null
    done
}

stage_vulkan() {
    vm_config
    stage="${1:-$HOME/OrbStack/ubuntu22-x86/home/erfanabdi/apklayer-vulkan-stage}"
    for name in libvulkan.so vulkan.apklayer.so libapklayer_vktest.so; do
        target="$name"; [ "$name" != libvulkan.so ] || target=libapklayer_vulkan.so
        vm "cat > \$L/$target" < "$stage/$name"
        actual=$(vm "sha256sum \$L/$target" | cut -d' ' -f1)
        [ "$actual" = "$(shasum -a 256 "$stage/$name" | cut -d' ' -f1)" ] || { echo "hash mismatch: $target" >&2; exit 1; }
        echo "Verified $target $actual"
    done
    COPYFILE_DISABLE=1 tar cf - -C "$repo" bridge/native/apklayer.prop bridge/native/bionic_translation.cfg | vm 'tar xf - -C ~/apklayer'
    vm 'cd ~/apklayer && ninja -C b reconfigure >/dev/null && meson install -C b --skip-subprojects --only-changed --quiet'  # the mapping sees the loader
}

stage_x86_64() { # re-runs itself inside the OrbStack machine; every staged ELF is checked to be x86-64
    if [ "${1:-}" != --inside ]; then exec orb -m ubuntu22-x86 sh "/mnt/mac$here/stage" x86_64 --inside; fi
    stage="$HOME/apklayer-x86_64" out="$tree/out/target/product/generic_x86_64"
    mkdir -p "$stage"
    echo "== libraries"
    # first the module outputs of apklayer's modules and the patched tree libraries (the lock's "apklayer"/"patched" names): `m <output file>` builds
    # them there without installing into system/lib64, whose copies may be older
    names="$(awk '($5 == "apklayer" || $5 == "patched") && $3 ~ /[.]so$/ { n = $3; sub(".*/", "", n); sub("[.]so$", "", n); printf "-name %s -o ", n }' "$repo/deps/android-tree-files.lock")"
    srcs=""
    for d in $(find "$tree/out/soong/.intermediates" -type d \( $names -false \) -prune 2>/dev/null); do
        for v in android_x86_64_shared android_vendor_x86_64_shared; do [ -d "$d/$v" ] && srcs="$srcs$d/$v:"; done
    done
    srcs="$srcs$out/system/lib64"
    for d in "$out"/apex/*/lib64 "$out"/apex/*/lib64/extractors "$out/system_ext/lib64" "$out/system/system_ext/lib64" "$out/vendor/lib64"; do [ -d "$d" ] && srcs="$srcs:$d"; done
    rm -rf "$stage/android-x86_64"; mkdir -p "$stage/android-x86_64/lib64"
    # roots: the list and every library of the arm64 lock (the providers' HAL libraries are loaded by name, not needed), so both sets stay level
    roots="$(cat "$repo/deps/android-libs.list"; awk '$3 ~ /lib64\/[^\/]*[.]so$/ { n = $3; sub(".*/", "", n); print n }' "$repo/deps/android-tree-files.lock" | grep -v ubsan_standalone)"
    ANDROID_LIBS_SRC="$srcs" stage_libs "$stage/android-x86_64/lib64" $(echo "$roots" | grep -v libapklayer_vulkan | sed 's/aarch64/x86_64/' | sort -u) > "$stage/libs-copied.txt" 2> "$stage/libs-missing.txt"
    # the patched Android Vulkan loader also under its own name (the mapping selects it for Vulkan apps, as on arm64: tools/stage vulkan)
    cp "$stage/android-x86_64/lib64/libvulkan.so" "$stage/android-x86_64/lib64/libapklayer_vulkan.so" && echo libapklayer_vulkan.so >> "$stage/libs-copied.txt"
    echo "$(wc -l < "$stage/libs-copied.txt") libraries copied; missing (see $stage/libs-missing.txt): $(sed 's/.*: //' "$stage/libs-missing.txt" | sort -u | wc -l)"
    echo "== Android root"
    rm -rf "$stage/android-root"
    ORB=env ANDROID_PRODUCT=generic_x86_64 STAGE_DEST="$stage/android-root" stage_root
    if ls "$out"/system/lib64/libberberis_arm64.so >/dev/null 2>&1; then  # the native bridge for arm64-only apps, when built (docs/X86_64.md "arm64-only apps")
        echo "== native bridge (Digitalis)"
        cp "$out"/system/lib64/libberberis_*.so "$stage/android-x86_64/lib64/"
        mkdir -p "$stage/android-root/system/lib64" "$stage/android-root/system/bin" "$stage/android-root/system/etc"
        cp -r "$out/system/lib64/arm64" "$stage/android-root/system/lib64/" && cp -r "$out/system/bin/arm64" "$stage/android-root/system/bin/"
        cp "$out/system/etc/ld.config.arm64.txt" "$stage/android-root/system/etc/"
        cp "$tree/frameworks/libs/binary_translation/prebuilt/cpuinfo.arm64" "$stage/android-root/system/etc/cpuinfo.arm64.txt"  # the guest's /proc/cpuinfo
    fi
    echo "== Robolectric"
    mkdir -p "$stage/aosp" && cp "$tree/out/host/linux-x86/framework/Robolectric_all.jar" "$stage/aosp/"
    echo "== framework javac shards (runtime/meson.build lists the @CriticalNative methods from them)"
    rm -rf "$stage/javac-shards"; mkdir -p "$stage/javac-shards"
    cp "$tree"/out/soong/.intermediates/frameworks/base/framework-minus-apex/android_common/javac/framework.jar[0-9]* "$stage/javac-shards/" 2>/dev/null || true
    rm -f "$stage"/javac-shards/*.rsp "$stage"/javac-shards/*.pc_state
    echo "== check: every ELF is x86-64"
    bad=0
    for f in "$stage"/android-x86_64/lib64/*.so*; do
        [ -f "$f" ] || continue
        case "$(readelf -h "$f" 2>/dev/null | sed -n 's/.*Machine: *//p')" in *X86-64*) ;; *) echo "not x86-64: $f"; bad=$((bad + 1));; esac
    done
    echo "$bad foreign ELF files"
    echo "== tar"
    mkdir -p "$repo/build/x86_64"
    tar cf "$repo/build/x86_64/apklayer-x86_64-stage.tar" -C "$stage" android-x86_64 android-root aosp javac-shards libs-copied.txt libs-missing.txt
    ls -la "$repo/build/x86_64/apklayer-x86_64-stage.tar"
}

stage_arm32() { # re-runs itself inside the OrbStack machine; every staged ELF is checked to be 32-bit ARM
    if [ "${1:-}" != --inside ]; then exec orb -m ubuntu22-x86 sh "/mnt/mac$here/stage" arm32 --inside; fi
    out="$tree/out/target/product/generic_arm64" dest="$repo/build/arm32/android-libs"
    # apklayer's modules and the patched tree libraries from their 32-bit module outputs (`m <output file>`), then the product's system/lib
    names="$(awk '($5 == "apklayer" || $5 == "patched") && $3 ~ /[.]so$/ { n = $3; sub(".*/", "", n); sub("[.]so$", "", n); printf "-name %s -o ", n }' "$repo/deps/android-tree-files.lock")"
    srcs=""
    for d in $(find "$tree/out/soong/.intermediates" -type d \( $names -false \) -prune 2>/dev/null); do
        for v in android_arm_armv8-a_shared android_vendor_arm_armv8-a_shared; do [ -d "$d/$v" ] && srcs="$srcs$d/$v:"; done
    done
    srcs="$srcs$out/system/lib"
    for d in "$out"/apex/*/lib "$out"/apex/*/lib/extractors "$out/system_ext/lib" "$out/system/system_ext/lib" "$out/vendor/lib"; do [ -d "$d" ] && srcs="$srcs:$d"; done
    rm -rf "$dest"; mkdir -p "$dest"
    # roots: what an app process loads (the list); the stack's own services stay 64-bit
    ANDROID_LIBS_SRC="$srcs" stage_libs "$dest" $(grep -v ubsan_standalone "$repo/deps/android-libs.list" | sed 's/aarch64/arm/') > "$dest/../libs-copied.txt" 2> "$dest/../libs-missing.txt"
    cp "$dest/libvulkan.so" "$dest/libapklayer_vulkan.so"  # the patched loader under its own name, as on arm64 (tools/stage vulkan)
    echo "$(wc -l < "$dest/../libs-copied.txt") libraries copied; missing ($dest/../libs-missing.txt): $(sed 's/.*: //' "$dest/../libs-missing.txt" | sort -u | wc -l)"
    bad=0
    for f in "$dest"/*.so*; do
        case "$(readelf -h "$f" 2>/dev/null | sed -n 's/.*Machine: *//p')" in ARM) ;; *) echo "not arm32: $f"; bad=$((bad + 1));; esac
    done
    echo "$bad foreign ELF files"
}

[ $# -ge 1 ] || { sed -n '2,14p' "$0" >&2; exit 2; }
step="$1"; shift
case "$step" in
    libs) stage_libs "$@";;
    root) stage_root;;
    media) exec python3 "$here/lib/stage-media.py" "$@";;
    sysapps) stage_sysapps;;
    vulkan) stage_vulkan "$@";;
    x86_64) stage_x86_64 "$@";;
    arm32) stage_arm32 "$@";;
    *) echo "tools/stage: unknown target $step" >&2; exit 2;;
esac
