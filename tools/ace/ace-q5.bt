// Agent Q: the ACE net thread's packets (Thread-NN comm, sendto/recvfrom of 40..330 bytes) as hex: `<ms> S|R <tid> <len> <hex>`; connects with port. Needs BPFTRACE_MAX_STRLEN >= 330 on bpftrace 0.20 (STRLEN=340 for pgr-timeline.sh).
#include <linux/socket.h>
#include <linux/in.h>
tracepoint:syscalls:sys_enter_openat / comm == "ng.grayraven.en" && !@g[pid] / { @g[pid] = 1; @t0 = nsecs; }
tracepoint:syscalls:sys_enter_connect / @g[pid] && strncmp(comm, "Thread-", 7) == 0 /
{ $sa = (struct sockaddr_in *)args->uservaddr; $p = (($sa->sin_port & 0xff) << 8) | ($sa->sin_port >> 8);
  if ($p == 443 || $p == 10012) { printf("%lu C %d %d %s\n", (nsecs - @t0) / 1000000, tid, $p, ntop($sa->sin_addr.s_addr)); } }
tracepoint:syscalls:sys_enter_sendto / @g[pid] && strncmp(comm, "Thread-", 7) == 0 && args->len >= 40 && args->len <= 330 /
{ printf("%lu S %d %d %r\n", (nsecs - @t0) / 1000000, tid, args->len, buf(args->buff, args->len)); }
tracepoint:syscalls:sys_enter_recvfrom / @g[pid] && strncmp(comm, "Thread-", 7) == 0 / { @rb[tid] = args->ubuf; }
tracepoint:syscalls:sys_exit_recvfrom / @g[pid] && @rb[tid] /
{ if (args->ret >= 40 && args->ret <= 330) { printf("%lu R %d %d %r\n", (nsecs - @t0) / 1000000, tid, args->ret, buf(@rb[tid], args->ret)); } delete(@rb[tid]); }
END { clear(@g); clear(@t0); clear(@rb); }
BEGIN { printf("READY\n"); }
