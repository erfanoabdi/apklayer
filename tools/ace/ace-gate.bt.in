// ACE call-gate trace, native arm64 (pair: berberis BERBERIS_TRACE_GATE, patch 0071; same record meaning). Run as root:
//   sed -e "s|@LIB@|<path of libanogs.so>|" -e "s|@MINPID@|<pid below the game's>|" ace-gate.bt.in > gate.bt; bpftrace gate.bt > gate.txt
// "E <ns> <pid> <tid> <comm> <x30> <x1 callee> <x2 arg> <x3> <x0> <mem64 as %r>" at +0x1f5200 (gate entry), "R <ns> <tid> <x0 result>" at +0x1f5238.
// Only game processes (comm ng.grayraven.en) with pid > MINPID, so another instance's game is not traced.
uprobe:@LIB@:0x1f5200 / comm == "ng.grayraven.en" && pid > @MINPID@ /
{
  printf("E %lu %d %d %s %lx %lx %lx %lx %lx %r\n", nsecs, pid, tid, comm, reg("lr"), arg1, arg2, arg3, arg0, buf(arg2, 64));
}
uprobe:@LIB@:0x1f5238 / comm == "ng.grayraven.en" && pid > @MINPID@ /
{
  printf("R %lu %d %lx\n", nsecs, tid, arg0);
}
BEGIN { printf("READY\n"); }
