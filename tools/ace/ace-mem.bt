// Which memory the game process touches (PGR/ACE, team lead B): memory syscalls with addresses, user page faults (kernel view, per 16 MB
// region and per tid) and the fault signals, all relative to the first libanogs.so open (t0). Run by pgr-timeline.sh EXTRA_BT=ace-mem.bt
// (@FAULT@ is substituted; @BRIDGE@ unused). Nothing is traced before libanogs is opened, so the output is the ACE window only.
// (page faults per tid and 16 MB region are printed as @pf at the end.) Page faults only see first touches of non-resident pages: a read of a resident page leaves no trace (use BERBERIS_LOG_FAULTS for the
// guest's own view of its real faults).

tracepoint:syscalls:sys_enter_openat / !@g[pid] && strcontains(str(args->filename), "libanogs") / { @g[pid] = 1; @t0 = nsecs; printf("0 T0 %d\n", pid); }

tracepoint:syscalls:sys_enter_mmap / @g[pid] / { @ma[tid] = args->addr; @ml[tid] = args->len; @mp[tid] = args->prot; @mf[tid] = args->flags; @md[tid] = args->fd; @mo[tid] = args->off; }
tracepoint:syscalls:sys_exit_mmap / @g[pid] && @ml[tid] / { printf("%lu mmap tid %d addr 0x%lx len 0x%lx prot %x fl %x fd %d off 0x%lx ret 0x%lx\n", (nsecs - @t0) / 1000000, tid, @ma[tid], @ml[tid], @mp[tid], @mf[tid], @md[tid], @mo[tid], args->ret); delete(@ml[tid]); }
tracepoint:syscalls:sys_enter_munmap / @g[pid] / { printf("%lu munmap tid %d addr 0x%lx len 0x%lx\n", (nsecs - @t0) / 1000000, tid, args->addr, args->len); }
tracepoint:syscalls:sys_enter_mprotect / @g[pid] / { printf("%lu mprotect tid %d addr 0x%lx len 0x%lx prot %x\n", (nsecs - @t0) / 1000000, tid, args->start, args->len, args->prot); }
tracepoint:syscalls:sys_enter_mremap / @g[pid] / { printf("%lu mremap tid %d old 0x%lx oldlen 0x%lx newlen 0x%lx fl %x new 0x%lx\n", (nsecs - @t0) / 1000000, tid, args->addr, args->old_len, args->new_len, args->flags, args->new_addr); }
tracepoint:syscalls:sys_enter_madvise / @g[pid] / { printf("%lu madvise tid %d addr 0x%lx len 0x%lx adv %d\n", (nsecs - @t0) / 1000000, tid, args->start, args->len_in, args->behavior); }
tracepoint:syscalls:sys_enter_mincore / @g[pid] / { printf("%lu mincore tid %d addr 0x%lx len 0x%lx\n", (nsecs - @t0) / 1000000, tid, args->start, args->len); }
tracepoint:syscalls:sys_enter_msync / @g[pid] / { printf("%lu msync tid %d addr 0x%lx len 0x%lx\n", (nsecs - @t0) / 1000000, tid, args->start, args->len); }
tracepoint:syscalls:sys_enter_process_vm_readv / @g[pid] / { printf("%lu process_vm_readv tid %d target %d remote 0x%lx len 0x%lx n %d\n", (nsecs - @t0) / 1000000, tid, args->pid, *(uint64 *)args->rvec, *(uint64 *)(args->rvec + 8), args->riovcnt); }
tracepoint:syscalls:sys_enter_process_vm_writev / @g[pid] / { printf("%lu process_vm_writev tid %d target %d\n", (nsecs - @t0) / 1000000, tid, args->pid); }
tracepoint:syscalls:sys_enter_ptrace / @g[pid] / { printf("%lu ptrace tid %d req %ld pid %ld\n", (nsecs - @t0) / 1000000, tid, args->request, args->pid); }
tracepoint:syscalls:sys_enter_pread64 / @g[pid] / { @pread[tid, args->fd] = count(); }
tracepoint:syscalls:sys_enter_readlinkat / @g[pid] && strncmp(str(args->pathname), "/proc/self/map_files", 20) == 0 / { @maplinks[tid] = count(); }
tracepoint:syscalls:sys_enter_openat / @g[pid] && (strncmp(str(args->filename), "/proc/self/m", 12) == 0 || strncmp(str(args->filename), "/proc/self/pagemap", 18) == 0 || strncmp(str(args->filename), "/proc/self/task", 15) == 0 || strncmp(str(args->filename), "/proc/self/smaps", 16) == 0) /
{ printf("%lu open tid %d %s\n", (nsecs - @t0) / 1000000, tid, str(args->filename)); }

// kprobe, not tracepoint:exceptions:page_fault_user: arm64 has none. arg1 = faulting address (handle_mm_fault(vma, address, flags, regs)).
kprobe:handle_mm_fault / @g[pid] / { @pf[tid, arg1 >> 24] = count(); }

@FAULT@
/ @g[pid] /
{ printf("%lu FAULT tid %d sig %d code %d addr 0x%lx\n", (nsecs - @t0) / 1000000, tid, arg0, arg1, arg2); }

tracepoint:sched:sched_process_exit / @g[pid] && pid == tid / { printf("%lu EXIT\n", (nsecs - @t0) / 1000000); }

BEGIN { printf("READY\n"); }
END { clear(@g); }
