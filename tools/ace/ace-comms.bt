// What ACE sees of its own threads: /proc/<pid>/task/*/comm opens (who, when), /proc/.apklayer-hidden redirects, and snapshots of the thread name tally at 10/20/28 s.
// Output dir: @OUT@ (sed it before running).
tracepoint:syscalls:sys_enter_openat / comm == "ng.grayraven.en" && !@g[pid] && @pid == 0 / { @g[pid] = 1; @pid = pid; @t0 = nsecs; }
tracepoint:syscalls:sys_enter_openat / @g[pid] && strncmp(str(args->filename), "/proc/", 6) == 0 && !(strncmp(str(args->filename), "/proc/self/maps", 15) == 0) /
{ @np[tid, str(args->filename)] = count(); if (@pn < 150) { @pn++; printf("%lu OPENP %d %s\n", (nsecs - @t0) / 1000000, tid, str(args->filename)); } }
interval:s:10 { if (@pid) { system("for f in /proc/%d/task/*/comm; do cat $f; done | sort | uniq -c | sort -rn > @OUT@/comms-10-%d.txt; ls /proc/%d/task | wc -l >> @OUT@/comms-10-%d.txt", @pid, @pid, @pid, @pid); } }
interval:s:20 { if (@pid) { system("for f in /proc/%d/task/*/comm; do cat $f; done | sort | uniq -c | sort -rn > @OUT@/comms-20-%d.txt; ls /proc/%d/task | wc -l >> @OUT@/comms-20-%d.txt", @pid, @pid, @pid, @pid); } }
interval:s:28 { if (@pid) { system("for f in /proc/%d/task/*/comm; do cat $f; done | sort | uniq -c | sort -rn > @OUT@/comms-28-%d.txt; ls /proc/%d/task | wc -l >> @OUT@/comms-28-%d.txt", @pid, @pid, @pid, @pid); } }
interval:s:30 { exit(); }
BEGIN { printf("READY\n"); }
END { clear(@g); clear(@pid); clear(@t0); clear(@pn); }
