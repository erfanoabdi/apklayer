// process_vm_readv of the game process on itself: remote iov base/len per call (first 600), maps snapshot of the host at 20 s.
tracepoint:syscalls:sys_enter_openat / comm == "ng.grayraven.en" && !@g[pid] && @pid == 0 / { @g[pid] = 1; @pid = pid; @t0 = nsecs; }
tracepoint:syscalls:sys_enter_process_vm_readv / @g[pid] && @n < 600 /
{ @n++; printf("%lu VMR %d pid %d liov %lx riov %lx\n", (nsecs - @t0) / 1000000, tid, args->pid, *(uint64 *)args->lvec, *(uint64 *)args->rvec); printf("  len %lu\n", *(uint64 *)((uint64)args->rvec + 8)); }
interval:s:20 { if (@pid) { system("cat /proc/%d/maps > @OUT@/hostmaps-%d.txt", @pid, @pid); } }
interval:s:36 { exit(); }
BEGIN { printf("READY\n"); }
