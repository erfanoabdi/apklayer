// Path-level filesystem diff of the game process (all threads), native arm64 vs translated x86_64, from the HOST kernel's raw_syscalls (same script both sides).
// Per (syscall, path): the first 10 calls print "P ns tid nr path" and, at the syscall's exit, "X ns tid ret"; @c[nr,path] counts every call (printed at exit).
// Generated per arch by tools/ace/mk-fsdiff.sh from this template (syscall id lists). Stat modes/sizes and directory listings: tests/apps/hello-filedump (the guest's own view).
config = { max_map_keys = 65536 }
BEGIN { printf("READY\n"); }

tracepoint:syscalls:sys_enter_openat / comm == "ng.grayraven.en" && !@g[pid] / { @g[pid] = 1; }

tracepoint:raw_syscalls:sys_enter / @g[pid] && (@IDS1@) /
{ $k = str(args->args[1]); @c[args->id, $k]++; if (@c[args->id, $k] <= 10) { @pr[tid] = 1; printf("P %lu %d %d %s\n", nsecs, tid, args->id, $k); } }
tracepoint:raw_syscalls:sys_enter / @g[pid] && (@IDS0@) /
{ $k = str(args->args[0]); @c[args->id, $k]++; if (@c[args->id, $k] <= 10) { @pr[tid] = 1; printf("P %lu %d %d %s\n", nsecs, tid, args->id, $k); } }
tracepoint:raw_syscalls:sys_exit / @pr[tid] /
{ printf("X %lu %d %d\n", nsecs, tid, args->ret); delete(@pr[tid]); }
END { clear(@g); clear(@pr); }
