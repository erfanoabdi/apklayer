// Path-level filesystem diff of the game process (all threads), native arm64 vs translated x86_64 (same script, the HOST kernel's own tracepoints).
// Per (syscall, path): the first 10 calls print "P ns tid name path" and, at the syscall's exit, "X ns tid ret"; @c[name,path] counts every call (printed at exit).
// mk-fsdiff.sh appends one sys_enter_<name> probe per path syscall of this arch. Stat modes/sizes and directory listings: tests/apps/hello-filedump (the guest's view).
config = { max_map_keys = 65536 }
BEGIN { printf("READY\n"); }

tracepoint:syscalls:sys_enter_openat / comm == "ng.grayraven.en" && !@g[pid] / { @g[pid] = 1; }
tracepoint:raw_syscalls:sys_exit / @pr[tid] /
{ printf("X %lu %d %d\n", nsecs, tid, args->ret); delete(@pr[tid]); }
END { clear(@g); clear(@pr); }
