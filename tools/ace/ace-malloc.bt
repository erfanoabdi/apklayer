uretprobe:/lib/x86_64-linux-gnu/libc.so.6:malloc / @sz[tid] / { if (@n < 400000) { @n++; printf("%lu M %d %lu %lx\n", (nsecs - @t0) / 1000000, tid, @sz[tid], retval); } delete(@sz[tid]); }
uprobe:/lib/x86_64-linux-gnu/libc.so.6:calloc / @g[pid] && arg0 * arg1 >= 4072 && arg0 * arg1 <= 4104 / { @sz[tid] = arg0 * arg1; }
