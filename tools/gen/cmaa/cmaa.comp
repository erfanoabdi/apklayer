precision highp float;
precision highp int;
precision highp image2D;
precision highp uimage2D;
precision highp sampler2D;
layout(std430, binding = 0) buffer Ctl { uint ctl[]; };      // 3: the candidate count for the dispatch, 4: shape candidates counter, 8: blend locations counter, 12: blend items counter
layout(std430, binding = 1) buffer Cand { uint cand[]; };    // shape candidates: (x << 18) | y
layout(std430, binding = 2) buffer Loc { uint loc[]; };      // quads with blend items: (x << 16) | y
layout(std430, binding = 3) buffer Items { uvec2 items[]; }; // linked list of blend items: (next with header, packed colour)
layout(std430, binding = 4) buffer Ind { uint ind[]; };      // the indirect dispatch arguments
layout(r32ui, binding = 0) uniform highp uimage2D edgesImg;
layout(std430, binding = 5) buffer Heads { uint heads[]; };    // per 2x2 quad: the head of its blend item list, 0xFFFFFFFF: none
layout(rgba8, binding = 2) writeonly uniform highp image2D outImg;
uniform highp sampler2D srcTex;
uniform ivec2 sz;
uint headAt(ivec2 q) { return uint(q.y * ((sz.x + 1) / 2) + q.x); }
#if CM_EXTRA_SHARPNESS
#define LC_AMOUNT 0.15
#define SHAPE_BLUR 0.07
#define DAMPEN 0.11
#else
#define LC_AMOUNT 0.10
#define SHAPE_BLUR 0.10
#define DAMPEN 0.15
#endif
uniform float u_th;     // apklayer patch: the edge threshold (reference 0.07), per level and ratio
#define CM_EDGE_THRESHOLD u_th
uniform float u_tg;     // apklayer patch: the text gate: no edges where the text test on the 3x3 of a quad is above this (< 0: off)
uniform float u_ck;     // apklayer patch: colour edges: the largest channel step times this joins the luma step (0: luma only, as the reference)
#define MAX_LINE 86.0
#define SYM_OFFSET 0.22
#define SLM_ITEMS 768

vec3 loadSrc(ivec2 p) { return texelFetch(srcTex, clamp(p, ivec2(0), sz - ivec2(1)), 0).rgb; }
uint loadEdge(ivec2 p) {
  if (p.x < 0 || p.y < 0 || p.x >= sz.x || p.y >= sz.y) return 0u;
  return imageLoad(edgesImg, p).x;
}
vec4 unpackEdges(uint v) { return vec4(float((v & 1u) != 0u), float((v & 2u) != 0u), float((v & 4u) != 0u), float((v & 8u) != 0u)); }
uint packEdges(vec4 e) { return uint(dot(e, vec4(1.0, 2.0, 4.0, 8.0))); }

#ifdef K_EDGES
layout(local_size_x = 16, local_size_y = 16) in;
shared vec4 shH[256];
shared vec4 shV[256];
vec2 NB[16];  // neighbourhood[x][y] = NB[x * 4 + y]
float lumaOf(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }  // the input is gamma encoded already (the reference takes the sqrt of linear colour)
vec3 csrc[8];
float dstep(int a, int b) {
  float d = abs(lumaOf(csrc[a]) - lumaOf(csrc[b]));
  vec3 t = abs(csrc[a] - csrc[b]);
  d = max(d, u_ck * max(t.r, max(t.g, t.b)));
  return d;
}
float TL(vec3 c) { return c.b * 0.5 + (c.r * 0.5 + c.g); }
// the text test on the 3x3 csrc[0..7] + c8: 1 where it is strong two-colour structure with a mostly axis-aligned gradient (a glyph stem, an icon or UI line)
float textMask(vec3 c8) {
  vec3 q[9]; for (int k = 0; k < 8; k++) q[k] = csrc[k]; q[8] = c8;
  float lo = 9.0, hi = -9.0; vec3 cLo = q[0], cHi = q[0];
  for (int k = 0; k < 9; k++) { float l = TL(q[k]); if (l < lo) { lo = l; cLo = q[k]; } if (l > hi) { hi = l; cHi = q[k]; } }
  float ctr = 0.5 * (hi - lo);
  vec3 ax = cHi - cLo; float axx = max(dot(ax, ax), 1e-6), res = 0.0;
  for (int k = 0; k < 9; k++) res = max(res, length(q[k] - cLo - ax * clamp(dot(q[k] - cLo, ax) / axx, 0.0, 1.0)));
  float L0 = TL(q[0]), L1 = TL(q[1]), L2 = TL(q[2]), L3 = TL(q[3]), L5 = TL(q[5]), L6 = TL(q[6]), L7 = TL(q[7]), L8 = TL(q[8]);
  float gx = (L2 + 2.0 * L5 + L8) - (L0 + 2.0 * L3 + L6), gy = (L6 + 2.0 * L7 + L8) - (L0 + 2.0 * L1 + L2);
  float axis = abs(abs(gx) - abs(gy)) / (abs(gx) + abs(gy) + 1e-4);
  return smoothstep(0.28, 0.5, ctr) * (1.0 - smoothstep(0.04, 0.10, res)) * smoothstep(0.3, 0.65, axis);
}
vec2 edgeL(int x, int y, float l[8]) { return vec2(dstep(x + y * 3, x + 1 + y * 3), dstep(x + y * 3, x + (y + 1) * 3)); }
float lcV(int x, int y) { return max(max(NB[(x + 1) * 4 + y].y, NB[(x + 1) * 4 + y + 1].y), max(NB[(x + 2) * 4 + y].y, NB[(x + 2) * 4 + y + 1].y)) * LC_AMOUNT; }
float lcH(int x, int y) { return max(max(NB[x * 4 + y + 1].x, NB[(x + 1) * 4 + y + 1].x), max(NB[x * 4 + y + 2].x, NB[(x + 1) * 4 + y + 2].x)) * LC_AMOUNT; }
void loadQ(int addr, out vec2 e00, out vec2 e10, out vec2 e01, out vec2 e11) {
  vec4 h = shH[addr], v = shV[addr];
  e00 = vec2(v.x, h.x); e10 = vec2(v.y, h.y); e01 = vec2(v.z, h.z); e11 = vec2(v.w, h.w);
}
void main() {
  ivec2 gt = ivec2(gl_LocalInvocationID.xy), gid = ivec2(gl_WorkGroupID.xy);
  ivec2 pixelPos = (gid * ivec2(14, 14) + gt - ivec2(1, 1)) * 2;
  int center = gt.x + gt.y * 16;
  bool inOut = gt.x != 15 && gt.x != 0 && gt.y != 15 && gt.y != 0;
  float l[8];
  for (int i = 0; i < 8; i++) { csrc[i] = loadSrc(pixelPos + ivec2(i % 3, i / 3)); l[i] = 0.0; }
  vec2 qe0 = edgeL(0, 0, l), qe1 = edgeL(1, 0, l), qe2 = edgeL(0, 1, l), qe3 = edgeL(1, 1, l);
  if (u_tg >= 0.0 && textMask(loadSrc(pixelPos + ivec2(2, 2))) > u_tg) { qe0 = qe1 = qe2 = qe3 = vec2(0.0); }
  shV[center] = vec4(qe0.x, qe1.x, qe2.x, qe3.x);
  shH[center] = vec4(qe0.y, qe1.y, qe2.y, qe3.y);
  memoryBarrierShared();
  barrier();
  uint outEdges[4] = uint[4](0u, 0u, 0u, 0u);
  if (inOut) {
    vec2 topRow = shH[center - 16].zw, leftColumn = shV[center - 1].yw;
    vec4 sum = vec4(qe0, qe1) + vec4(qe2, qe3) + vec4(topRow, leftColumn);
    if (sum.x != 0.0 || sum.y != 0.0 || sum.z != 0.0 || sum.w != 0.0) {
      heads[headAt(pixelPos / 2)] = 0xFFFFFFFFu;
      vec4 ce[4];
      vec2 d0, d1, d2;
      loadQ(center - 16 - 1, d0, d1, d2, NB[0]);
      loadQ(center - 16, d0, d1, NB[4], NB[8]);
      loadQ(center - 16 + 1, d0, d1, NB[12], d2);
      loadQ(center - 1, d0, NB[1], d1, NB[2]);
      loadQ(center + 1, NB[13], d0, NB[14], d1);
      loadQ(center - 1 + 16, d0, NB[3], d1, d2);
      loadQ(center + 16, NB[7], NB[11], d0, d1);
      NB[4].y = topRow[0]; NB[8].y = topRow[1]; NB[1].x = leftColumn[0]; NB[2].x = leftColumn[1];
      NB[5] = qe0; NB[9] = qe1; NB[6] = qe2; NB[10] = qe3;
      topRow[0] = float((topRow[0] - lcH(0, -1)) > CM_EDGE_THRESHOLD);
      topRow[1] = float((topRow[1] - lcH(1, -1)) > CM_EDGE_THRESHOLD);
      leftColumn[0] = float((leftColumn[0] - lcV(-1, 0)) > CM_EDGE_THRESHOLD);
      leftColumn[1] = float((leftColumn[1] - lcV(-1, 1)) > CM_EDGE_THRESHOLD);
      ce[0].x = float((qe0.x - lcV(0, 0)) > CM_EDGE_THRESHOLD); ce[0].y = float((qe0.y - lcH(0, 0)) > CM_EDGE_THRESHOLD);
      ce[1].x = float((qe1.x - lcV(1, 0)) > CM_EDGE_THRESHOLD); ce[1].y = float((qe1.y - lcH(1, 0)) > CM_EDGE_THRESHOLD);
      ce[2].x = float((qe2.x - lcV(0, 1)) > CM_EDGE_THRESHOLD); ce[2].y = float((qe2.y - lcH(0, 1)) > CM_EDGE_THRESHOLD);
      ce[3].x = float((qe3.x - lcV(1, 1)) > CM_EDGE_THRESHOLD); ce[3].y = float((qe3.y - lcH(1, 1)) > CM_EDGE_THRESHOLD);
      ce[0].z = leftColumn[0]; ce[1].z = ce[0].x; ce[2].z = leftColumn[1]; ce[3].z = ce[2].x;
      ce[0].w = topRow[0]; ce[1].w = topRow[1]; ce[2].w = ce[0].y; ce[3].w = ce[1].y;
      for (int i = 0; i < 4; i++) {
        ivec2 lp = pixelPos + ivec2(i & 1, i >> 1);
        vec4 e = ce[i];
        if ((e.x * e.y + e.y * e.z + e.z * e.w + e.w * e.x) != 0.0) {
          uint idx = atomicAdd(ctl[4], 1u);
          if (idx < uint(cand.length())) cand[idx] = (uint(lp.x) << 18) | uint(lp.y);
        }
        outEdges[i] = packEdges(e);
      }
    }
  }
  if (inOut) {
    for (int i = 0; i < 4; i++) {
      ivec2 lp = pixelPos + ivec2(i & 1, i >> 1);
      if (lp.x >= 0 && lp.y >= 0 && lp.x < sz.x && lp.y < sz.y) imageStore(edgesImg, lp, uvec4(outEdges[i]));
    }
  }
}
#endif

#ifdef K_ARGS
layout(local_size_x = 1) in;
void main() {
  if (gl_WorkGroupID.x == 1u) {
    uint n = min(ctl[4], uint(cand.length()));
    ind[0] = (n + 127u) / 128u; ind[1] = 1u; ind[2] = 1u;
    ctl[3] = n;
  } else if (gl_WorkGroupID.y == 1u) {
    uint n = min(ctl[8], uint(loc.length()));
    ind[0] = 1u; ind[1] = (n + 31u) / 32u; ind[2] = 1u;
    ctl[3] = n;
    ctl[4] = 0u; ctl[8] = 0u; ctl[12] = 0u;
  }
}
#endif

#ifdef K_CAND
layout(local_size_x = 128) in;
shared uint blendItemCount;
shared uvec2 blendItems[SLM_ITEMS];

void storeColor(ivec2 p, vec3 color, bool complexShape) {
  if (p.x < 0 || p.y < 0 || p.x >= sz.x || p.y >= sz.y) return;
  uint ci = atomicAdd(ctl[12], 1u);
  if (ci >= uint(items.length())) return;
  ivec2 quad = p / 2;
  uint offsetXY = uint((p.y % 2) * 2 + (p.x % 2));
  uint header = (offsetXY << 30) | (complexShape ? (1u << 26) : 0u);
  uint orig = atomicExchange(heads[headAt(quad)], ci | header);
  items[ci] = uvec2(orig, packUnorm4x8(vec4(color, 1.0)));
  if (orig == 0xFFFFFFFFu) {
    uint e = atomicAdd(ctl[8], 1u);
    if (e < uint(loc.length())) loc[e] = (uint(quad.x) << 16) | uint(quad.y);
  }
}

vec4 simpleShape(vec4 edges, vec4 edgesLeft, vec4 edgesRight, vec4 edgesTop, vec4 edgesBottom) {
  float fromRight = edges.r, fromBelow = edges.g, fromLeft = edges.b, fromAbove = edges.a;
  float blurCoeff = SHAPE_BLUR;
  float numberOfEdges = dot(edges, vec4(1.0));
  float numberOfEdgesAllAround = dot(edgesLeft.bga + edgesRight.rga + edgesTop.rba + edgesBottom.rgb, vec3(1.0));
  if (numberOfEdges == 2.0) {
    blurCoeff *= 0.75;
    float k = 0.9;
    fromRight += k * (edges.g * edgesTop.r * (1.0 - edgesLeft.g) + edges.a * edgesBottom.r * (1.0 - edgesLeft.a));
    fromBelow += k * (edges.b * edgesRight.g * (1.0 - edgesTop.b) + edges.r * edgesLeft.g * (1.0 - edgesTop.r));
    fromLeft += k * (edges.a * edgesBottom.b * (1.0 - edgesRight.a) + edges.g * edgesTop.b * (1.0 - edgesRight.g));
    fromAbove += k * (edges.r * edgesLeft.a * (1.0 - edgesBottom.r) + edges.b * edgesRight.a * (1.0 - edgesBottom.b));
  }
#if CM_EXTRA_SHARPNESS
  blurCoeff *= clamp(1.15 - numberOfEdgesAllAround / 8.0, 0.0, 1.0);
#else
  blurCoeff *= clamp(1.30 - numberOfEdgesAllAround / 10.0, 0.0, 1.0);
#endif
  return vec4(fromLeft, fromAbove, fromRight, fromBelow) * blurCoeff;
}

void detectZs(vec4 edges, vec4 eM1, vec4 eP1, vec4 eP2, out float invertedZScore, out float normalZScore) {
  invertedZScore = edges.r * edges.g * eP1.a;
  invertedZScore *= 2.0 + (eM1.g + eP2.a) - (edges.a + eP1.g) - 0.7 * (eP2.g + eM1.a + edges.b + eP1.r);
  normalZScore = edges.r * edges.a * eP1.g;
  normalZScore *= 2.0 + (eM1.a + eP2.g) - (edges.g + eP1.a) - 0.7 * (eP2.a + eM1.g + edges.b + eP1.r);
}

void findZLineLengths(out float lenL, out float lenR, ivec2 sp, bool horizontal, bool inverted, vec2 stepRight) {
  uint maskL, maskR;
  if (horizontal) { maskL = 0x08u; maskR = 0x02u; } else { maskL = 0x04u; maskR = 0x01u; }
  if (inverted) { uint t = maskL; maskL = maskR; maskR = t; }
  bool contL = true, contR = true;
  lenL = 1.0; lenR = 1.0;
  for (int it = 0; it < 256; it++) {
    uint eL = loadEdge(ivec2(vec2(sp) - stepRight * lenL));
    uint eR = loadEdge(ivec2(vec2(sp) + stepRight * (lenR + 1.0)));
    contL = contL && ((eL & maskL) == maskL);
    contR = contR && ((eR & maskR) == maskR);
    lenL += contL ? 1.0 : 0.0;
    lenR += contR ? 1.0 : 0.0;
    float maxLR = max(lenR, lenL);
    if (!contL && !contR) maxLR = MAX_LINE;
#if CM_EXTRA_SHARPNESS
    if (maxLR >= min(MAX_LINE, 1.20 * min(lenR, lenL) - 0.20)) break;
#else
    if (maxLR >= min(MAX_LINE, 1.25 * min(lenR, lenL) - 0.25)) break;
#endif
  }
}

bool collectZs(ivec2 sp, bool horizontal, bool inverted, float quality, float lenL, float lenR) {
  float leftOdd = SYM_OFFSET * mod(lenL, 2.0), rightOdd = SYM_OFFSET * mod(lenR, 2.0);
  float dampen = clamp((lenL + lenR - quality) * DAMPEN, 0.0, 1.0);
  float loopFrom = -floor((lenL + 1.0) / 2.0) + 1.0, loopTo = floor((lenR + 1.0) / 2.0);
  uint cnt = uint(loopTo - loopFrom + 1.0);
  uint idx = atomicAdd(blendItemCount, cnt);
  if (idx + cnt > uint(SLM_ITEMS)) return false;
  float totalLength = (loopTo - loopFrom) + 1.0 - leftOdd - rightOdd;
  float lerpStep = 1.0 / totalLength, lerpFromK = (0.5 - leftOdd - loopFrom) * lerpStep;
  uint header = (uint(sp.x) << 18) | uint(sp.y);
  uint stat = ((horizontal ? 1u : 0u) << 31) | ((inverted ? 1u : 0u) << 30);
  for (float i = loopFrom; i <= loopTo; i += 1.0) {
    float second = i > 0.0 ? 1.0 : 0.0, srcOffset = 1.0 - second * 2.0;
    float lerpK = (lerpStep * i + lerpFromK) * srcOffset + second;
    lerpK *= dampen;
    blendItems[idx++] = uvec2(header, stat | (uint(i + 256.0) << 20) | (uint(srcOffset + 256.0) << 10) | uint(clamp(lerpK, 0.0, 1.0) * 1023.0 + 0.5));
  }
  return true;
}

void blendZs(ivec2 sp, bool horizontal, bool inverted, float quality, float lenL, float lenR, vec2 stepRight) {
  vec2 blendDir = horizontal ? vec2(0.0, -1.0) : vec2(-1.0, 0.0);
  if (inverted) blendDir = -blendDir;
  float leftOdd = SYM_OFFSET * mod(lenL, 2.0), rightOdd = SYM_OFFSET * mod(lenR, 2.0);
  float dampen = clamp((lenL + lenR - quality) * DAMPEN, 0.0, 1.0);
  float loopFrom = -floor((lenL + 1.0) / 2.0) + 1.0, loopTo = floor((lenR + 1.0) / 2.0);
  float totalLength = (loopTo - loopFrom) + 1.0 - leftOdd - rightOdd;
  float lerpStep = 1.0 / totalLength, lerpFromK = (0.5 - leftOdd - loopFrom) * lerpStep;
  for (float i = loopFrom; i <= loopTo; i += 1.0) {
    float second = i > 0.0 ? 1.0 : 0.0, srcOffset = 1.0 - second * 2.0;
    float lerpK = (lerpStep * i + lerpFromK) * srcOffset + second;
    lerpK *= dampen;
    ivec2 pp = ivec2(vec2(sp) + stepRight * i);
    vec3 cc = loadSrc(pp), cf = loadSrc(ivec2(vec2(pp) + blendDir * srcOffset));
    storeColor(pp, mix(cc, cf, lerpK), true);
  }
}

void main() {
  if (gl_LocalInvocationID.x == 0u) blendItemCount = 0u;
  memoryBarrierShared();
  barrier();
  uint numCandidates = ctl[3];
  if (gl_GlobalInvocationID.x < numCandidates) {
    uint pixelID = cand[gl_GlobalInvocationID.x];
    ivec2 pp = ivec2(int(pixelID >> 18), int(pixelID & 0x3FFFu));
    vec4 edges = unpackEdges(loadEdge(pp));
    vec4 eL = unpackEdges(loadEdge(pp + ivec2(-1, 0))), eR = unpackEdges(loadEdge(pp + ivec2(1, 0)));
    vec4 eB = unpackEdges(loadEdge(pp + ivec2(0, 1))), eT = unpackEdges(loadEdge(pp + ivec2(0, -1)));
    {
      vec4 bv = simpleShape(edges, eL, eR, eT, eB);
      vec3 outColor = loadSrc(pp) * (1.0 - dot(bv, vec4(1.0)));
      if (bv.x > 0.0) outColor += bv.x * loadSrc(pp + ivec2(-1, 0));
      if (bv.y > 0.0) outColor += bv.y * loadSrc(pp + ivec2(0, -1));
      if (bv.z > 0.0) outColor += bv.z * loadSrc(pp + ivec2(1, 0));
      if (bv.w > 0.0) outColor += bv.w * loadSrc(pp + ivec2(0, 1));
      storeColor(pp, outColor, false);
    }
    {
      float invS, norS, maxScore;
      bool horizontal = true, invertedZ = false;
      {
        vec4 eP2 = unpackEdges(loadEdge(pp + ivec2(2, 0)));
        detectZs(edges, eL, eR, eP2, invS, norS);
        maxScore = max(invS, norS);
        if (maxScore > 0.0) invertedZ = invS > norS;
      }
      {
        vec4 eP2 = unpackEdges(loadEdge(pp + ivec2(0, -2)));
        detectZs(edges.argb, eB.argb, eT.argb, eP2.argb, invS, norS);
        float vertScore = max(invS, norS);
        if (vertScore > maxScore) { maxScore = vertScore; horizontal = false; invertedZ = invS > norS; }
      }
      if (maxScore > 0.0) {
#if CM_EXTRA_SHARPNESS
        float quality = floor(clamp(4.0 - maxScore, 0.0, 3.0) + 0.5);
#else
        float quality = floor(clamp(4.0 - maxScore, 0.0, 3.0));
#endif
        vec2 stepRight = horizontal ? vec2(1.0, 0.0) : vec2(0.0, -1.0);
        float lenL, lenR;
        findZLineLengths(lenL, lenR, pp, horizontal, invertedZ, stepRight);
        lenL -= quality; lenR -= quality;
        if (lenL + lenR >= 5.0 && !collectZs(pp, horizontal, invertedZ, quality, lenL, lenR)) blendZs(pp, horizontal, invertedZ, quality, lenL, lenR, stepRight);
      }
    }
  }
  memoryBarrierShared();
  barrier();
  uint total = min(uint(SLM_ITEMS), blendItemCount);
  uint loops = (total + 127u - gl_LocalInvocationID.x) / 128u;
  for (uint lp = 0u; lp < loops; lp++) {
    uvec2 v = blendItems[lp * 128u + gl_LocalInvocationID.x];
    ivec2 start = ivec2(int(v.x >> 18), int(v.x & 0x3FFFu));
    bool horizontal = ((v.y >> 31) & 1u) != 0u, inverted = ((v.y >> 30) & 1u) != 0u;
    float stepIndex = float((v.y >> 20) & 0x3FFu) - 256.0, srcOffset = float((v.y >> 10) & 0x3FFu) - 256.0, lerpK = float(v.y & 0x3FFu) / 1023.0;
    vec2 stepRight = horizontal ? vec2(1.0, 0.0) : vec2(0.0, -1.0), blendDir = horizontal ? vec2(0.0, -1.0) : vec2(-1.0, 0.0);
    if (inverted) blendDir = -blendDir;
    ivec2 pp = ivec2(vec2(start) + stepRight * stepIndex);
    vec3 cc = loadSrc(pp), cf = loadSrc(ivec2(vec2(pp) + blendDir * srcOffset));
    storeColor(pp, mix(cc, cf, lerpK), true);
  }
}
#endif

#ifdef K_APPLY
layout(local_size_x = 4, local_size_y = 32) in;
void main() {
  uint num = ctl[3], cnd = gl_GlobalInvocationID.y, qoff = gl_LocalInvocationID.x;
  if (cnd >= num) return;
  uint pid = loc[cnd];
  ivec2 quad = ivec2(int(pid >> 16), int(pid & 0xFFFFu));
  ivec2 pp = quad * 2 + ivec2(int(qoff & 1u), int(qoff >> 1));
  uint cih = heads[headAt(quad)];
  vec4 acc = vec4(0.0);
  for (uint i = 0u; cih != 0xFFFFFFFFu && i < 32u; i++) {
    uint offXY = (cih >> 30) & 3u;
    bool complexShape = ((cih >> 26) & 1u) != 0u;
    uint at = cih & ((1u << 26) - 1u);
    if (at >= uint(items.length())) break;
    uvec2 val = items[at];
    cih = val.x;
    if (offXY == qoff) {
      float w = 0.8 + (complexShape ? 1.0 : 0.0);
      acc += vec4(unpackUnorm4x8(val.y).rgb * w, w);
    }
  }
  if (acc.a == 0.0) return;
  if (pp.x < sz.x && pp.y < sz.y) imageStore(outImg, pp, vec4(acc.rgb / acc.a, 1.0));
}
#endif
