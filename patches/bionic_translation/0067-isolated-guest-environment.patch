+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <pthread.h>
+
+/* apklayer: copied from AOSP bionic/libc/bionic/env.cpp; own environment, host pthread locking. */
+static char **guest_environ;
+struct ScopedEnvLock {
+  pthread_rwlock_t *lock;
+  ScopedEnvLock(pthread_rwlock_t *value, bool write) : lock(value) {
+    if (write) pthread_rwlock_wrlock(lock); else pthread_rwlock_rdlock(lock);
+  }
+  ~ScopedEnvLock() { pthread_rwlock_unlock(lock); }
+};
+
+static pthread_rwlock_t g_environ_lock = PTHREAD_RWLOCK_INITIALIZER;
+
+// Returns a pointer to the value associated with name,
+// or nullptr if not found.
+// Starts searching guest_environ from *offset,
+// and sets *offset to the index at which the variable was found.
+static char* __findenv(const char* name, size_t name_length, size_t* offset) {
+  if (guest_environ != nullptr) {
+    for (char** p = guest_environ + *offset; *p != nullptr; ++p) {
+      if (!strncmp(name, *p, name_length) && (*p)[name_length] == '=') {
+        *offset = p - guest_environ;
+        return *p + name_length + 1;
+      }
+    }
+  }
+  return nullptr;
+}
+
+char* guest_getenv(const char* name) {
+  size_t name_length;
+  if (name == nullptr ||
+      (name_length = strchrnul(name, '=') - name) == 0 ||
+      name[name_length] == '=') {
+    errno = EINVAL;
+    return nullptr;
+  }
+
+  ScopedEnvLock locker(&g_environ_lock, false);
+  size_t offset = 0;
+  return __findenv(name, name_length, &offset);
+}
+
+static bool __add_new_environ_slot(size_t* offset) {
+  size_t old_size = 0;
+  if (guest_environ != nullptr) {
+    char** p = guest_environ;
+    for (; *p != nullptr; ++p) ++old_size;
+  }
+
+  // Keep track of the most recent guest_environ allocation we did.
+  // We can't just pass guest_environ to reallocarray() because that might
+  // have been replaced with non-heap-allocated memory. Supporting that
+  // is probably a mistake, but it's our (and everyone else's) historical
+  // behavior.
+  static char** old_env = nullptr;
+
+  char** new_env = static_cast<char**>(reallocarray(old_env, old_size + 2, sizeof(char*)));
+  if (!new_env) return false;
+  if (old_env != guest_environ && guest_environ != nullptr) {
+    memcpy(new_env, guest_environ, old_size * sizeof(char*));
+  }
+  guest_environ = old_env = new_env;
+  guest_environ[old_size] = guest_environ[old_size + 1] = nullptr;
+  *offset = old_size;
+  return true;
+}
+
+template <typename F>
+static int __update_environ(const char* name, size_t name_length, bool overwrite, F string_maker) {
+  size_t offset = 0;
+  if (__findenv(name, name_length, &offset) != nullptr) {
+    if (!overwrite) return 0;
+  } else {
+    if (!__add_new_environ_slot(&offset)) return -1;
+  }
+
+  char* str = string_maker();
+  if (!str) return -1;  // Preserve an existing value if its replacement allocation fails.
+  guest_environ[offset] = str;
+  return 0;
+}
+
+int guest_putenv(char* str) {
+  // Unlike the other functions where the input MUST NOT contain '=',
+  // here the input MUST contain '='.
+  size_t name_length;
+  if (str == nullptr ||
+      (name_length = strchrnul(str, '=') - str) == 0 ||
+      str[name_length] != '=') {
+    errno = EINVAL;
+    return -1;
+  }
+
+  ScopedEnvLock locker(&g_environ_lock, true);
+  return __update_environ(str, name_length, true, [str]() { return str; });
+}
+
+int guest_setenv(const char* name, const char* value, int overwrite) {
+  size_t name_length;
+  if (name == nullptr ||
+      (name_length = strchrnul(name, '=') - name) == 0 ||
+      name[name_length] == '=') {
+    errno = EINVAL;
+    return -1;
+  }
+
+  ScopedEnvLock locker(&g_environ_lock, true);
+  auto string_maker = [name, name_length, value]() {
+    // Turn "name" and "value" into "name=value" for insertion into guest_environ.
+    size_t value_length = strlen(value);
+    char* str = static_cast<char*>(malloc(name_length + 1 + value_length + 1));
+    if (str != nullptr) {
+      mempcpy(mempcpy(mempcpy(str, name, name_length), "=", 1), value, value_length + 1);
+    }
+    return str;
+  };
+  return __update_environ(name, name_length, overwrite, string_maker);
+}
+
+int guest_unsetenv(const char* name) {
+  size_t name_length;
+  if (name == nullptr ||
+      (name_length = strchrnul(name, '=') - name) == 0 ||
+      name[name_length] == '=') {
+    errno = EINVAL;
+    return -1;
+  }
+
+  // While guest_setenv()/guest_putenv() will always ensure there's at most one assignment to any given name,
+  // callers could replace guest_environ with a malformed array.
+  // guest_getenv() wouldn't care because it will always stop at the first match,
+  // but guest_unsetenv() needs to make sure that _all_ assignments are removed.
+  // POSIX says "If more than one string in an environment of a process has the same name,
+  // the consequences are undefined" so this isn't _required_ to be a loop,
+  // but it matches what other implementations do.
+  ScopedEnvLock locker(&g_environ_lock, true);
+  size_t offset = 0;
+  while (__findenv(name, name_length, &offset)) {
+    for (char** p = &guest_environ[offset];; ++p) {
+      if (!(*p = *(p + 1))) {
+        break;
+      }
+    }
+  }
+  return 0;
+}
+
+int guest_clearenv() {
+  ScopedEnvLock locker(&g_environ_lock, true);
+  char** old_environ = guest_environ;
+  guest_environ = nullptr;
+  if (old_environ != nullptr) {
+    for (; *old_environ; ++old_environ) {
+      *old_environ = nullptr;
+    }
+  }
+  return 0;
+}
+
+/* apklayer: the host loader/JVM environment is never the app's storage. */
+extern "C" const char *apklayer_own_data_env(void) __attribute__((weak));
+extern "C" char **apklayer_guest_exec_environment(void) __attribute__((weak));
+struct libc_bio_environment_backend {
+  char *(*get)(const char *);
+  int (*set)(const char *, const char *, int);
+  int (*unset)(const char *);
+  int (*put)(char *);
+  int (*clear)(void);
+  char ***slot;
+};
+static libc_bio_environment_backend backend_storage;
+static const libc_bio_environment_backend *backend;
+static pthread_mutex_t init_lock = PTHREAD_MUTEX_INITIALIZER;
+static bool prepared;
+static const char *initial_environment;
+static size_t initial_environment_size;
+
+static bool app_environment() {
+  const char *view = getenv("APKLAYER_PROC_VIEW");
+  return (!view || strcmp(view, "host")) &&
+      (apklayer_own_data_env ? apklayer_own_data_env() != nullptr : getenv("APKLAYER_OWN_DATA") != nullptr);
+}
+
+/* system/core/rootdir/init.environ.rc.in and bionic/libc/include/paths.h. */
+static const char *const android_defaults[] = {
+  "ANDROID_BOOTLOGO=1", "ANDROID_ROOT=/system", "ANDROID_ASSETS=/system/app",
+  "ANDROID_DATA=/data", "ANDROID_STORAGE=/storage", "ANDROID_ART_ROOT=/apex/com.android.art",
+  "ANDROID_I18N_ROOT=/apex/com.android.i18n", "ANDROID_TZDATA_ROOT=/apex/com.android.tzdata",
+  "EXTERNAL_STORAGE=/sdcard", "ASEC_MOUNTPOINT=/mnt/asec",
+  "PATH=/product/bin:/apex/com.android.runtime/bin:/apex/com.android.art/bin:/apex/com.android.virt/bin:/system_ext/bin:/system/bin:/system/xbin:/odm/bin:/vendor/bin:/vendor/xbin",
+  nullptr
+};
+
+/* Called only before app execution; the complete replacement is allocated before publishing it. */
+static int initialize(char *const envp[], bool explicit_child) {
+  const char *const *source = explicit_child ? const_cast<const char *const *>(envp) : android_defaults;
+  size_t count = 0;
+  while (source && source[count]) ++count;
+  char **copy = static_cast<char **>(calloc(count + 1, sizeof(char *)));
+  if (!copy) return -1;
+  size_t bytes = 0;
+  for (size_t i = 0; i < count; ++i) {
+    size_t length = strlen(source[i]) + 1;
+    if (length > SIZE_MAX - bytes) errno = ENOMEM;
+    else copy[i] = strdup(source[i]);
+    if (!copy[i]) {
+      int saved = errno;
+      while (i) free(copy[--i]);
+      free(copy); errno = saved; return -1;
+    }
+    bytes += length;
+  }
+  char *snapshot = static_cast<char *>(malloc(bytes ? bytes : 1));
+  if (!snapshot) {
+    int saved = errno;
+    for (size_t i = 0; i < count; ++i) free(copy[i]);
+    free(copy); errno = saved; return -1;
+  }
+  snapshot[0] = 0;  // a non-null pointer distinguishes an empty guest environment from no guest view
+  char *out = snapshot;
+  for (size_t i = 0; i < count; ++i) {
+    size_t length = strlen(copy[i]) + 1;
+    memcpy(out, copy[i], length); out += length;
+  }
+  ScopedEnvLock locker(&g_environ_lock, true);
+  guest_environ = copy;
+  // Published snapshots remain valid for readers, including across a pre-exec reseed.
+  initial_environment = snapshot;
+  initial_environment_size = bytes;
+  prepared = true;
+  return 0;
+}
+static int prepare() {
+  pthread_mutex_lock(&init_lock);
+  char **child = apklayer_guest_exec_environment ? apklayer_guest_exec_environment() : nullptr;
+  int result = prepared ? 0 : initialize(child, child != nullptr);
+  pthread_mutex_unlock(&init_lock);
+  return result;
+}
+/* /proc/self/environ describes the initial seed, not the live libc environment after app mutations. */
+extern "C" const char *libc_bio_initial_environment(size_t *size) {
+  if (!size) { errno = EINVAL; return nullptr; }
+  *size = 0;
+  if (!app_environment() || prepare() != 0) return nullptr;
+  pthread_mutex_lock(&init_lock);
+  const char *snapshot = initial_environment;
+  *size = initial_environment_size;
+  pthread_mutex_unlock(&init_lock);
+  return snapshot;
+}
+extern "C" int libc_bio_init_guest_environment(char *const envp[], int explicit_child) {
+  pthread_mutex_lock(&init_lock);
+  int result;
+  if (__atomic_load_n(&backend, __ATOMIC_ACQUIRE)) { errno = EBUSY; result = -1; }
+  else result = initialize(envp, explicit_child != 0);
+  pthread_mutex_unlock(&init_lock);
+  return result;
+}
+extern "C" int libc_bio_set_environment_backend(const libc_bio_environment_backend *value) {
+  if (!value || !value->get || !value->set || !value->unset || !value->put || !value->clear || !value->slot) {
+    errno = EINVAL; return -1;
+  }
+  pthread_mutex_lock(&init_lock);
+  int result = 0;
+  if (backend) { errno = EBUSY; result = -1; }
+  else { backend_storage = *value; __atomic_store_n(&backend, &backend_storage, __ATOMIC_RELEASE); }
+  pthread_mutex_unlock(&init_lock);
+  return result;
+}
+extern "C" char ***bionic_environment_slot() {
+  if (!app_environment()) return &environ;
+  const auto *ops = __atomic_load_n(&backend, __ATOMIC_ACQUIRE);
+  return ops ? ops->slot : prepare() == 0 ? &guest_environ : nullptr;
+}
+extern "C" const char *libc_bio_host_getenv(const char *name) { return getenv(name); }
+extern "C" char *bionic_getenv(const char *name) {
+  if (!app_environment()) return getenv(name);
+  const auto *ops = __atomic_load_n(&backend, __ATOMIC_ACQUIRE);
+  return ops ? ops->get(name) : prepare() == 0 ? guest_getenv(name) : nullptr;
+}
+extern "C" int bionic_setenv(const char *name, const char *value, int overwrite) {
+  if (!app_environment()) return setenv(name, value, overwrite);
+  const auto *ops = __atomic_load_n(&backend, __ATOMIC_ACQUIRE);
+  return ops ? ops->set(name, value, overwrite) : prepare() == 0 ? guest_setenv(name, value, overwrite) : -1;
+}
+extern "C" int bionic_unsetenv(const char *name) {
+  if (!app_environment()) return unsetenv(name);
+  const auto *ops = __atomic_load_n(&backend, __ATOMIC_ACQUIRE);
+  return ops ? ops->unset(name) : prepare() == 0 ? guest_unsetenv(name) : -1;
+}
+extern "C" int bionic_putenv(char *value) {
+  if (!app_environment()) return putenv(value);
+  const auto *ops = __atomic_load_n(&backend, __ATOMIC_ACQUIRE);
+  return ops ? ops->put(value) : prepare() == 0 ? guest_putenv(value) : -1;
+}
+extern "C" int bionic_clearenv() {
+  if (!app_environment()) return clearenv();
+  const auto *ops = __atomic_load_n(&backend, __ATOMIC_ACQUIRE);
+  return ops ? ops->clear() : prepare() == 0 ? guest_clearenv() : -1;
+}
