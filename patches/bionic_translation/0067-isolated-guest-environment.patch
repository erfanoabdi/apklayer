+/* apklayer: environ is DATA: resolve the authoritative slot, not a mirrored pointer value. */
+void *apkenv_environment_symbol(const char *name)
+{
+    char ***(*slot)(void) = dlsym(RTLD_DEFAULT, "bionic_environment_slot");
+    return slot ? slot() : dlsym(RTLD_DEFAULT, name);
+}
