From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erfan Abdi <erfangplus@gmail.com>
Date: Tue, 3 Nov 2026 00:00:00 +0000
Subject: [PATCH 20/25] apklayer: sigmask-fault-signals

pthread_sigmask / sigprocmask: a bionic thread cannot block SIGSEGV, SIGBUS, SIGILL or SIGFPE (the JVM answers those; blocked, the kernel kills the whole process on a null access in a Gecko thread that blocks every signal, with no JVM report). bionic's sigset_t is the kernel's 64-bit mask.

apklayer patch: step 15 of the former scripts/patch-bionic-translation.sh (see docs/PATCHES.md), patch 0020 of patches/bionic_translation.
---
 libc/libc.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/libc/libc.c b/libc/libc.c
index cd32ce1..88832fc 100644
--- a/libc/libc.c
+++ b/libc/libc.c
@@ -71,6 +71,23 @@ pid_t gettid(void)
 	return syscall(SYS_gettid);
 }
 
+#define APK_SYNC_SIGNALS ((1UL << (SIGSEGV - 1)) | (1UL << (SIGBUS - 1)) | (1UL << (SIGILL - 1)) | (1UL << (SIGFPE - 1)))
+static int apk_sigmask(int thread, int how, const unsigned long *set, unsigned long *oset) /* apklayer patch: see scripts/patch-bionic-translation.sh step 15 */
+{
+	sigset_t in, out;
+	unsigned long bits;
+	sigemptyset(&in);
+	if (set) {
+		bits = *set & ~APK_SYNC_SIGNALS;
+		memcpy(&in, &bits, sizeof bits);
+	}
+	int r = thread ? pthread_sigmask(how, set ? &in : NULL, oset ? &out : NULL) : sigprocmask(how, set ? &in : NULL, oset ? &out : NULL);
+	if (oset) memcpy(oset, &out, sizeof *oset);
+	return r;
+}
+int bionic_pthread_sigmask(int how, const unsigned long *set, unsigned long *oset) { return apk_sigmask(1, how, set, oset); }
+int bionic_sigprocmask(int how, const unsigned long *set, unsigned long *oset) { return apk_sigmask(0, how, set, oset); }
+
 int bionic_kill(pid_t pid, int sig) /* apklayer patch: see scripts/patch-bionic-translation.sh step 14 */
 {
 	if (pid != getpid() && getenv("APKLAYER_COMPONENT_HOST")) {
