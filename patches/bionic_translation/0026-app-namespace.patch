-soinfo *apkenv_find_library(const char *name, const bool try_glibc, int glibc_flag, void **glibc_handle)
+/* apklayer patch: is the absolute name in one of the app's library directories? */
+static bool apkenv_in_app_dir(const char *name)
 {
+	if (name[0] != '/')
+		return false;
+	char *tmp = strdup(name), *dir = realpath(dirname(tmp), NULL);
+	bool in = false;
+	for (const char **path = apkenv_app_ldpaths; dir && *path && !in; path++) {
+		char *real = realpath(*path, NULL);
+		in = real && !strcmp(real, dir);
+		free(real);
+	}
+	free(dir);
+	free(tmp);
+	return in;
+}
+
+/* apklayer patch: a library asked for from the app's namespace (app) is the app's own copy when it has one, else the system's;
+ * the system namespace never sees the app's libraries (an app's OpenSSL libcrypto.so next to the device's BoringSSL one) */
+soinfo *apkenv_find_library(const char *name, bool app, const bool try_glibc, int glibc_flag, void **glibc_handle)
+{
 	soinfo *si;
 	const char *bname;
 
