+
+/* apklayer patch: the directories of the app's namespace */
+void dl_parse_app_library_path(const char *path, char *delim)
+{
+	apkenv_parse_paths(path, delim, apkenv_app_ldpaths_buf, apkenv_app_ldpaths);
