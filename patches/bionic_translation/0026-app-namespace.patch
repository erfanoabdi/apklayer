From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erfan Abdi <erfangplus@gmail.com>
Date: Tue, 3 Nov 2026 00:00:00 +0000
Subject: [PATCH 26/26] apklayer: app-namespace

apklayer patch 0026 of patches/bionic_translation (docs/PATCHES.md): two linker namespaces, as Android's classloader
namespace. Libraries found in the app's directories (dl_parse_app_library_path) form the app namespace; their DT_NEEDED and
dlopen look in the app namespace first, then in the system one. The system namespace (dl_parse_library_path) never sees the
app's libraries, so an app library named like a device one (OpenSSL libcrypto.so next to BoringSSL's) is a second library.
---
diff --git a/linker/dlfcn.c b/linker/dlfcn.c
--- a/linker/dlfcn.c
+++ b/linker/dlfcn.c
@@ -66,13 +66,15 @@
 	dl_err_str = (const char *)&dl_err_buf[0];
 }
 
-void *bionic_dlopen(const char *filename, int flag)
+/* apklayer patch: the caller's namespace (an app library's is the app's) is where filename is looked up */
+static void *dlopen_from(const char *filename, int flag, const void *caller)
 {
 //	verbose("%s (%d)", filename, flag);
 	soinfo *ret;
 	pthread_mutex_lock(&apkenv_dl_lock);
 	void *glibc_handle = NULL;
-	ret = apkenv_find_library(filename, true, flag, &glibc_handle); // flag only used for glibc dlopen
+	soinfo *from = apkenv_find_containing_library(caller);
+	ret = apkenv_find_library(filename, from && from->app_ns, true, flag, &glibc_handle); // flag only used for glibc dlopen
 
 	if (ret) {
 		apkenv_call_constructors_recursive(ret);
@@ -86,6 +88,11 @@
 	return ret;
 }
 
+void *bionic_dlopen(const char *filename, int flag)
+{
+	return dlopen_from(filename, flag, __builtin_return_address(0));
+}
+
 struct android_dlextinfo {
 	uint64_t flags;
 	void*   reserved_addr;
@@ -101,7 +108,7 @@
 	if (info) {
 		fprintf(stderr, "ERROR: android_dlopen_ext with android_dlextinfo not implemented\n");
 	}
-	return bionic_dlopen(filename, flags);
+	return dlopen_from(filename, flags, __builtin_return_address(0));
 }
 
 const char *bionic_dlerror(void)
diff --git a/linker/dlfcn.h b/linker/dlfcn.h
--- a/linker/dlfcn.h
+++ b/linker/dlfcn.h
@@ -11,6 +11,7 @@
 #endif
 
