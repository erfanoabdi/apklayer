From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erfan Abdi <erfangplus@gmail.com>
Date: Mon, 9 Nov 2026 00:00:00 +0000
Subject: [PATCH] libdl: aarch64 dl* entries laid out as Android's libdl (first bl -> __loader_*)

apklayer patch (docs/PATCHES.md). adrenotools-style linker namespace bypasses (androidnsbypass in FCL and Pojav) find the
linker's private API on aarch64 by scanning dlopen/android_dlopen_ext/dlclose/dlsym for their first `bl` and calling its
target as __loader_<name>(..., caller), as Android's libdl.so is built. Our C entries began with backward bl's into the PLT;
read as an unsigned offset they pointed into unrelated memory (FCL: SIGSEGV in the JDK's lib/modules mapping). The entries
are now small asm functions whose first bl reaches a forward stub that branches to apkenv_loader_<name>, which takes the
private API's arguments. Other architectures keep the C entries.

--- a/linker/dlfcn.c
+++ b/linker/dlfcn.c
@@ -90,10 +90,22 @@
 	return ret;
 }
 
+/* apklayer patch: on aarch64 the dl* entries are laid out as Android's libdl.so is (bionic/libdl/libdl.cpp): the function's first
+ * `bl` is a forward call to the linker's __loader_<name>(..., caller). adrenotools-style namespace bypasses (androidnsbypass in
+ * FCL/Pojav) take that first bl's target as the private API and call it; our C entries began with backward bl's into the PLT,
+ * and the unsigned offset they compute pointed into unrelated memory (SIGSEGV). The targets below take the private API's arguments. */
+#define LOADER __attribute__((visibility("hidden"), used, noinline))
+LOADER void *apkenv_loader_dlopen(const char *filename, int flag, const void *caller)
+{
+	return dlopen_from(filename, flag, caller);
+}
+
+#if !defined(__aarch64__)
 void *bionic_dlopen(const char *filename, int flag)
 {
 	return dlopen_from(filename, flag, __builtin_return_address(0));
 }
+#endif
 
 struct android_dlextinfo {
 	uint64_t flags;
@@ -105,14 +117,21 @@
 	struct android_namespace_t* library_namespace;
 };
 
-void *bionic_android_dlopen_ext(const char *filename, int flags, const struct android_dlextinfo *info)
+LOADER void *apkenv_loader_android_dlopen_ext(const char *filename, int flags, const struct android_dlextinfo *info, const void *caller)
 {
 	if (info) {
 		fprintf(stderr, "ERROR: android_dlopen_ext with android_dlextinfo not implemented\n");
 	}
-	return dlopen_from(filename, flags, __builtin_return_address(0));
+	return dlopen_from(filename, flags, caller);
 }
 
+#if !defined(__aarch64__)
+void *bionic_android_dlopen_ext(const char *filename, int flags, const struct android_dlextinfo *info)
+{
+	return apkenv_loader_android_dlopen_ext(filename, flags, info, __builtin_return_address(0));
+}
+#endif
+
 const char *bionic_dlerror(void)
 {
 	const char *tmp = dl_err_str;
@@ -126,8 +145,9 @@
 
 #define MIN(a, b) (((a) < (b)) ? (a) : (b))
 
-void *bionic_dlsym(void *handle, const char *symbol)
+LOADER void *apkenv_loader_dlsym(void *handle, const char *symbol, const void *caller)
 {
+	(void)caller;
 	verbose("bionic_dlsym(%p, %s) called\n", handle, symbol);
 
 	soinfo *found;
@@ -268,8 +288,15 @@
 	return ret;
 }
 
-int bionic_dlclose(void *handle)
+#if !defined(__aarch64__)
+void *bionic_dlsym(void *handle, const char *symbol)
 {
+	return apkenv_loader_dlsym(handle, symbol, __builtin_return_address(0));
+}
+#endif
+
+LOADER int apkenv_loader_dlclose(void *handle)
+{
 	if (!do_we_have_this_handle(handle))
 		return dlclose(handle);
 
@@ -284,6 +311,23 @@
 	return 0;
 }
 
+#if defined(__aarch64__)
+/* entry(args): bti c; frame; caller (the return address) as the next argument; bl to a forward stub that branches to the target */
+#define DL_ENTRY(name, caller_reg, target) \
+	__asm__(".text\n.p2align 2\n.globl " #name "\n.type " #name ", %function\n" #name ":\n" \
+		"\thint 34\n\tstp x29, x30, [sp, #-16]!\n\tmov x29, sp\n" caller_reg \
+		"\tbl 1f\n\tldp x29, x30, [sp], #16\n\tret\n1:\thint 34\n\tb " #target "\n.size " #name ", .-" #name "\n")
+DL_ENTRY(bionic_dlopen, "\tmov x2, x30\n", apkenv_loader_dlopen);
+DL_ENTRY(bionic_android_dlopen_ext, "\tmov x3, x30\n", apkenv_loader_android_dlopen_ext);
+DL_ENTRY(bionic_dlsym, "\tmov x2, x30\n", apkenv_loader_dlsym);
+DL_ENTRY(bionic_dlclose, "", apkenv_loader_dlclose);
+#else
+int bionic_dlclose(void *handle)
+{
+	return apkenv_loader_dlclose(handle);
+}
+#endif
+
 #if defined(__arm__)
 //					 0000000 00011111 111112 22222222 2333333 333344444444445555555
 //					 0123456 78901234 567890 12345678 9012345 678901234567890123456
