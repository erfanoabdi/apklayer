+/* apklayer: AOSP exec.cpp argument collection, with the active guest environment and shared path execution. */
+#include <errno.h>
+#include <limits.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <stdio.h>
+
+extern "C" char ***bionic_environment_slot(void);
+extern "C" char *bionic_getenv(const char *);
+extern "C" int apklayer_exec_search_guest(const char *, char *const [], char *const [], const char *, bool) __attribute__((weak));
+extern "C" int bionic_execvpe(const char *, char *const [], char *const []);
+extern "C" int bionic_execvp(const char *, char *const []);
+
+static int as_script(const char *name, char *const argv[], char *const envp[]) {
+  size_t count = 0;
+  while (argv && argv[count]) ++count;
+  char **shell = static_cast<char **>(calloc(count + 3, sizeof(char *)));
+  if (!shell) return -1;
+  shell[0] = const_cast<char *>("/system/bin/sh");
+  shell[1] = const_cast<char *>(name);
+  for (size_t i = 1; i < count; ++i) shell[i + 1] = argv[i];
+  execve(shell[0], shell, envp);
+  int error = errno; free(shell); errno = error; return -1;
+}
+extern "C" int bionic_execv(const char *name, char *const argv[]) {
+  char ***slot = bionic_environment_slot();
+  return slot ? execve(name, argv, *slot) : -1;
+}
+extern "C" int bionic_execvp(const char *name, char *const argv[]) {
+  char ***slot = bionic_environment_slot();
+  return slot ? bionic_execvpe(name, argv, *slot) : -1;
+}
+extern "C" int bionic_execvpe(const char *name, char *const argv[], char *const envp[]) {
+  if (!name || !*name) { errno = ENOENT; return -1; }
+  if (strchr(name, '/')) {
+    execve(name, argv, envp);
+    return errno == ENOEXEC ? as_script(name, argv, envp) : -1;
+  }
+  char ***slot = bionic_environment_slot();
+  if (!slot) return -1;
+  if (slot == &environ) return execvpe(name, argv, envp);  // service/host opt-out retains host PATH semantics
+  const char *path = bionic_getenv("PATH");
+  if (!path) path = "/product/bin:/apex/com.android.runtime/bin:/apex/com.android.art/bin:/apex/com.android.virt/bin:/system_ext/bin:/system/bin:/system/xbin:/odm/bin:/vendor/bin:/vendor/xbin";
+  if (!apklayer_exec_search_guest) { errno = ENOSYS; return -1; }
+  return apklayer_exec_search_guest(name, argv, envp, path, true);
+}
+
+enum { ExecL, ExecLE, ExecLP };
+static int execute_list(int variant, const char *name, const char *arg, va_list ap) {
+  va_list count_ap;
+  va_copy(count_ap, ap);
+  size_t count = 1;
+  while (va_arg(count_ap, char *) != nullptr) ++count;
+  va_end(count_ap);
+  char **args = static_cast<char **>(calloc(count + 1, sizeof(char *)));
+  if (!args) return -1;
+  args[0] = const_cast<char *>(arg);
+  for (size_t i = 1; i <= count; ++i) args[i] = va_arg(ap, char *);
+  char ***slot = variant == ExecLE ? nullptr : bionic_environment_slot();
+  char **envp = variant == ExecLE ? va_arg(ap, char **) : slot ? *slot : nullptr;
+  int result = variant != ExecLE && !slot ? -1 : variant == ExecLP ? bionic_execvp(name, args) : execve(name, args, envp);
+  int error = errno; free(args); errno = error; return result;
+}
+extern "C" int bionic_execl(const char *name, const char *arg, ...) {
+  va_list ap; va_start(ap, arg); int result = execute_list(ExecL, name, arg, ap); va_end(ap); return result;
+}
+extern "C" int bionic_execle(const char *name, const char *arg, ...) {
+  va_list ap; va_start(ap, arg); int result = execute_list(ExecLE, name, arg, ap); va_end(ap); return result;
+}
+extern "C" int bionic_execlp(const char *name, const char *arg, ...) {
+  va_list ap; va_start(ap, arg); int result = execute_list(ExecLP, name, arg, ap); va_end(ap); return result;
+}
+extern "C" int bionic_fexecve(int fd, char *const argv[], char *const envp[]) {
+  char path[64]; snprintf(path, sizeof path, "/proc/self/fd/%d", fd);
+  execve(path, argv, envp);
+  if (errno == ENOENT) errno = EBADF;
+  return -1;
+}
