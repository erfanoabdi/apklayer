Subject: [PATCH] linker: an app's dlsym answers as Android's linker would (host-only symbols under any handle, JNI_GetCreatedJavaVMs in the global scope); app libraries in dladdr/dl_iterate_phdr under /data/app

diff --git a/linker/app_view.c b/linker/app_view.c
--- a/linker/app_view.c
+++ b/linker/app_view.c
@@ -111,5 +111,7 @@
 }
 
+extern long apklayer_android_spelling_own_data(char *buf, long n, long size) __attribute__((weak));  /* the preload: paths.c */
+
 /* host-only symbols that RTLD_DEFAULT does not find on Android */
 bool apkenv_app_symbol_hidden(const char *symbol)
 {
@@ -154,4 +156,5 @@
 	}
 	if (glibc_loaded) return false;
 	snprintf(buf, size, "%s", host_path);  /* a bionic-loaded library that is not the platform's: the app's own */
+	if (apklayer_android_spelling_own_data && size > 1) buf[apklayer_android_spelling_own_data(buf, (long)strlen(buf), (long)size - 1)] = 0;  /* its /data/app/... name */
 	return true;
diff --git a/linker/dlfcn.c b/linker/dlfcn.c
--- a/linker/dlfcn.c
+++ b/linker/dlfcn.c
@@ -193,6 +193,14 @@
 		goto err;
 	}
 
+	/* apklayer patch (0076): what an app's dlsym does not find on Android, whatever the handle (the host's glibc/JVM symbols; JNI_GetCreatedJavaVMs only in the
+	 * global scope: libnativehelper's own handle has it) */
+	if (apkenv_in_app_namespace(caller) && (apkenv_app_symbol_hidden(symbol)
+	    || (!strcmp(symbol, "JNI_GetCreatedJavaVMs") && (handle == RTLD_DEFAULT || handle == RTLD_NEXT)))) {
+		set_dlerror(DL_ERR_SYMBOL_NOT_FOUND);
+		goto err;
+	}
+
 	char wrap_sym_name[1024] = {'b', 'i', 'o', 'n', 'i', 'c', '_'};
 	memcpy(wrap_sym_name + 7, symbol, MIN(sizeof(wrap_sym_name) - 7, strlen(symbol)));
 
