From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erfan Abdi <erfangplus@gmail.com>
Date: Sat, 14 Nov 2026 00:00:00 +0000
Subject: [PATCH] libc: open of /proc/self/status returns a real descriptor

apklayer patch (docs/PATCHES.md). Upstream's bionic open answered
"/proc/self/status" with fileno() of an fmemopen stream, without TracerPid.
glibc's fmemopen streams have no descriptor, so the open returned -1 without
an error and every read of that "fd" failed with EBADF (an app's native code,
and a toybox child of an app). The open now goes to glibc like any other path;
apklayer's proc view (bridge/native/proc_view.c) projects the status (app ids,
name, TracerPid as the kernel reports it).

--- a/libc/libc-open-overrides.c
+++ b/libc/libc-open-overrides.c
@@ -47,36 +47,8 @@
 		return fd;
 	}
 
-	// Hide TracerPid from /proc/self/status for hideous apps that check for debugger.
-	// Note, since /proc/self/status doesn't get updated anymore, this may break some stuff.
-	// XXX: Turn this ON/OFF with env var maybe?
-	if (!strcmp(path, "/proc/self/status")) {
-		static FILE *faked = NULL;
-
-		if (!faked) {
-			static char status[4096];
-
-			{
-				FILE *f = fopen(path, "rb");
-				assert(f && "/proc/self/status failed to open :/");
-				const size_t ret = fread(status, 1, sizeof(status), f);
-				assert(ret <= sizeof(status) && "/proc/self/status doesn't fit in 4096 bytes :/");
-				fclose(f);
-			}
-
-			for (char *s, *e; (s = strstr(status, "TracerPid:\t"));) {
-				for (e = s; (size_t)(e - status) < sizeof(status) && *e && *e != '\n'; ++e)
-					;
-				memmove(s, e, sizeof(status) - (e - status));
-				break;
-			}
-
-			faked = fmemopen(status, sizeof(status), "rb");
-			assert(faked && "fmemopen failed :/");
-		}
-
-		return fileno(faked);
-	}
+	/* apklayer patch: /proc/self/status is a real descriptor. Upstream returned fileno() of an fmemopen stream here, which is -1 (EBADF on
+	 * every read): the open goes to glibc, where apklayer's proc view (bridge/native/proc_view.c) projects the app's status. */
 
 	if(OPEN_NEEDS_MODE(oflag)) {
 		va_list arg;
