From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erfan Abdi <erfangplus@gmail.com>
Date: Sat, 14 Nov 2026 00:00:00 +0000
Subject: [PATCH] linker: apex module names in an app's dl_iterate_phdr and dladdr

apklayer patch (docs/PATCHES.md). The libraries that Android keeps in an apex (ART's libandroidio, libjavacore, libnativehelper, ...; i18n's
ICU; statsd's libstatssocket) are named under /apex/<apex>/lib64 for an app-namespace caller, as Android's dl_iterate_phdr lists them (they
were /system/lib64), and the libdl entry is bionic's /apex/com.android.runtime/lib64/bionic/libdl.so (was /system/lib64/libdl.so).

--- a/linker/app_view.c
+++ b/linker/app_view.c
@@ -122,6 +122,21 @@
 #define RUNTIME_BIONIC "/apex/com.android.runtime/lib64/bionic/"
 #define ART_LIBART "/apex/com.android.art/lib64/libart.so"

+/* the libraries that live in an apex on Android, by file name (their staged copies are in <native>/android-libs) */
+static const char *apex_dir(const char *base)
+{
+	static const struct { const char *dir; const char *names; } apexes[] = {
+		{ "/apex/com.android.art/lib64/", " libandroidio.so libjavacore.so libnativehelper.so libnativebridge.so libnativeloader.so libsigchain.so libartbase.so libdexfile.so libartpalette.so libprofile.so libadbconnection.so libperfetto_hprof.so libopenjdk.so " },
+		{ "/apex/com.android.i18n/lib64/", " libandroidicu.so libicu.so libicui18n.so libicuuc.so libicu_jni.so " },
+		{ "/apex/com.android.os.statsd/lib64/", " libstatssocket.so " },
+	};
+	char key[128];
+	snprintf(key, sizeof key, " %s ", base);
+	for (size_t i = 0; i < sizeof apexes / sizeof *apexes; i++)
+		if (strstr(apexes[i].names, key)) return apexes[i].dir;
+	return NULL;
+}
+
 /* host_path -> the Android module path in buf; false: a host-only module (hidden). `kind` 0: a bionic-loaded module, 1: a glibc-loaded one. */
 bool apkenv_android_module(const char *host_path, char *buf, size_t size, bool glibc_loaded)
 {
@@ -131,6 +146,15 @@
 		return true;
 	}
 	const char *base = base_name(host_path);
+	const char *apex = apex_dir(base);
+	if (apex && (starts(host_path, "/system/lib64/") || strstr(host_path, "/android-libs/") || strstr(host_path, "/android-root/system/lib64/"))) {
+		snprintf(buf, size, "%s%s", apex, base);  /* a platform library that Android keeps in an apex (ART's, i18n's, statsd's) */
+		return true;
+	}
+	if (!strcmp(base, "libdl.so") && starts(host_path, "/system/")) {  /* the libdl entry */
+		snprintf(buf, size, RUNTIME_BIONIC "libdl.so");
+		return true;
+	}
 	if (starts(host_path, "/apex/") || starts(host_path, "/system/")) {  /* already an Android name (the libdl entry, libart's) */
 		snprintf(buf, size, "%s", host_path);
 		return true;
--- a/linker/linker.c
+++ b/linker/linker.c
@@ -480,6 +480,7 @@
 		if (si == &apkenv_libdl_info && libdl) {
 			dl_info = *libdl;
 			dl_info.dlpi_phdr = apkenv_android_phdr(libdl);
+			if (app_view) dl_info.dlpi_name = "/apex/com.android.runtime/lib64/bionic/libdl.so";  /* bionic's libdl is in the runtime apex, not /system/lib64 */
 		} else {
 			dl_info.dlpi_addr = si->linkmap.l_addr;
 			dl_info.dlpi_name = si->linkmap.l_name;
