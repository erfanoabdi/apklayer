+/* apklayer patch (0069): a guest's own execve takes the guest exec entry, as translated guests' do (Android's /bin is /system/bin) */
+extern "C" int bionic_execve(const char *name, char *const argv[], char *const envp[]) {
+  return apklayer_execve_guest ? apklayer_execve_guest(name, argv, envp) : execve(name, argv, envp);
+}
+
