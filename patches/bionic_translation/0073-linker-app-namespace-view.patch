+}
+
+/* apklayer patch (app_view.c): does the app namespace have this name itself: a loaded library of it, a file in its directories, or a
+ * name the cfg maps only for the app ("app:" lines) */
+bool apkenv_app_has_library(const char *name)
+{
+	for (soinfo *si = apkenv_solist; si; si = si->next)
+		if (si->app_ns && !strcmp(si->name, name)) return true;
+	for (const char **path = apkenv_app_ldpaths; *path; path++) {
+		char full[1024];
+		snprintf(full, sizeof full, "%s/%s", *path, name);
+		if (access(full, F_OK) == 0) return true;
+	}
+	for (int i = 0; i < lib_override_map.len; i++)
+		if (!strncmp(lib_override_map.overrides[i].from, "app:", 4) && !strcmp(lib_override_map.overrides[i].from + 4, name)) return true;
+	return false;
 }
 
