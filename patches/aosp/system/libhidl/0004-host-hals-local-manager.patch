+// the instance's own hwservicemanager (libhidl 0004): the stack writes its marker where host_hals.conf is
+static sp<IServiceManager1_2> localServiceManager() {
+    using android::hidl::manager::V1_2::BnHwServiceManager;
+    using android::hidl::manager::V1_2::BpHwServiceManager;
+    static const bool run = access("/data/apklayer/hwservicemanager.local", F_OK) == 0;
+    if (!run) return nullptr;
+    return fromBinder<IServiceManager1_2, BpHwServiceManager, BnHwServiceManager>(ProcessState::self()->getContextObject(nullptr));
+}
