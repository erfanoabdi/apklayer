+// apklayer patch: the host hwbinder context (Waydroid's host_hwbinder, libhwbinder 0001; libbinder's is frameworks/native 0006): a
+// second ProcessState on /dev/host_hwbinder (apklayer's path layer maps it to $APKLAYER_HOST_HWBINDER), absent when that is not there.
+static std::atomic<uintptr_t> gHostVMStart{0};
+static size_t gHostVMSize = 0;
+
+sp<ProcessState> ProcessState::self(bool host) {
+    if (!host) return self();
+    [[clang::no_destroy]] static sp<ProcessState> gHost;
+    [[clang::no_destroy]] static std::once_flag once;
+    std::call_once(once, []() {
+        const char* driver = "/dev/host_hwbinder";
+        if (access(driver, R_OK | W_OK) == -1) return;
+        sp<ProcessState> p = new ProcessState(DEFAULT_BINDER_VM_SIZE, driver);
+        if (p->mDriverFD < 0) return;
+        p->mHost = true;
+        gHostVMSize = p->mMmapSize;
+        gHostVMStart.store(reinterpret_cast<uintptr_t>(p->mVMStart), std::memory_order_release);
+        gHost = p;
+    });
+    return gHost;
+}
+
+bool ProcessState::isHostBuffer(const void* data) {
+    uintptr_t start = gHostVMStart.load(std::memory_order_acquire), p = reinterpret_cast<uintptr_t>(data);
+    return start != 0 && p >= start && p - start < gHostVMSize;
+}
+
 sp<ProcessState> ProcessState::selfOrNull() {
     return init(0, false /*requireMmapSize*/);
 }
