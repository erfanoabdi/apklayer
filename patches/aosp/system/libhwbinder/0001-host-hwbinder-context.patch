+// apklayer patch: a thread's state in the host hwbinder context (ProcessState::self(true)) is a second IPCThreadState under its own
+// TLS key; null when there is no host context.
+IPCThreadState* IPCThreadState::self(bool host)
+{
+    if (!host) return self();
+    static pthread_key_t key;
+    static std::once_flag once;
+    std::call_once(once, []() { pthread_key_create(&key, threadDestructor); });
+    if (auto* st = static_cast<IPCThreadState*>(pthread_getspecific(key))) return st;
+    if (ProcessState::self(true) == nullptr) return nullptr;
+    auto* st = new IPCThreadState(true);
+    pthread_setspecific(key, st);
+    return st;
+}
