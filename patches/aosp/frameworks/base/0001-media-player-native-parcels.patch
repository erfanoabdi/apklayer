From: Erfan Abdi <erfangplus@gmail.com>
Subject: [PATCH] apklayer: MediaPlayer JNI: callback Parcels from apklayer NativeParcel

Changes only the original listener payload allocation and its factory cache. APKLAYER_NATIVE_MEDIA_PARCELS
selects apklayer/host/NativeParcel.obtain; the factory class/method are cached on the initializing class
loader for later native binder threads, and a Java handshake makes native_setup fail if the adapter is
absent. Callback payloads keep the normal Java recycle/finalization semantics; without the variable the
Android path is unchanged. Verified by tests/vm/native-player.sh. Formerly scripts/patch-media-player.sh.
Against frameworks/base 653be4a9d2b0 (REVISION). Apply: patches/apply aosp <LineageOS tree>.
---
diff --git a/media/jni/android_media_MediaPlayer.cpp b/media/jni/android_media_MediaPlayer.cpp
index 9ae2b3a8ac89..671ea0510310 100644
--- a/media/jni/android_media_MediaPlayer.cpp
+++ b/media/jni/android_media_MediaPlayer.cpp
@@ -1,3 +1,4 @@
+#include <cstdlib>
 /*
 **
 ** Copyright 2007, The Android Open Source Project
@@ -82,7 +83,10 @@ using media::VolumeShaper;
 
 // ----------------------------------------------------------------------------
 
+// apklayer patch: selected native callback Parcels; ordinary Android path is unchanged.
 struct fields_t {
+    jclass hostParcelClass;
+    jmethodID hostParcelObtain;
     jfieldID    context;
     jfieldID    surface_texture;
 
@@ -144,7 +148,9 @@ void JNIMediaPlayerListener::notify(int msg, int ext1, int ext2, const Parcel *o
 {
     JNIEnv *env = AndroidRuntime::getJNIEnv();
     if (obj && obj->dataSize() > 0) {
-        jobject jParcel = createJavaParcelObject(env);
+        jobject jParcel = fields.hostParcelClass
+                ? env->CallStaticObjectMethod(fields.hostParcelClass, fields.hostParcelObtain)
+                : createJavaParcelObject(env);
         if (jParcel != NULL) {
             Parcel* nativeParcel = parcelForJavaObject(env, jParcel);
             nativeParcel->setData(obj->data(), obj->dataSize());
@@ -916,6 +922,21 @@ android_media_MediaPlayer_getMetadata(JNIEnv *env, jobject thiz, jboolean update
 static void
 android_media_MediaPlayer_native_init(JNIEnv *env)
 {
+    // apklayer patch: cache the factory on the initializing Java class loader,
+    // not on a subsequently attached native binder thread.
+    if (getenv("APKLAYER_NATIVE_MEDIA_PARCELS")) {
+        jclass factory = env->FindClass("apklayer/host/NativeParcel");
+        if (!factory) return;
+        fields.hostParcelObtain = env->GetStaticMethodID(factory, "obtain", "()Landroid/os/Parcel;");
+        if (!fields.hostParcelObtain) return;
+        fields.hostParcelClass = static_cast<jclass>(env->NewGlobalRef(factory));
+        jmethodID ready = env->GetStaticMethodID(factory, "markCallbackFactoryReady", "()V");
+        if (!ready) return;
+        env->CallStaticVoidMethod(factory, ready);
+        env->DeleteLocalRef(factory);
+        if (env->ExceptionCheck()) return;
+    }
+
     jclass clazz;
 
     clazz = env->FindClass("android/media/MediaPlayer");
