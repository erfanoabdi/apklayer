Subject: [PATCH] apklayer: report IGBA allocation failure status

Distinguish Binder failures from allocator service errors before they are
translated to Codec2 status. Keep expected allocation backpressure quiet.
Against frameworks/av 937eb9047ec2 (REVISION).
---
diff --git a/media/codec2/vndk/include/C2IgbaInterfaceImpl.h b/media/codec2/vndk/include/C2IgbaInterfaceImpl.h
--- a/media/codec2/vndk/include/C2IgbaInterfaceImpl.h
+++ b/media/codec2/vndk/include/C2IgbaInterfaceImpl.h
@@ -15,7 +15,9 @@
  */
 #pragma once

+#include <inttypes.h>
 #include <memory>
+#include <log/log.h>
 #include <C2IgbaInterface.h>

 #include <vndk/hardware_buffer.h>
@@ -58,13 +60,15 @@
         ::ndk::ScopedAStatus status = mIgba->allocate(desc, &allocation);
         if (!status.isOk()) {
             binder_exception_t ex = status.getExceptionCode();
-            if (ex == EX_SERVICE_SPECIFIC) {
-                c2_status_t err = static_cast<c2_status_t>(status.getServiceSpecificError());
-                return err;
-            } else {
-                ALOGW("igba::allocate transaction failed: %d", ex);
-                return C2_TRANSACTION_FAILED;
+            const int32_t serviceError =
+                    ex == EX_SERVICE_SPECIFIC ? status.getServiceSpecificError() : 0;
+            if (ex != EX_SERVICE_SPECIFIC || serviceError != C2_BLOCKING) {
+                ALOGW("IGBA allocate %ux%u format=%#x usage=%#" PRIx64
+                      " failed: exception=%d binder=%d service=%d",
+                      width, height, format, usage, ex, status.getStatus(), serviceError);
             }
+            return ex == EX_SERVICE_SPECIFIC ? static_cast<c2_status_t>(serviceError)
+                                             : C2_TRANSACTION_FAILED;
         }
         *pBuf = allocation.buffer.release();
         *syncFenceFd = allocation.fence.release();
