diff --git a/cpu_emulation/decoder/include/berberis/decoder/arm64/decoder.h b/cpu_emulation/decoder/include/berberis/decoder/arm64/decoder.h
index 0dc2ba69be1d7a51bffb336beea8c871deda8efd..5a98ba5bdc78c2566c5181e9398e2a8b8f1a5de3 100644
--- a/cpu_emulation/decoder/include/berberis/decoder/arm64/decoder.h
+++ b/cpu_emulation/decoder/include/berberis/decoder/arm64/decoder.h
@@ -2422,9 +2422,8 @@ class Decoder {
         // x86_64 TSO provides StoreStore, LoadLoad and LoadStore ordering for
         // free, but NOT StoreLoad. A full DMB/DSB (CRm option type 0b11=full or
         // 0b00=reserved-treated-as-full: SY/ISH/NSH/OSH) is a FULL barrier that
-        // DOES order a prior store before a later load, so it must lower to an
-        // MFENCE — NOP-ing it drops StoreLoad ordering and breaks sequentially
-        // consistent guest code (flaky lock-free / seqlock corruption). The
+        // DOES order a prior store before a later load, so it must lower to a
+        // full x86 fence to preserve sequentially consistent guest code. The
         // store-only (CRm type 0b10, *ST) and load-only (0b01, *LD) variants
         // need only orderings x86 already gives, so they stay NOPs.
         //
@@ -2436,7 +2435,7 @@ class Decoder {
         const bool is_dsb = (op2 == 0b100);
         const uint8_t barrier_type = crm & 0b11;  // 11=full, 00=reserved(full), 10=ST, 01=LD
         if ((is_dmb || is_dsb) && (barrier_type == 0b11 || barrier_type == 0b00)) {
-          insn_consumer_->DataMemoryBarrier();
+          insn_consumer_->DataMemoryBarrier(is_dmb && crm == 0b1011);
         } else if (op2 == 0b010) {
           // apklayer patch (0033): CLREX drops the exclusive reservation (a following STXR fails, as on hardware).
           insn_consumer_->ClearExclusive();
diff --git a/cpu_emulation/decoder/include/berberis/decoder/arm64/semantics_player.h b/cpu_emulation/decoder/include/berberis/decoder/arm64/semantics_player.h
index 5ddeea277d85c0c13b05e0f0f7119c3110ffed8a..340608c9321c2a0cf1f81c304b714264cefa1c5e 100644
--- a/cpu_emulation/decoder/include/berberis/decoder/arm64/semantics_player.h
+++ b/cpu_emulation/decoder/include/berberis/decoder/arm64/semantics_player.h
@@ -336,7 +336,9 @@ class SemanticsPlayer {
   void ClearExclusive() { listener_->ClearExclusive(); }
 
   // DMB/DSB full barrier (SY/ISH/...): a StoreLoad fence the host must honor.
-  void DataMemoryBarrier() { listener_->DataMemoryBarrier(); }
+  void DataMemoryBarrier(bool inner_shareable_dmb) {
+    listener_->DataMemoryBarrier(inner_shareable_dmb);
+  }
 
   // IC IVAU, Xt — invalidate the translation cache for the modified code line.
   void IcIvau(uint8_t rt) { listener_->IcIvau(rt); }
diff --git a/cpu_emulation/heavy_optimizer/arm64/frontend.cc b/cpu_emulation/heavy_optimizer/arm64/frontend.cc
index 350c585c2c2b3167b8818e485def2be3d1655603..0ef3244303942e4556f6fb1f45b29b006669cc0f 100644
--- a/cpu_emulation/heavy_optimizer/arm64/frontend.cc
+++ b/cpu_emulation/heavy_optimizer/arm64/frontend.cc
@@ -2612,9 +2612,13 @@ void HeavyOptimizerFrontend::ClearExclusive() {
       {.base = x86_64::kMachineRegRBP, .disp = static_cast<int32_t>(offsetof(ThreadState, cpu.reservation_address))}, GetImm(0));
 }
 
-void HeavyOptimizerFrontend::DataMemoryBarrier() {
-  // Full DMB/DSB -> MFENCE: recover the StoreLoad ordering x86 TSO omits.
-  GenRaw<x86_64::Mfence>();
+void HeavyOptimizerFrontend::DataMemoryBarrier(bool inner_shareable_dmb) {
+  if (inner_shareable_dmb && host_platform::kIsAuthenticAMD) {
+    GenRaw<x86_64::LockNotlOp>(
+        {.base = x86_64::kMachineRegRBP, .disp = offsetof(ThreadState, barrier_scratch)});
+  } else {
+    GenRaw<x86_64::Mfence>();
+  }
 }
 
 void HeavyOptimizerFrontend::RecordBail(BailReason reason) {
