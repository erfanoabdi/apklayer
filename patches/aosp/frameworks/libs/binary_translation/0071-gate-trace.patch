--- /dev/null
+++ b/runtime/arm64/gate_trace.h
@@ -0,0 +1,152 @@
+// apklayer patch (0071): PGR gate trace. Off unless BERBERIS_TRACE_GATE=<dir> (or prop berberis.trace_gate).
+// ACE's call gate is libanogs +0x1f5200 (x0..x3; x1 = callee, x2 = its argument; real caller = x30 of the gate's own bl) and its return is +0x1f5238.
+// Both pcs are installed as one-insn interpreted entries; berberis_HandleInterpret logs 128-byte records per thread to <dir>/gate-<pid>-<tid>.bin:
+//   u64 ts_ns, u32 kind, u32 tid, u64 x0,x1,x2,x3,x30,x29, u8 mem[64]
+//   kind 0 = entry (x30 = return address into the caller, mem = 64 bytes at x2), 1 = return (x0 = result), 2 = thread name (mem), 3 = callee name (x1, mem).
+// Plus <dir>/maps-<pid>-<n>.txt snapshots of /proc/self/maps at events 1, 2000, 20000, 100000. Each record is written at once (the process dies of SIGKILL).
+#ifndef BERBERIS_RUNTIME_ARM64_GATE_TRACE_H_
+#define BERBERIS_RUNTIME_ARM64_GATE_TRACE_H_
+
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <sys/prctl.h>
+#include <sys/syscall.h>
+#include <sys/uio.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <set>
+#include <unordered_map>
+
+#include "berberis/base/config_globals.h"
+#include "berberis/guest_state/guest_state.h"
+
+namespace berberis::gate_trace {
+
+constexpr uint64_t kGate = 0x1f5200, kRet = 0x1f5238;
+constexpr uint32_t kMaxPerThread = 400000;
+
+struct Rec { uint64_t ts; uint32_t kind, tid; uint64_t x[6]; uint8_t mem[64]; };
+static_assert(sizeof(Rec) == 128);
+
+inline const char* Dir() {
+  static ConfigStr dir("BERBERIS_TRACE_GATE", "berberis.trace_gate");
+  return dir.get();
+}
+inline std::mutex& Mu() { static std::mutex m; return m; }
+inline std::unordered_map<uint64_t, const char*>& Names() { static auto* m = new std::unordered_map<uint64_t, const char*>; return *m; }
+inline uint64_t g_hooks[16];  // hook pcs found so far (written under Mu, read racily: monotone)
+inline int g_nhooks = 0;
+inline uint64_t g_events = 0;
+
+inline void NoteName(uint64_t pc, const char* name) {
+  if (!Dir() || !name) return;
+  std::lock_guard<std::mutex> l(Mu());
+  Names()[pc] = name;
+}
+
+// Called when a region at pc is about to be translated: is pc one of the two gate pcs in a libanogs mapping at file offset 0?
+inline bool IsHookPc(uint64_t pc) {
+  if (!Dir()) return false;
+  for (int i = 0; i < g_nhooks; i++) if (g_hooks[i] == pc) return true;
+  uint64_t lo = pc & 0xfff;
+  if (lo != (kGate & 0xfff) && lo != (kRet & 0xfff)) return false;
+  FILE* f = fopen("/proc/self/maps", "r");
+  if (!f) return false;
+  char line[1024];
+  bool hit = false;
+  std::lock_guard<std::mutex> l(Mu());
+  while (fgets(line, sizeof line, f)) {
+    if (!strstr(line, "libanogs.so")) continue;
+    uint64_t a = strtoull(line, nullptr, 16);
+    char* p = strchr(line, ' ');
+    if (!p || strtoull(p + 6, nullptr, 16) != 0) continue;  // "rwxp " + offset
+    for (uint64_t off : {kGate, kRet}) {
+      if (a + off != pc) continue;
+      hit = true;
+      if (g_nhooks < 16) g_hooks[g_nhooks++] = pc;
+    }
+  }
+  fclose(f);
+  return hit;
+}
+inline bool IsHooked(uint64_t pc) {
+  if (!Dir()) return false;
+  for (int i = 0; i < g_nhooks; i++) if (g_hooks[i] == pc) return true;
+  return false;
+}
+
+inline void Maps(int n) {
+  char path[256], buf[4096];
+  snprintf(path, sizeof path, "%s/maps-%d-%d.txt", Dir(), getpid(), n);
+  int out = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+  int in = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+  if (out >= 0 && in >= 0) for (ssize_t r; (r = read(in, buf, sizeof buf)) > 0;) (void)!write(out, buf, r);
+  if (in >= 0) close(in);
+  if (out >= 0) close(out);
+}
+
+struct Th { int fd = -1; uint32_t n = 0, tid = 0; };
+inline thread_local Th t_th;
+
+inline void Put(Th& t, uint32_t kind, const uint64_t* x, const void* mem, size_t mlen) {
+  Rec r = {};
+  timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  r.ts = uint64_t(ts.tv_sec) * 1000000000ULL + ts.tv_nsec;
+  r.kind = kind;
+  r.tid = t.tid;
+  if (x) memcpy(r.x, x, sizeof r.x);
+  if (mem) memcpy(r.mem, mem, mlen > 64 ? 64 : mlen);
+  (void)!write(t.fd, &r, sizeof r);
+}
+
+// Before the insn at pc (a hook pc), in the interpreter.
+inline void Log(ThreadState* s, uint64_t pc) {
+  Th& t = t_th;
+  if (t.fd == -2 || t.n >= kMaxPerThread) return;
+  if (t.fd < 0) {
+    t.tid = uint32_t(syscall(SYS_gettid));
+    char path[256];
+    snprintf(path, sizeof path, "%s/gate-%d-%u.bin", Dir(), getpid(), t.tid);
+    t.fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (t.fd < 0) { t.fd = -2; return; }
+  }
+  const uint64_t* x = s->cpu.x;
+  uint64_t regs[6] = {x[0], x[1], x[2], x[3], x[30], x[29]};
+  uint64_t ev = __atomic_add_fetch(&g_events, 1, __ATOMIC_RELAXED);
+  if (ev == 1 || ev == 2000 || ev == 20000 || ev == 100000) Maps(int(ev));
+  if (t.n == 0 || t.n == 200 || t.n % 20000 == 0) {
+    char comm[16] = {};
+    prctl(PR_GET_NAME, comm);
+    Put(t, 2, regs, comm, 16);
+  }
+  t.n++;
+  if ((pc & 0xfff) == (kGate & 0xfff)) {
+    bool fresh;
+    { std::lock_guard<std::mutex> l(Mu()); static std::set<uint64_t> seen; fresh = seen.insert(x[1]).second; }
+    if (fresh) {
+      char nm[64] = {};
+      { std::lock_guard<std::mutex> l(Mu()); auto it = Names().find(x[1]); if (it != Names().end()) strncpy(nm, it->second, 63); }
+      Dl_info di;
+      if (!nm[0] && dladdr(reinterpret_cast<void*>(x[1]), &di) && di.dli_sname) snprintf(nm, sizeof nm, "%s", di.dli_sname);
+      uint64_t a[6] = {0, x[1]};
+      Put(t, 3, a, nm, 64);
+    }
+    uint8_t mem[64] = {};
+    iovec l{mem, sizeof mem}, rm{reinterpret_cast<void*>(x[2]), sizeof mem};
+    process_vm_readv(getpid(), &l, 1, &rm, 1, 0);  // short or failed read: the rest stays 0
+    Put(t, 0, regs, mem, sizeof mem);
+  } else {
+    Put(t, 1, regs, nullptr, 0);
+  }
+}
+
+}  // namespace berberis::gate_trace
+
+#endif  // BERBERIS_RUNTIME_ARM64_GATE_TRACE_H_
