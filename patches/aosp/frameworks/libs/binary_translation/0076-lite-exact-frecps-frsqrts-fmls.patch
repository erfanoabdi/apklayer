From: apklayer <noreply@apklayer.invalid>
Subject: [PATCH] apklayer patch: the lite tier translates FRECPS, FRSQRTS and vector FMLS with the Arm NaN rules

0041 sent FRECPS/FRSQRTS (vector and scalar) and vector FMLS to the interpreter for exact Arm results; in PGR's job threads
that interpreter work (decode, dispatch, AdvSimdThreeSame) was about a third of the process's CPU after 0072-0075 (perf,
2026-11-19). The lite tier now computes them itself: the fused step (FMA, one rounding), 2.0/1.5 for 0 x infinity, the Arm
NaN choice (FPProcessNaNs of (-a, b); FPProcessNaNs3 of (d, -n, m) for FMLS, with the default NaN for a quiet-NaN addend and
0 x infinity) quieted, the positive default NaN for invalid results, and FRSQRTS's (3 - ab)/2 without the intermediate
overflow (1.5 - (a/2)b where 3 - ab overflowed from finite operands). FPCR.DN is not honoured (as in EmitArmFpMinMax); FP16
forms stay with the interpreter. Test: Arm64DifferentialFuzz.FpStepFusedAndFmlsExact (lite vs interpreter, zeros, infinities,
quiet and signalling NaNs with payloads, denormals, overflowing products). Module libberberis_arm64.

diff --git a/cpu_emulation/lite_translator/arm64_to_x86_64/differential_fuzz_tests.cc b/cpu_emulation/lite_translator/arm64_to_x86_64/differential_fuzz_tests.cc
index 15449cd..078a0af 100644
--- a/cpu_emulation/lite_translator/arm64_to_x86_64/differential_fuzz_tests.cc
+++ b/cpu_emulation/lite_translator/arm64_to_x86_64/differential_fuzz_tests.cc
@@ -699,6 +699,65 @@ TEST_F(Arm64DifferentialFuzz, AdvSimdScalarThreeSame) {
   EXPECT_GT(compared, 200) << "JIT accepted too few scalar three-same encodings";
 }
 
+// apklayer patch (0076): FRECPS / FRSQRTS (vector .2S/.4S/.2D and scalar S/D) and vector FMLS are translated with the Arm NaN
+// rules; lanes are drawn from zeros, infinities, quiet and signalling NaNs of both signs with payloads, denormals, values whose
+// product overflows, and random bits. FPCR is 0 (round to nearest, DN off), as the interpreter's reference then is exact.
+TEST_F(Arm64DifferentialFuzz, FpStepFusedAndFmlsExact) {
+  Seed(0xF2EC95F5A1ED0076ULL);
+  static const uint32_t kS[] = {0x00000000u, 0x80000000u, 0x7f800000u, 0xff800000u, 0x7fc00000u, 0xffc12345u,
+                                0x7f800001u, 0xff812345u, 0x7fa00000u, 0x00000001u, 0x807fffffu, 0x3f800000u,
+                                0xbf800000u, 0x7f000000u, 0xff7fffffu, 0x5f800000u, 0x1f800000u, 0x40400000u};
+  static const uint64_t kD[] = {0x0ULL, 0x8000000000000000ULL, 0x7ff0000000000000ULL, 0xfff0000000000000ULL,
+                                0x7ff8000000000000ULL, 0xfff8000000012345ULL, 0x7ff0000000000001ULL,
+                                0xfff4000000012345ULL, 0x0000000000000001ULL, 0x800fffffffffffffULL,
+                                0x3ff0000000000000ULL, 0xbff0000000000000ULL, 0x7fe0000000000000ULL,
+                                0xffefffffffffffffULL, 0x5ff0000000000000ULL, 0x4008000000000000ULL};
+  const int kIters = 20000 * FuzzScale();
+  int compared = 0;
+  for (int iter = 0; iter < kIters; iter++) {
+    uint32_t kind = Rnd() % 5;  // 0 FRECPS.V 1 FRSQRTS.V 2 FMLS.V 3 FRECPS scalar 4 FRSQRTS scalar
+    uint32_t sz = Rnd() & 1;
+    uint32_t q = sz ? 1u : (Rnd() & 1);
+    uint32_t rn = Rnd() % 8, rm = Rnd() % 8;
+    uint32_t r = Rnd() % 4;
+    uint32_t rd = r == 0 ? rn : (r == 1 ? rm : (Rnd() % 8));
+    uint32_t insn;
+    if (kind <= 2) {
+      uint32_t hi = (kind == 0) ? 0u : 1u;                // bit 23
+      uint32_t opc = (kind == 2) ? 0b11001u : 0b11111u;   // FMLS / FRECPS, FRSQRTS
+      insn = (q << 30) | (0b01110u << 24) | (hi << 23) | (sz << 22) | (1u << 21) | (rm << 16) | (opc << 11) |
+             (1u << 10) | (rn << 5) | rd;
+    } else {
+      uint32_t hi = (kind == 3) ? 0u : 1u;
+      insn = (0b01u << 30) | (0b11110u << 24) | (hi << 23) | (sz << 22) | (1u << 21) | (rm << 16) |
+             (0b11111u << 11) | (1u << 10) | (rn << 5) | rd;
+    }
+    uint32_t code[1] = {insn};
+    InitState in = RandomInit();
+    for (uint32_t reg : {rn, rm, rd}) {
+      uint64_t lanes[2];
+      memcpy(lanes, &in.v[reg], 16);
+      if (sz) {
+        for (auto& l : lanes) if (Rnd() % 4 != 0) l = kD[Rnd() % (sizeof(kD) / sizeof(kD[0]))];
+      } else {
+        uint32_t w[4];
+        memcpy(w, lanes, 16);
+        for (auto& l : w) if (Rnd() % 4 != 0) l = kS[Rnd() % (sizeof(kS) / sizeof(kS[0]))];
+        memcpy(lanes, w, 16);
+      }
+      memcpy(&in.v[reg], lanes, 16);
+    }
+    std::string desc;
+    Result res = RunDifferential(code, 1, in, /*compare_fpsr=*/false, &desc);
+    if (res == kDeclined) continue;
+    compared++;
+    if (res == kDiverge) {
+      ADD_FAILURE() << "iter " << iter << " " << desc;
+    }
+  }
+  EXPECT_GT(compared, kIters / 2) << "JIT declined FRECPS/FRSQRTS/FMLS";
+}
+
 // Single-instruction AdvSIMD three-different (integer widening/narrowing). rd
 // aliasing rn/rm sampled; the lite tier JITs the widening-MUL family at all
 // sizes (the rest bail).
diff --git a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_fp_dataproc.inc b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_fp_dataproc.inc
index 39cbc66..a9b2bde 100644
--- a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_fp_dataproc.inc
+++ b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_fp_dataproc.inc
@@ -591,6 +591,214 @@
     return true;
   }
 
+  // apklayer patch (0076): exact Arm FRECPS / FRSQRTS / FMLS in translated code (0041 sent them to the interpreter, the hottest
+  // interpreter work in PGR's job threads). Packed over all lanes; scalar callers load with the upper lanes zero and mask the result.
+  // FPCR.DN is not honoured here (as in EmitArmFpMinMax).
+  void EmitArmFpUnord(SimdRegister d, SimdRegister s, bool is_double) {
+    if (is_double) as_.Cmpunordpd(d, s); else as_.Cmpunordps(d, s);
+  }
+  void EmitArmFpBroadcast(SimdRegister x, Register gp, uint64_t bits, bool is_double) {
+    if (is_double) {
+      as_.Movq(gp, static_cast<int64_t>(bits));
+      as_.Movq(x, gp);
+      as_.Punpcklqdq(x, x);
+    } else {
+      as_.Movl(gp, static_cast<int32_t>(bits));
+      as_.Movd(x, gp);
+      as_.Pshufd(x, x, int8_t{0});
+    }
+  }
+  // q = the quiet bit per lane, sign = the sign bit per lane.
+  void EmitArmFpQuietAndSign(SimdRegister q, SimdRegister sign, bool is_double) {
+    as_.Pcmpeqd(q, q);
+    as_.Pcmpeqd(sign, sign);
+    if (is_double) {
+      as_.Psllq(q, int8_t{63});
+      as_.Psrlq(q, int8_t{12});
+      as_.Psllq(sign, int8_t{63});
+    } else {
+      as_.Pslld(q, int8_t{31});
+      as_.Psrld(q, int8_t{9});
+      as_.Pslld(sign, int8_t{31});
+    }
+  }
+  // s = lanes of v that are signalling NaNs (nan_mask = the lanes where v is a NaN).
+  void EmitArmFpSnan(SimdRegister s, SimdRegister v, SimdRegister nan_mask, SimdRegister q, bool is_double) {
+    as_.Movdqa(s, v);
+    as_.Pand(s, q);
+    as_.Pcmpeqd(s, q);
+    if (is_double) as_.Pshufd(s, s, static_cast<int8_t>(0xF5));
+    as_.Pandn(s, nan_mask);
+  }
+  // ARM ARM FPProcessNaNs of (a, b): val = a where a is a signalling NaN, or a NaN and b not signalling, else b (raw, not quieted);
+  // any = a or b is a NaN; snan = a or b is signalling. t0..t3 are scratch.
+  void EmitArmNaNPick(SimdRegister a, SimdRegister b, SimdRegister q, bool is_double, SimdRegister val, SimdRegister any,
+                      SimdRegister snan, SimdRegister t0, SimdRegister t1, SimdRegister t2, SimdRegister t3) {
+    as_.Movdqa(t0, a);
+    EmitArmFpUnord(t0, t0, is_double);  // a is NaN
+    as_.Movdqa(t1, b);
+    EmitArmFpUnord(t1, t1, is_double);  // b is NaN
+    EmitArmFpSnan(t2, a, t0, q, is_double);
+    EmitArmFpSnan(t3, b, t1, q, is_double);
+    as_.Movdqa(any, t0);
+    as_.Por(any, t1);
+    as_.Movdqa(snan, t2);
+    as_.Por(snan, t3);
+    as_.Pandn(t3, t0);  // a NaN, b not signalling
+    as_.Por(t2, t3);    // the lanes that take a
+    as_.Movdqa(val, a);
+    as_.Pand(val, t2);
+    as_.Pandn(t2, b);
+    as_.Por(val, t2);
+  }
+
+  // FRECPS: 2 - a*b, FRSQRTS: (3 - a*b) / 2, one rounding (FPRecipStepFused / FPRSqrtStepFused). xn, xm are kept.
+  // Returns the result register, or no_simd_register (success_ = false) when out of registers.
+  SimdRegister EmitArmFpStepFused(SimdRegister xn, SimdRegister xm, bool is_rsqrt, bool is_double) {
+    SimdRegister q = AllocTempSimdReg();
+    SimdRegister sign = AllocTempSimdReg();
+    SimdRegister r = AllocTempSimdReg();
+    SimdRegister t = AllocTempSimdReg();
+    SimdRegister u = AllocTempSimdReg();
+    SimdRegister val = AllocTempSimdReg();
+    SimdRegister any = AllocTempSimdReg();
+    SimdRegister snan = AllocTempSimdReg();
+    SimdRegister t0 = AllocTempSimdReg();
+    SimdRegister t1 = AllocTempSimdReg();
+    SimdRegister t2 = AllocTempSimdReg();
+    SimdRegister t3 = AllocTempSimdReg();
+    Register gp = AllocTempReg();
+    if (!success()) { return no_simd_register; }
+    auto k = [&](double v32, double v64) {
+      uint64_t bits;
+      if (is_double) { memcpy(&bits, &v64, 8); } else { float f = static_cast<float>(v32); uint32_t b32; memcpy(&b32, &f, 4); bits = b32; }
+      return bits;
+    };
+    EmitArmFpQuietAndSign(q, sign, is_double);
+    EmitArmFpBroadcast(r, gp, k(is_rsqrt ? 3.0 : 2.0, is_rsqrt ? 3.0 : 2.0), is_double);
+    if (is_double) as_.Vfnmadd231pd(r, xn, xm); else as_.Vfnmadd231ps(r, xn, xm);  // K - a*b
+    if (is_rsqrt) {
+      EmitArmFpBroadcast(t, gp, k(0.5, 0.5), is_double);
+      if (is_double) as_.Mulpd(r, t); else as_.Mulps(r, t);  // exact, unless 3 - a*b overflowed before the halving
+      // Where r is infinite from finite a, b: 1.5 - (a/2)*b (there |a*b| overflows, so |a| >= 1 and a/2 is exact; an infinite
+      // operand already gave the right infinity; other lanes get 0, 0: no flags).
+      auto cmpeq = [&](SimdRegister d, SimdRegister s) { if (is_double) as_.Cmpeqpd(d, s); else as_.Cmpeqps(d, s); };
+      EmitArmFpBroadcast(val, gp, is_double ? 0x7ff0000000000000ULL : 0x7f800000ULL, is_double);
+      as_.Movdqa(u, sign);
+      as_.Pandn(u, r);  // |r|
+      cmpeq(u, val);    // u = r is infinite
+      as_.Movdqa(t0, sign);
+      as_.Pandn(t0, xn);
+      cmpeq(t0, val);
+      as_.Movdqa(t1, sign);
+      as_.Pandn(t1, xm);
+      cmpeq(t1, val);
+      as_.Por(t0, t1);
+      as_.Pandn(t0, u);
+      as_.Movdqa(u, t0);  // ... and a, b are not
+      as_.Movdqa(t0, xn);
+      as_.Pand(t0, u);
+      as_.Movdqa(t1, xm);
+      as_.Pand(t1, u);
+      if (is_double) as_.Mulpd(t0, t); else as_.Mulps(t0, t);
+      EmitArmFpBroadcast(t2, gp, k(1.5, 1.5), is_double);
+      if (is_double) as_.Vfnmadd231pd(t2, t0, t1); else as_.Vfnmadd231ps(t2, t0, t1);
+      as_.Pand(t2, u);
+      as_.Pandn(u, r);
+      as_.Por(t2, u);
+      as_.Movdqa(r, t2);
+    }
+    // (0, inf) or (inf, 0): r is NaN, neither input is: +2.0 / +1.5.
+    as_.Movdqa(t, xn);
+    EmitArmFpUnord(t, xm, is_double);
+    as_.Movdqa(u, r);
+    EmitArmFpUnord(u, u, is_double);
+    as_.Pandn(t, u);
+    EmitArmFpBroadcast(val, gp, k(is_rsqrt ? 1.5 : 2.0, is_rsqrt ? 1.5 : 2.0), is_double);
+    as_.Pand(val, t);
+    as_.Pandn(t, r);
+    as_.Por(val, t);
+    as_.Movdqa(r, val);
+    // A NaN operand: the Arm choice of (-a, b), quieted.
+    as_.Movdqa(u, xn);
+    as_.Pxor(u, sign);
+    EmitArmNaNPick(u, xm, q, is_double, val, any, snan, t0, t1, t2, t3);
+    as_.Por(val, q);
+    as_.Pand(val, any);
+    as_.Pandn(any, r);
+    as_.Por(val, any);
+    return val;
+  }
+
+  // FMLS: d + (-n)*m, one rounding (FPMulAdd with FPProcessNaNs3 of (d, -n, m)). xn is clobbered; xd, xm are kept.
+  SimdRegister EmitArmFpFmls(SimdRegister xd, SimdRegister xn, SimdRegister xm, bool is_double) {
+    SimdRegister q = AllocTempSimdReg();
+    SimdRegister sign = AllocTempSimdReg();
+    SimdRegister r = AllocTempSimdReg();
+    SimdRegister t = AllocTempSimdReg();
+    SimdRegister u = AllocTempSimdReg();
+    SimdRegister val = AllocTempSimdReg();
+    SimdRegister any = AllocTempSimdReg();
+    SimdRegister snan = AllocTempSimdReg();
+    SimdRegister s0 = AllocTempSimdReg();
+    SimdRegister s1 = AllocTempSimdReg();
+    SimdRegister s2 = AllocTempSimdReg();
+    SimdRegister s3 = AllocTempSimdReg();
+    Register gp = AllocTempReg();
+    if (!success()) { return no_simd_register; }
+    auto cmpeq = [&](SimdRegister d, SimdRegister s) { if (is_double) as_.Cmpeqpd(d, s); else as_.Cmpeqps(d, s); };
+    EmitArmFpQuietAndSign(q, sign, is_double);
+    as_.Movdqa(r, xd);
+    if (is_double) as_.Vfnmadd231pd(r, xn, xm); else as_.Vfnmadd231ps(r, xn, xm);  // d - n*m
+    as_.Pxor(xn, sign);  // op1 = -n (Arm negates before the NaN choice)
+    EmitArmNaNPick(xn, xm, q, is_double, val, any, snan, s0, s1, s2, s3);
+    as_.Movdqa(t, xd);
+    EmitArmFpUnord(t, t, is_double);         // d is NaN
+    EmitArmFpSnan(u, xd, t, q, is_double);   // d is signalling
+    // inf*0 of the operands (no NaN among them): (|n| == inf && m == 0) || (n == 0 && |m| == inf)
+    EmitArmFpBroadcast(s0, gp, is_double ? 0x7ff0000000000000ULL : 0x7f800000ULL, is_double);
+    as_.Pxor(s1, s1);
+    as_.Movdqa(s2, sign);
+    as_.Pandn(s2, xn);
+    cmpeq(s2, s0);
+    as_.Movdqa(s3, xm);
+    cmpeq(s3, s1);
+    as_.Pand(s2, s3);
+    as_.Movdqa(s3, sign);
+    as_.Pandn(s3, xm);
+    cmpeq(s3, s0);
+    as_.Movdqa(s0, xn);
+    cmpeq(s0, s1);
+    as_.Pand(s0, s3);
+    as_.Por(s0, s2);  // s0 = inf*0
+    // Default NaN: a quiet NaN d with inf*0, or a NaN result from no NaN operand.
+    as_.Movdqa(s1, u);
+    as_.Pandn(s1, t);  // d is a quiet NaN
+    as_.Pand(s0, s1);
+    as_.Por(any, t);   // any operand is a NaN
+    as_.Movdqa(s2, r);
+    EmitArmFpUnord(s2, s2, is_double);
+    as_.Movdqa(s3, any);
+    as_.Pandn(s3, s2);
+    as_.Por(s0, s3);   // s0 = the default-NaN lanes
+    // The NaN to return: d where d is signalling, or a NaN and neither product operand is signalling.
+    as_.Pandn(snan, t);
+    as_.Por(snan, u);
+    as_.Movdqa(s1, xd);
+    as_.Pand(s1, snan);
+    as_.Pandn(snan, val);
+    as_.Por(s1, snan);
+    as_.Por(s1, q);    // quieted
+    as_.Pand(s1, any);
+    as_.Pandn(any, r);
+    as_.Por(s1, any);
+    EmitArmFpBroadcast(s2, gp, is_double ? 0x7ff8000000000000ULL : 0x7fc00000ULL, is_double);
+    as_.Pand(s2, s0);
+    as_.Pandn(s0, s1);
+    as_.Por(s2, s0);
+    return s2;
+  }
+
   // FP arithmetic JIT
   //
   // FP16 (ftype=0b11) lowering: F16C round-trip.
diff --git a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_simd_scalar_three_same.inc b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_simd_scalar_three_same.inc
index 34d254e..fc8a00a 100644
--- a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_simd_scalar_three_same.inc
+++ b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_simd_scalar_three_same.inc
@@ -96,8 +96,8 @@
