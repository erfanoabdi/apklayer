From: Erfan Abdi <erfangplus@gmail.com>
Subject: [PATCH] apklayer: a guest free of no glibc chunk is left alone on a glibc host

On a glibc host (BERBERIS_FLAGS glibc-host-thread-id-handoff, bionic_translation) the guest heap is glibc's, and glibc aborts the
whole process on a pointer it never handed out. PGR (Punishing: Gray Raven, Unity, arm64-only on an x86_64 PC) freed a pointer into
the middle of an array whose words read as a 6 GB chunk header, minutes into each session ("double free or corruption (out)",
libberberis_arm64 WrapHostCallForGuestErrno -> free). __wrap_free checks the chunk header first: an in-use glibc chunk is 16-byte
aligned and, unless mmapped, 32 bytes to 64 MB; anything else is logged (the first 20) and not freed: a leak instead of the abort.

diff --git a/android_api/libc/free_quarantine.cc b/android_api/libc/free_quarantine.cc
index 823190f8..a1f2fcc2 100644
--- a/android_api/libc/free_quarantine.cc
+++ b/android_api/libc/free_quarantine.cc
@@ -45,6 +45,56 @@
 
 extern "C" void __real_free(void* ptr);
 
+#if defined(NATIVE_BRIDGE_GUEST_ARCH_ARM64)
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+namespace {
+
+// apklayer patch: on a glibc host (BERBERIS_FLAGS glibc-host-thread-id-handoff, bionic_translation) the guest heap is glibc's, which
+// aborts the whole process on a pointer it never handed out ("double free or corruption (out)": PGR, a Unity game, freed a pointer
+// into the middle of an array, a chunk header of 6 GB, minutes into a session). An in-use glibc chunk is 16-byte aligned and, unless
+// mmapped, 32 bytes to 64 MB (HEAP_MAX_SIZE; larger requests are mmapped), and an mmapped one passes munmap_chunk's page check; a
+// header outside that is not a chunk: logged and left alone, a leak instead of the abort ("munmap_chunk(): invalid pointer" when the
+// stray header had the IS_MMAPPED bit). Scudo (an Android host) checks its own headers.
+bool GlibcHost() {
+  static const bool glibc = [] {
+    const char* flags = getenv("BERBERIS_FLAGS");
+    return flags != nullptr && strstr(flags, "glibc-host-thread-id-handoff") != nullptr;
+  }();
+  return glibc;
+}
+
+bool NotAGlibcChunk(void* ptr) {
+  auto addr = reinterpret_cast<uintptr_t>(ptr);
+  if (addr % 16 != 0) return true;
+  const size_t* words = reinterpret_cast<const size_t*>(ptr);
+  size_t header = words[-1];
+  size_t size = header & ~static_cast<size_t>(7);
+  if (header & 2) {  // IS_MMAPPED: glibc's munmap_chunk aborts unless the mapping (chunk - prev_size) and its length are page-aligned
+    size_t prev = words[-2];
+    uintptr_t block = addr - 2 * sizeof(size_t) - prev;
+    size_t page = static_cast<size_t>(getpagesize());
+    return size == 0 || ((block | (prev + size)) & (page - 1)) != 0;
+  }
+  return size < 32 || size % 16 != 0 || size > (static_cast<size_t>(64) << 20);
+}
+
+void ReportInvalidFree(void* ptr, void* caller) {
+  static std::atomic<int> reported{0};
+  if (reported.fetch_add(1, std::memory_order_relaxed) >= 20) return;
+  char line[200];
+  size_t header = reinterpret_cast<uintptr_t>(ptr) % 16 ? 0 : reinterpret_cast<const size_t*>(ptr)[-1];
+  int n = snprintf(line, sizeof line, "berberis: free(%p) of no glibc chunk (header 0x%zx, host caller %p): left allocated\n", ptr, header,
+                   caller);
+  if (n > 0) write(2, line, static_cast<size_t>(n) < sizeof line ? static_cast<size_t>(n) : sizeof line - 1);
+}
+
+}  // namespace
+#endif
+
 #if defined(NATIVE_BRIDGE_GUEST_ARCH_ARM64)
 namespace {
 
@@ -67,6 +117,10 @@ extern "C" void __wrap_free(void* ptr) {
     __real_free(ptr);
     return;
   }
+  if (GlibcHost() && NotAGlibcChunk(ptr)) {  // apklayer patch: see NotAGlibcChunk
+    ReportInvalidFree(ptr, __builtin_return_address(0));
+    return;
+  }
 
   // Defer the real free through the quarantine ring so a just-freed chunk (and
   // its Scudo region) stays live long enough that the translator's Arena cannot
