From: apklayer <noreply@apklayer.invalid>
Subject: [PATCH] apklayer patch: Arm NaN rules and FPCR.DN in the interpreter, FMAX/FMIN NaN results, FMLS/FRECPS/FRSQRTS to the interpreter

The differences hello-acediff found against real arm64 in the NaN a floating-point instruction returns ("nan rules" lines, acediff_nan.c: 200 NaN-rich operand sets per
instruction, scalar and vector, single and double; real arm64's lines in real-arm64.txt).
New interpreter/arm64/arm_nan.h (ARM ARM FPProcessNaNs/FPProcessNaNs3, FPMax/FPMaxNum, FPMulAdd, FPRecipStepFused/FPRSqrtStepFused "fully fused", FPDefaultNaN; checked
against real arm64 over every pair/triple of 32 float values, DN on and off, 190000 results): the first signalling NaN, else the first quiet NaN, quieted; the POSITIVE
default NaN for an invalid operation (x86: 0xFFC00000); the default NaN for any NaN with FPCR.DN; FMLS/FMSUB/FNMADD/FNMSUB negate the NaN operand first; FMAXNM/FMINNM return
the number for a quiet NaN only. The interpreter uses it for FADD/FSUB/FMUL/FDIV/FSQRT/FABD/FMULX/FMLA/FMLS/FMADD family/FNMUL/FMAX*/FMIN*/FRECPS/FRSQRTS (scalar, vector,
by element, pairwise, FP16 through float); FMLA/FMLS by element (scalar form) are now fused (the product was rounded before the add).
Translators: EmitArmFpMinMax (lite and heavy, shared by every FMAX/FMIN/FMAXNM/FMINNM form) returns the Arm NaN for a NaN lane (it ORed the NaN bits of both operands);
FMLS (vector), FRECPS and FRSQRTS (vector and scalar) bail to the interpreter (a NaN operand's sign, and FRSQRTS rounds (3 + a*b)/2 once, which the translated sequence did not).
Not done (shortcut, acediff known-diffs "inv ", "dn ", "nn ", default-NaN, vsqrtq_f): translated FADD/FSUB/FMUL/FDIV/FSQRT/FMADD/FMLA of an invalid operation still returns x86's
NEGATIVE default NaN; translated code ignores FPCR.DN (only the interpreter honours it, and the translators translate almost everything); two NaN operands of different kinds
(quiet first, signalling second) give x86's first operand; translated FMSUB/FNMADD/FNMSUB/FMLS-by-element keep a NaN operand's sign. Upgrade: a fix-up after each such
operation (about 5 instructions) or a bail while FPCR.DN is set. Module libberberis_arm64.

diff --git a/cpu_emulation/interpreter/arm64/arm_nan.h b/cpu_emulation/interpreter/arm64/arm_nan.h
new file mode 100644
--- /dev/null
+++ b/cpu_emulation/interpreter/arm64/arm_nan.h
@@ -0,0 +1,154 @@
+// apklayer patch (0041): NaN results of Arm floating-point operations (ARM ARM FPProcessNaNs / FPProcessNaNs3, FPMax / FPMaxNum, FPDefaultNaN).
+// x86 returns the first NaN operand (any order, quieted) and a NEGATIVE default NaN (0xFFC00000) for an invalid operation; Arm picks the first
+// signalling NaN, else the first quiet NaN, in a fixed operand order, produces the POSITIVE default NaN (0x7FC00000) and returns the default NaN for
+// any NaN when FPCR.DN is set. These helpers recompute a NaN result from the operands; a non-NaN result is returned as it is.
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+namespace berberis {
+
+template <typename T>
+struct ArmFp;
+template <>
+struct ArmFp<float> {
+  using U = uint32_t;
+  static constexpr U kQuiet = 0x00400000u;
+  static constexpr U kDefault = 0x7fc00000u;
+};
+template <>
+struct ArmFp<double> {
+  using U = uint64_t;
+  static constexpr U kQuiet = 0x0008000000000000ull;
+  static constexpr U kDefault = 0x7ff8000000000000ull;
+};
+
+template <typename T>
+inline typename ArmFp<T>::U ArmBits(T v) {
+  typename ArmFp<T>::U u;
+  memcpy(&u, &v, sizeof(u));
+  return u;
+}
+template <typename T>
+inline T ArmFromBits(typename ArmFp<T>::U u) {
+  T v;
+  memcpy(&v, &u, sizeof(v));
+  return v;
+}
+template <typename T>
+inline bool ArmIsNaN(T v) {
+  return v != v;
+}
+template <typename T>
+inline bool ArmIsSNaN(T v) {
+  return v != v && (ArmBits(v) & ArmFp<T>::kQuiet) == 0;
+}
+template <typename T>
+inline T ArmDefaultNaN() {
+  return ArmFromBits<T>(ArmFp<T>::kDefault);
+}
+// The NaN an operation returns for the operand `v` it propagates.
+template <typename T>
+inline T ArmPropagate(bool dn, T v) {
+  return dn ? ArmDefaultNaN<T>() : ArmFromBits<T>(ArmBits(v) | ArmFp<T>::kQuiet);
+}
+
+// FPProcessNaNs(op1, op2): true and *out set when an operand is a NaN.
+template <typename T>
+inline bool ArmProcessNaNs(bool dn, T a, T b, T* out) {
+  if (ArmIsSNaN(a)) { *out = ArmPropagate(dn, a); return true; }
+  if (ArmIsSNaN(b)) { *out = ArmPropagate(dn, b); return true; }
+  if (ArmIsNaN(a)) { *out = ArmPropagate(dn, a); return true; }
+  if (ArmIsNaN(b)) { *out = ArmPropagate(dn, b); return true; }
+  return false;
+}
+template <typename T>
+inline bool ArmProcessNaNs3(bool dn, T a, T b, T c, T* out) {
+  if (ArmIsSNaN(a)) { *out = ArmPropagate(dn, a); return true; }
+  if (ArmIsSNaN(b)) { *out = ArmPropagate(dn, b); return true; }
+  if (ArmIsSNaN(c)) { *out = ArmPropagate(dn, c); return true; }
+  if (ArmIsNaN(a)) { *out = ArmPropagate(dn, a); return true; }
+  if (ArmIsNaN(b)) { *out = ArmPropagate(dn, b); return true; }
+  if (ArmIsNaN(c)) { *out = ArmPropagate(dn, c); return true; }
+  return false;
+}
+
+// A one- or two-operand arithmetic result r (FADD, FSUB, FMUL, FDIV, FSQRT, FMULX...) of the operands: the Arm NaN when r is one.
+template <typename T>
+inline T ArmFixNaN(bool dn, T r, T a, T b) {
+  if (r == r) return r;
+  T out;
+  return ArmProcessNaNs(dn, a, b, &out) ? out : ArmDefaultNaN<T>();
+}
+template <typename T>
+inline T ArmFixNaN(bool dn, T r, T a) {
+  return ArmFixNaN(dn, r, a, a);
+}
+
+// FPMulAdd(addend, op1, op2) = addend + op1 * op2, fused. NaN order: addend, op1, op2; a quiet NaN addend with 0 * infinity is the default NaN.
+template <typename T>
+inline T ArmFma(bool dn, T op1, T op2, T addend) {
+  T r = std::fma(op1, op2, addend);
+  if (r == r) return r;
+  if (ArmIsNaN(addend) && !ArmIsSNaN(addend) && ((op1 == T(0) && __builtin_isinf(op2)) || (__builtin_isinf(op1) && op2 == T(0)))) {
+    return ArmDefaultNaN<T>();
+  }
+  T out;
+  return ArmProcessNaNs3(dn, addend, op1, op2, &out) ? out : ArmDefaultNaN<T>();
+}
+
+// FPMax / FPMin: a NaN operand is processed; +0 beats -0 for max, -0 beats +0 for min.
+template <typename T>
+inline T ArmMax(bool dn, T a, T b) {
+  T out;
+  if (ArmProcessNaNs(dn, a, b, &out)) return out;
+  if (a == T(0) && b == T(0)) return __builtin_signbit(a) ? b : a;
+  return a > b ? a : b;
+}
+template <typename T>
+inline T ArmMin(bool dn, T a, T b) {
+  T out;
+  if (ArmProcessNaNs(dn, a, b, &out)) return out;
+  if (a == T(0) && b == T(0)) return __builtin_signbit(a) ? a : b;
+  return a < b ? a : b;
+}
+// FPMaxNum / FPMinNum: a quiet NaN against anything but a quiet NaN is replaced by -infinity (the other operand wins); signalling NaNs and
+// two quiet NaNs go through FPMax / FPMin.
+template <typename T>
+inline T ArmMaxNum(bool dn, T a, T b) {
+  const bool qa = ArmIsNaN(a) && !ArmIsSNaN(a), qb = ArmIsNaN(b) && !ArmIsSNaN(b);
+  if (qa && !qb) a = -T(__builtin_inf());
+  else if (!qa && qb) b = -T(__builtin_inf());
+  return ArmMax(dn, a, b);
+}
+template <typename T>
+inline T ArmMinNum(bool dn, T a, T b) {
+  const bool qa = ArmIsNaN(a) && !ArmIsSNaN(a), qb = ArmIsNaN(b) && !ArmIsSNaN(b);
+  if (qa && !qb) a = T(__builtin_inf());
+  else if (!qa && qb) b = T(__builtin_inf());
+  return ArmMin(dn, a, b);
+}
+
+// FRECPS / FRSQRTS step (FPRecipStepFused / FPRSqrtStepFused): op1 is negated first (also a NaN's sign); 0 * infinity gives 2.0 / 1.5.
+template <typename T>
+inline T ArmRecipStep(bool dn, T a, T b) {
+  a = -a;
+  T out;
+  if (ArmProcessNaNs(dn, a, b, &out)) return out;
+  if ((a == T(0) && __builtin_isinf(b)) || (__builtin_isinf(a) && b == T(0))) return T(2);
+  return std::fma(a, b, T(2));
+}
+template <typename T>
+inline T ArmRsqrtStep(bool dn, T a, T b) {
+  a = -a;
+  T out;
+  if (ArmProcessNaNs(dn, a, b, &out)) return out;
+  if ((a == T(0) && __builtin_isinf(b)) || (__builtin_isinf(a) && b == T(0))) return T(1.5);
+  // (3 + a * b) / 2 rounded once ("fully fused"): halving the larger operand first is exact and cannot overflow where the product would.
+  if (std::fabs(a) >= std::fabs(b)) a *= T(0.5); else b *= T(0.5);
+  return std::fma(a, b, T(1.5));
+}
+
+}  // namespace berberis
