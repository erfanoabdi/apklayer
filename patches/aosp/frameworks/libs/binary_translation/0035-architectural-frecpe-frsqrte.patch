diff --git a/cpu_emulation/interpreter/arm64/fp_estimate.h b/cpu_emulation/interpreter/arm64/fp_estimate.h
new file mode 100644
--- /dev/null
+++ b/cpu_emulation/interpreter/arm64/fp_estimate.h
@@ -0,0 +1,78 @@
+// apklayer patch (0035): the architectural FRECPE / FRSQRTE estimates (ARM ARM FPRecipEstimate / FPRSqrtEstimate: 8 fraction bits from a
+// 9-bit table index), bit-exact with hardware; the exact 1/x the interpreter computed before differs in every bit below the eighth.
+// E = exponent bits (5, 8, 11), F = fraction bits (10, 23, 52); `bits` is the raw element. NaN: quieted; DN and FZ are not honoured
+// (shortcut: FPCR.DN/FZ/RMode of an estimate; upgrade if a program sets them and looks at the result).
+#pragma once
+
+#include <cstdint>
+
+namespace berberis {
+
+inline uint64_t ArmFpRecipEstimate(uint64_t bits, int e, int f) {
+  const uint64_t frac_mask = (uint64_t{1} << f) - 1;
+  const uint64_t exp_mask = (uint64_t{1} << e) - 1;
+  uint64_t sign = (bits >> (e + f)) & 1;
+  int64_t exp = static_cast<int64_t>((bits >> f) & exp_mask);
+  uint64_t frac = bits & frac_mask;
+  uint64_t signed_zero = sign << (e + f);
+  uint64_t signed_inf = signed_zero | (exp_mask << f);
+  if (exp == static_cast<int64_t>(exp_mask)) {
+    return frac ? (bits | (uint64_t{1} << (f - 1))) : signed_zero;  // NaN (quieted) / infinity -> 0
+  }
+  if (exp == 0 && frac == 0) return signed_inf;  // zero -> infinity
+  if (exp == 0) {
+    if ((frac >> (f - 2)) == 0) return signed_inf;  // |x| < 2^-(2^(e-1)): overflows to infinity
+    if ((frac >> (f - 1)) == 0) {
+      exp = -1;
+      frac = (frac << 2) & frac_mask;
+    } else {
+      frac = (frac << 1) & frac_mask;
+    }
+  }
+  int scaled = 256 + static_cast<int>(frac >> (f - 8));  // '1' : fraction<F-1:F-8>
+  int a = scaled * 2 + 1;
+  int estimate = ((1 << 19) / a + 1) / 2;  // [256, 511]
+  int64_t result_exp = static_cast<int64_t>(exp_mask) - 2 - exp;
+  uint64_t fraction = static_cast<uint64_t>(estimate & 0xff) << (f - 8);
+  if (result_exp == 0) {
+    fraction = (uint64_t{1} << (f - 1)) | (fraction >> 1);
+  } else if (result_exp == -1) {
+    fraction = (uint64_t{1} << (f - 2)) | (fraction >> 2);
+    result_exp = 0;
+  }
+  return signed_zero | (static_cast<uint64_t>(result_exp) << f) | fraction;
+}
+
+inline uint64_t ArmFpRSqrtEstimate(uint64_t bits, int e, int f) {
+  const uint64_t frac_mask = (uint64_t{1} << f) - 1;
+  const uint64_t exp_mask = (uint64_t{1} << e) - 1;
+  uint64_t sign = (bits >> (e + f)) & 1;
+  int64_t exp = static_cast<int64_t>((bits >> f) & exp_mask);
+  uint64_t frac = bits & frac_mask;
+  if (exp == static_cast<int64_t>(exp_mask) && frac) return bits | (uint64_t{1} << (f - 1));  // NaN, quieted
+  if (exp == 0 && frac == 0) return (sign << (e + f)) | (exp_mask << f);                       // +-0 -> +-infinity
+  if (sign) return (exp_mask << f) | (uint64_t{1} << (f - 1));                                 // negative: the (positive) default NaN
+  if (exp == static_cast<int64_t>(exp_mask)) return 0;                                         // +infinity -> +0
+  if (exp == 0) {
+    while (((frac >> (f - 1)) & 1) == 0) {
+      frac = (frac << 1) & frac_mask;
+      exp -= 1;
+    }
+    frac = (frac << 1) & frac_mask;
+  }
+  int scaled = (exp & 1) ? 128 + static_cast<int>(frac >> (f - 7))  // '01' : fraction<F-1:F-7>
+                         : 256 + static_cast<int>(frac >> (f - 8));  // '1' : fraction<F-1:F-8>
+  int a;
+  if (scaled < 256) {
+    a = scaled * 2 + 1;
+  } else {
+    a = (((scaled >> 1) << 1) + 1) * 2;
+  }
+  int b = 512;
+  while (static_cast<int64_t>(a) * (b + 1) * (b + 1) < (int64_t{1} << 28)) b++;
+  int estimate = (b + 1) / 2;  // [256, 511]
+  int64_t result_exp = (3 * (int64_t{1} << (e - 1)) - 4 - exp) / 2;
+  return (static_cast<uint64_t>(result_exp) << f) | (static_cast<uint64_t>(estimate & 0xff) << (f - 8));
+}
+
+}  // namespace berberis
