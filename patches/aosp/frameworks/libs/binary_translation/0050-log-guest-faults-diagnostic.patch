From: apklayer <noreply@apklayer.invalid>
Subject: [PATCH] apklayer patch: BERBERIS_LOG_FAULTS logs every guest fault signal with registers (DIAGNOSTIC)

PGR's anti-cheat (Tencent ACE) meets real SEGV/BUS faults on the translated route that the native run never has, and the host kernel only
knows si_addr. berberis.log_faults=1 (env BERBERIS_LOG_FAULTS) writes one stderr block per guest fault signal the translator delivers
(SIGSEGV/SIGBUS/SIGILL/SIGFPE with si_code > 0, SIGTRAP): tid, signal, code, si_addr, the guest handler, pc and its instruction word, x0-x30,
sp, and for pc, x30 and si_addr the host mapping that contains it (range, protections, name+offset). First 300 per process.
Nothing is answered differently. Module libberberis_arm64.
diff --git a/guest_os_primitives/guest_signal_handling.cc b/guest_os_primitives/guest_signal_handling.cc
--- a/guest_os_primitives/guest_signal_handling.cc
+++ b/guest_os_primitives/guest_signal_handling.cc
@@ -14,7 +14,12 @@
  * limitations under the License.
  */
 
+#include <sys/syscall.h>
+#include <sys/uio.h>
 #include <ucontext.h>
+#include <unistd.h>
+#include <cstdio>
+#include <cstring>
 
 #include <atomic>
 #include <bit>
@@ -558,6 +563,62 @@ void GuestThread::ProcessPendingSignals() {
   }
 }
 
+// apklayer patch (0050, DIAGNOSTIC): berberis.log_faults=1 (BERBERIS_LOG_FAULTS) writes one stderr block per guest fault signal (SIGSEGV, SIGBUS,
+// SIGILL, SIGFPE with si_code > 0, SIGTRAP) the translator delivers: tid, signal, si_code, si_addr, the guest handler, the guest pc with the
+// instruction word, x0-x30 and sp, and for pc, x30 and si_addr the host mapping (name+offset, protections) from the host's own maps.
+// First 300 blocks per process. Nothing is answered differently.
+static void LogGuestFaultAddr(char* out, size_t cap, const char* what, uint64_t addr) {
+  FILE* f = fopen("/proc/self/maps", "re");
+  int n = snprintf(out, cap, "  %s 0x%llx:", what, static_cast<unsigned long long>(addr));
+  if (!f) return;
+  char line[600];
+  while (fgets(line, sizeof line, f)) {
+    unsigned long long lo = 0, hi = 0, off = 0;
+    char prot[8] = "";
+    int name = 0;
+    if (sscanf(line, "%llx-%llx %7s %llx %*s %*s %n", &lo, &hi, prot, &off, &name) < 4) continue;
+    if (addr >= lo && addr < hi) {
+      size_t l = strlen(line);
+      if (l && line[l - 1] == '\n') line[--l] = 0;
+      n += snprintf(out + n, cap - n, " %llx-%llx %s +0x%llx %s", lo, hi, prot, (unsigned long long)(addr - lo + off), name > 0 ? line + name : "");
+      break;
+    }
+  }
+  fclose(f);
+  if (n > 0 && static_cast<size_t>(n) < cap - 1) { out[n++] = '\n'; out[n] = 0; }
+}
+
+static void LogGuestFault(const siginfo_t* si, const Guest_sigaction* sa, ThreadState* state) {
+  static const ConfigStr enabled("BERBERIS_LOG_FAULTS", "berberis.log_faults");
+  if (enabled.get() == nullptr || enabled.get()[0] == '\0') return;
+  const int sig = si->si_signo;
+  if (!((sig == SIGSEGV || sig == SIGBUS || sig == SIGILL || sig == SIGFPE) && si->si_code > 0) && sig != SIGTRAP) return;
+  static std::atomic<int> reported{0};
+  if (reported.fetch_add(1, std::memory_order_relaxed) >= 300) return;
+  auto& cpu = GetCPUState(*state);
+  const uint64_t pc = GetInsnAddr(cpu);
+  uint32_t insn = 0;
+  struct iovec local = {&insn, sizeof insn}, remote = {reinterpret_cast<void*>(pc), sizeof insn};
+  bool insn_ok = process_vm_readv(getpid(), &local, 1, &remote, 1, 0) == static_cast<ssize_t>(sizeof insn);
+  char buf[3000];
+  int n = snprintf(buf, sizeof buf, "berberis: FAULT tid %d sig %d code %d si_addr %p handler 0x%llx pc 0x%llx insn %s0x%08x sp 0x%llx\n",
+                   static_cast<int>(syscall(__NR_gettid)), sig, si->si_code, si->si_addr,
+                   static_cast<unsigned long long>(sa ? static_cast<uint64_t>(sa->guest_sa_sigaction) : 0), static_cast<unsigned long long>(pc),
+                   insn_ok ? "" : "(unreadable) ", insn, static_cast<unsigned long long>(cpu.sp));
+  for (int i = 0; i < 31; i += 4) {
+    n += snprintf(buf + n, sizeof buf - n, "  x%-2d=%016llx x%-2d=%016llx x%-2d=%016llx x%-2d=%016llx\n", i, (unsigned long long)cpu.x[i],
+                  i + 1, (unsigned long long)cpu.x[i + 1], i + 2, (unsigned long long)(i + 2 < 31 ? cpu.x[i + 2] : 0),
+                  i + 3, (unsigned long long)(i + 3 < 31 ? cpu.x[i + 3] : 0));
+  }
+  LogGuestFaultAddr(buf + n, sizeof buf - n, "pc", pc);
+  n = strlen(buf);
+  LogGuestFaultAddr(buf + n, sizeof buf - n, "x30", cpu.x[30]);
+  n = strlen(buf);
+  LogGuestFaultAddr(buf + n, sizeof buf - n, "si_addr", reinterpret_cast<uint64_t>(si->si_addr));
+  n = strlen(buf);
+  if (write(2, buf, n) < 0) return;  // stderr gone: nothing to report to
+}
+
