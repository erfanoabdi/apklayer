@@ -39,12 +39,19 @@ namespace berberis {
 
 namespace {
 
-// apklayer patch (diagnostic): BERBERIS_HEAVY_DENY="simd,fp,ldst,simdldst,dpreg,dpimm,branch" (any subset, comma separated) keeps
+// apklayer patch (diagnostic): BERBERIS_HEAVY_DENY="simd,fp,ldst,simdldst,dpreg,dpimm,branch" (any subset, comma separated; ldst is
