 // noise in two-gear mode, clean with BERBERIS_MODE=lite-translate-or-interpret).
 enum : unsigned {
-  kDenySimd = 1, kDenyFp = 2, kDenyLdst = 4, kDenySimdLdst = 8, kDenyDpReg = 16, kDenyDpImm = 32, kDenyBranch = 64,
+  kDenySimd = 1, kDenyFp = 2, kDenySimdLdst = 8, kDenyDpReg = 16, kDenyDpImm = 32, kDenyBranch = 64,
+  // ldst (integer loads/stores) split: exclusives/ordered (LDXR/STXR/LDAR/STLR/CAS), LSE atomics, pairs, single registers.
+  // single: literal loads, SP-based accesses, other loads, other stores.
