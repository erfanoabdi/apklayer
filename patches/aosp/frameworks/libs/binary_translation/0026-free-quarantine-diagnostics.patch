+// apklayer patch (0026): BERBERIS_LOG_FREES=1 keeps the last 64K frees (pointer, the guest caller's x30, tid) so an invalid free can say whether the guest freed
+// that pointer before (a double free of its own, or of a chunk the ring already released) or never did (memory somebody else freed, or garbage), and lets 2000
+// invalid frees be described instead of 20. Off: one getenv, nothing recorded.
+bool LogFrees() {
+  static const bool on = getenv("BERBERIS_LOG_FREES") != nullptr;
+  return on;
+}
+
+struct FreeRecord {
+  uintptr_t ptr;
+  unsigned long guest_lr;
+  uint64_t seq;
+  int tid;
+};
+constexpr size_t kFreeHistory = 1 << 16;
+FreeRecord g_free_history[kFreeHistory];
+std::atomic<uint64_t> g_free_seq{0};
+bool InQuarantineRing(void* ptr);  // below, with the ring
+
+unsigned long CurrentGuestLr() {
+  if (berberis::GuestThread* thread = berberis::GuestThreadMap::GetInstance()->FindThread(gettid());
+      thread != nullptr && thread->state() != nullptr) {
+    return static_cast<unsigned long>(berberis::GetLinkRegister(berberis::GetCPUState(*thread->state())));
+  }
+  return 0;
+}
+
+void RecordFree(void* ptr) {
+  if (!LogFrees()) return;
+  const uint64_t seq = g_free_seq.fetch_add(1, std::memory_order_relaxed);
+  FreeRecord& r = g_free_history[seq % kFreeHistory];
+  r.ptr = reinterpret_cast<uintptr_t>(ptr);  // not atomic as a whole: a torn record is told by its seq
+  r.guest_lr = CurrentGuestLr();
+  r.tid = static_cast<int>(gettid());
+  r.seq = seq;
+}
+
+const FreeRecord* FindEarlierFree(void* ptr, uint64_t* ago) {
+  const uint64_t end = g_free_seq.load(std::memory_order_relaxed);
+  const uint64_t begin = end > kFreeHistory ? end - kFreeHistory : 0;
+  for (uint64_t s = end; s > begin;) {
+    --s;
+    const FreeRecord& r = g_free_history[s % kFreeHistory];
+    if (r.seq == s && r.ptr == reinterpret_cast<uintptr_t>(ptr)) {
+      *ago = end - s;
+      return &r;
+    }
+  }
+  return nullptr;
+}
+
 // Every guest call into the proxy libc arrives through WrapHostCallForGuestErrno, so the host return address names no caller: the
 // guest code that called free is the calling guest thread's link register (x30; its pc is the free trampoline). The thread is only
