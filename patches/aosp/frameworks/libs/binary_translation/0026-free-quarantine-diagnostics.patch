+bool InQuarantineRing(void* ptr) {  // apklayer patch (0026): the diagnostic of an invalid free
+  for (auto& slot : g_quarantine) {
+    if (slot.load(std::memory_order_relaxed) == ptr) return true;
+  }
+  return false;
+}
