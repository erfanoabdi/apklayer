+// The shim owns the initial guest view; explicit child environments are already restored there.
+extern "C" char*** bionic_environment_slot() __attribute__((weak));
+extern "C" int apklayer_execve_guest(const char*, char* const[], char* const[]) __attribute__((weak));
 
 namespace berberis {
 
@@ -126,9 +131,24 @@
   return env;
 }
 
+char** GuestEnvironmentForStartup(char** envp) {
+  static char* empty[] = {nullptr};
+  if (!bionic_environment_slot) return envp;
+  char*** slot = bionic_environment_slot();
+  if (!slot) std::abort();
+  char** selected = *slot;
+  return selected ? selected : empty;
+}
+
 char** DemangleGuestEnvp(char** dst, char** envp) {
+  if (bionic_environment_slot) {
+    while (*envp) *dst++ = *envp++;
+    *dst++ = nullptr;
+    return dst;
+  }
+
   auto [guest_prefix, guest_prefix_size] = GetGuestPlatformVarPrefixWithSize();
-  static const bool show_host = getenv("BERBERIS_SHOW_HOST_MAPS") != nullptr;
+  static const bool show_host = berberis::HostGetenv("BERBERIS_SHOW_HOST_MAPS") != nullptr;
 
   for (; *envp; ++envp) {
     char* env = *envp;
@@ -150,6 +170,7 @@
 }
 
 int ExecveForGuest(const char* filename, char* const argv[], char* const envp[]) {
+  if (apklayer_execve_guest) return apklayer_execve_guest(filename, argv, envp);
   ScopedMmap new_envp;
   return execve(filename, argv, MangleGuestEnvp(&new_envp, envp));
 }
