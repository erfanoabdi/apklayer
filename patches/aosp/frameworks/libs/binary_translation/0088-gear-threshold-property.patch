+uint32_t GetGearSwitchThreshold() {
+  static const uint32_t value = []() -> uint32_t {
+    static ConfigStr var("BERBERIS_GEAR_THRESHOLD", "berberis.gear_threshold");
+    const char* str = var.get();
+    if (str) {
+      char* end = nullptr;
+      unsigned long parsed = strtoul(str, &end, 10);
+      if (end != str && *end == '\0' && parsed > 0 && parsed < 0xffffffffUL) return static_cast<uint32_t>(parsed);
+    }
+    return config::kGearSwitchThreshold;
+  }();
+  return value;
+}
