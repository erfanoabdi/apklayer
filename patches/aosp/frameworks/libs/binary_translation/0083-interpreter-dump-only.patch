 }
+// BERBERIS_TRACE_DUMP_ONLY: before an insn, the registers at a listed pc as one text line on stderr (at most 50 per pc), nothing else recorded:
+// fast enough to reach a late event (PGR's download stall). Offsets as BERBERIS_TRACE_DUMP.
+void BbDumpOnly(ThreadState* state, uint64_t pc) {
+  const BbCfg& c = Cfg();
+  BbThread& t = t_bb;
+  if (!g_hi) {
+    if ((++t.any & 0xffff) == 1) FindRange();
+    return;
+  }
+  if (pc >= g_lo)
+    for (int i = 0; i < c.ndump; i++)
+      if (pc == g_lo + c.dump[i] && g_ndump[i]++ < 50) {
+        char line[1200];
+        int n = snprintf(line, sizeof line, "[bbdump] tid=%ld pc=%#lx +%#lx", long(syscall(SYS_gettid)), (unsigned long)pc, (unsigned long)c.dump[i]);
+        for (int k = 0; k < 31 && n < int(sizeof line) - 40; k++) n += snprintf(line + n, sizeof line - n, " x%d=%#lx", k, (unsigned long)state->cpu.x[k]);
+        n += snprintf(line + n, sizeof line - n, " sp=%#lx\n", (unsigned long)state->cpu.sp);
+        (void)!write(2, line, n);
+      }
+  if ((++t.any & 0xffffff) == 0) FindRange();
+}
 // Before an insn at pc: dump registers at a listed pc.
 void BbDumpRegs(ThreadState* state, uint64_t pc);
 void BbDump(ThreadState* state, uint64_t pc) {
@@ -342,6 +365,7 @@
   SemanticsPlayer sem_player(&interpreter);
   Decoder decoder(&sem_player);
   static const bool trace_on = Cfg().dir != nullptr;
+  static const bool dump_only = !trace_on && Cfg().dump_only && Cfg().ndump > 0;
 
   for (int i = 0; i < max_insns; i++) {
     GuestAddr pc = state->cpu.insn_addr;
@@ -351,6 +375,7 @@
       break;
     }
 
+    if (dump_only) BbDumpOnly(state, pc);
     if (trace_on) {
       BbSvc(state, pc);
       if (Cfg().ndump) BbDump(state, pc);
