From: apklayer <apklayer@localhost>
Subject: [PATCH] apklayer patch: dump-only register dump (BERBERIS_TRACE_DUMP_ONLY), interpreter and translated tiers

With BERBERIS_TRACE_DUMP_ONLY=1 (prop berberis.trace_dump_only), no BERBERIS_TRACE_BB, and BERBERIS_TRACE_DUMP=<hex offsets>, the interpreter prints x0..x30 and sp at each listed pc as one text line on stderr (50 per pc), recording nothing else: fast enough to reach PGR's download stall. Off by default. Module libberberis_arm64.
---
--- a/cpu_emulation/interpreter/arm64/interpreter-main.cc
+++ b/cpu_emulation/interpreter/arm64/interpreter-main.cc
@@ -54,6 +54,7 @@
   bool all = false;
   uint64_t dump[8] = {};
   int ndump = 0;
+  bool dump_only = false;  // BERBERIS_TRACE_DUMP_ONLY=1 (no BERBERIS_TRACE_BB): registers at the listed pcs as text on stderr, no branch trace
 };
 const BbCfg& Cfg() {
   static const BbCfg cfg = [] {
@@ -62,9 +63,11 @@
     static ConfigStr mod("BERBERIS_TRACE_MODULE", "berberis.trace_module");
     static ConfigStr all("BERBERIS_TRACE_ALL", "berberis.trace_all");
     static ConfigStr dmp("BERBERIS_TRACE_DUMP", "berberis.trace_dump");
+    static ConfigStr dmo("BERBERIS_TRACE_DUMP_ONLY", "berberis.trace_dump_only");
     c.dir = dir.get();
     if (mod.get()) c.module = mod.get();
     c.all = all.get() && all.get()[0] == '1';
+    c.dump_only = dmo.get() && dmo.get()[0] == '1';
     if (dmp.get()) {
       const char* q = dmp.get();
       while (*q && c.ndump < 8) {
@@ -117,7 +120,7 @@
   fclose(f);
   if (!hi) return;
   bool changed = n != g_nrng || memcmp(r, g_rng, n * sizeof(Rng)) != 0;
-  if (changed) {
+  if (changed && Cfg().dir) {
     char path[256];
     snprintf(path, sizeof path, "%s/maps-%d.txt", Cfg().dir, getpid());
     int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
@@ -287,6 +290,26 @@
