--- /dev/null
+++ b/runtime/arm64/dump_hook.h
@@ -0,0 +1,95 @@
+// apklayer patch (0083): register dump at chosen guest pcs inside the translated (lite) tiers. Off unless BERBERIS_TRACE_DUMP_ONLY=1 and
+// BERBERIS_TRACE_DUMP=<hex offsets, comma separated> (props berberis.trace_dump_only, berberis.trace_dump); the offsets are from the lowest mapping of
+// BERBERIS_TRACE_MODULE (default libanogs.so). Like gate_trace.h, a pc is installed as a one-insn interpreted entry when a region at it is translated (so it
+// must be a region start: a branch target or a function entry); berberis_HandleInterpret then writes one text line to stderr (x0..x30, sp; 200 per pc)
+// and interprets the insn. Everything else keeps running translated.
+#ifndef BERBERIS_RUNTIME_ARM64_DUMP_HOOK_H_
+#define BERBERIS_RUNTIME_ARM64_DUMP_HOOK_H_
+
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+#include "berberis/base/config_globals.h"
+#include "berberis/guest_state/guest_state.h"
+
+namespace berberis::dump_hook {
+
+struct Cfg {
+  uint64_t off[8] = {};
+  int n = 0;
+  const char* module = "libanogs.so";
+};
+inline const Cfg& C() {
+  static const Cfg c = [] {
+    Cfg r;
+    static ConfigStr only("BERBERIS_TRACE_DUMP_ONLY", "berberis.trace_dump_only");
+    static ConfigStr list("BERBERIS_TRACE_DUMP", "berberis.trace_dump");
+    static ConfigStr mod("BERBERIS_TRACE_MODULE", "berberis.trace_module");
+    if (mod.get()) r.module = mod.get();
+    if (only.get() && only.get()[0] == '1' && list.get()) {
+      const char* q = list.get();
+      while (*q && r.n < 8) {
+        r.off[r.n++] = strtoull(q, nullptr, 16);
+        q = strchr(q, ',');
+        if (!q) break;
+        q++;
+      }
+    }
+    return r;
+  }();
+  return c;
+}
+inline std::mutex& Mu() { static std::mutex m; return m; }
+inline uint64_t g_hooks[8];  // pcs found (written under Mu, read racily: monotone)
+inline int g_nhooks = 0;
+inline int g_count[8];
+
+// A region at pc is about to be translated: is pc the module's base + a listed offset?
+inline bool IsHookPc(uint64_t pc) {
+  const Cfg& c = C();
+  if (!c.n) return false;
+  for (int i = 0; i < g_nhooks; i++) if (g_hooks[i] == pc) return true;
+  bool low = false;
+  for (int i = 0; i < c.n; i++) low |= (c.off[i] & 0xfff) == (pc & 0xfff);
+  if (!low) return false;
+  FILE* f = fopen("/proc/self/maps", "r");
+  if (!f) return false;
+  char line[1024];
+  uint64_t lo = ~0ULL;
+  while (fgets(line, sizeof line, f)) {
+    if (!strstr(line, c.module)) continue;
+    uint64_t a = strtoull(line, nullptr, 16);
+    if (a < lo) lo = a;
+  }
+  fclose(f);
+  if (lo == ~0ULL) return false;
+  std::lock_guard<std::mutex> l(Mu());
+  for (int i = 0; i < c.n; i++)
+    if (pc == lo + c.off[i] && g_nhooks < 8) { g_hooks[g_nhooks++] = pc; return true; }
+  return false;
+}
+inline int Index(uint64_t pc) {
+  for (int i = 0; i < g_nhooks; i++) if (g_hooks[i] == pc) return i;
+  return -1;
+}
+inline bool IsHooked(uint64_t pc) { return C().n && Index(pc) >= 0; }
+
+inline void Log(ThreadState* s, uint64_t pc) {
+  int i = Index(pc);
+  if (i < 0 || __atomic_add_fetch(&g_count[i], 1, __ATOMIC_RELAXED) > 200) return;
+  char line[1200];
+  int n = snprintf(line, sizeof line, "[bbdump] tid=%ld pc=%#lx", long(syscall(SYS_gettid)), (unsigned long)pc);
+  for (int k = 0; k < 31 && n < int(sizeof line) - 40; k++) n += snprintf(line + n, sizeof line - n, " x%d=%#lx", k, (unsigned long)s->cpu.x[k]);
+  n += snprintf(line + n, sizeof line - n, " sp=%#lx\n", (unsigned long)s->cpu.sp);
+  (void)!write(2, line, n);
+}
+
+}  // namespace berberis::dump_hook
+
+#endif  // BERBERIS_RUNTIME_ARM64_DUMP_HOOK_H_
