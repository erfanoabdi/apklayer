From: Erfan Abdi <erfangplus@gmail.com>
Subject: [PATCH] apklayer: per-thread bionic records on a glibc host

Under bionic_translation the host thread slots Berberis copies into a guest thread's TLS are glibc's (%fs+0x08 the DTV,
%fs+0x48 feature_1). With glibc-host-thread-id-handoff each guest thread gets a zeroed pthread_internal_t (its tid set)
and bionic_tls of its own. Base: Digitalis android17 (github.com/DigitalisX64/platform_frameworks_libs_binary_translation), REVISION.

diff --git a/guest_os_primitives/guest_thread.cc b/guest_os_primitives/guest_thread.cc
index fc14da7a..1ed287bd 100644
--- a/guest_os_primitives/guest_thread.cc
+++ b/guest_os_primitives/guest_thread.cc
@@ -22,6 +22,7 @@
 #if defined(__BIONIC__)
 #include "private/bionic_constants.h"
 #include "private/bionic_tls.h"
+#include "bionic/pthread_internal.h"  // apklayer patch: pthread_internal_t (glibc host records)
 #endif
 
 #include "berberis/base/bit_util.h"
@@ -53,6 +54,10 @@ void InitState();
 
 NativeBridgeStaticTlsConfig g_static_tls_config;
 
+// apklayer patch: the records a glibc host gives each guest thread (InitStaticTls): a pthread_internal_t, then a bionic_tls.
+constexpr size_t kGlibcHostThreadRecordSize = AlignUpPageSize(sizeof(pthread_internal_t));
+constexpr size_t kGlibcHostRecordsSize = kGlibcHostThreadRecordSize + AlignUpPageSize(sizeof(bionic_tls));
+
 namespace {
 
 const size_t kGuestThreadPageAlignedSize = AlignUpPageSize(sizeof(GuestThread));
@@ -188,6 +193,9 @@ void GuestThread::Destroy(GuestThread* thread) {
   if (thread->static_tls_ != nullptr) {
     MunmapOrDie(thread->static_tls_, AlignUpPageSize(g_static_tls_config.size));
   }
+  if (thread->glibc_host_records_ != nullptr) {  // apklayer patch
+    MunmapOrDie(thread->glibc_host_records_, kGlibcHostRecordsSize);
+  }
   if (thread->scs_region_ != nullptr) {
     MunmapOrDie(thread->scs_region_, SCS_GUARD_REGION_SIZE);
   }
@@ -372,12 +380,23 @@ void GuestThread::InitStaticTls() {
   // pthread_internal_t*. Such a host seeds a synthetic bionic pthread record in
   // TLS_SLOT_NATIVE_BRIDGE_GUEST_STATE; take the thread id from there and let
   // the store below replace it with the live GuestThread pointer.
-  const size_t host_thread_id_slot = IsConfigFlagSet(kGlibcHostThreadIdHandoff)
-                                         ? TLS_SLOT_NATIVE_BRIDGE_GUEST_STATE
-                                         : TLS_SLOT_THREAD_ID;
-  tls[g_static_tls_config.tls_slot_thread_id] = GetTls()[host_thread_id_slot];
+  if (IsConfigFlagSet(kGlibcHostThreadIdHandoff)) {
+    // apklayer patch: under bionic_translation the host's thread slots are glibc's (%fs+0x08 the DTV, %fs+0x48 feature_1): there is no
+    // host pthread_internal_t or bionic_tls to share, and nothing seeds one for threads the JVM made. The thread gets zeroed records of its
+    // own, with its tid as bionic's pthread_create sets it. Limit: errno set by a proxied host call is glibc's, not the guest's.
+    if (glibc_host_records_ == nullptr) {
+      glibc_host_records_ = Mmap(kGlibcHostRecordsSize);
+      CHECK_NE(glibc_host_records_, MAP_FAILED);
+      static_cast<pthread_internal_t*>(glibc_host_records_)->tid = GettidSyscall();
+    }
+    tls[g_static_tls_config.tls_slot_thread_id] = glibc_host_records_;
+    tls[g_static_tls_config.tls_slot_bionic_tls] =
+        static_cast<char*>(glibc_host_records_) + kGlibcHostThreadRecordSize;
+  } else {
+    tls[g_static_tls_config.tls_slot_thread_id] = GetTls()[TLS_SLOT_THREAD_ID];
+    tls[g_static_tls_config.tls_slot_bionic_tls] = GetTls()[TLS_SLOT_BIONIC_TLS];
+  }
   // endregion
-  tls[g_static_tls_config.tls_slot_bionic_tls] = GetTls()[TLS_SLOT_BIONIC_TLS];
   GetTls()[TLS_SLOT_NATIVE_BRIDGE_GUEST_STATE] = GetThreadStateStorage(*state_);
   SetTlsAddr(*state_, ToGuestAddr(tls));
 #else
diff --git a/guest_os_primitives/include/berberis/guest_os_primitives/guest_thread.h b/guest_os_primitives/include/berberis/guest_os_primitives/guest_thread.h
index ac845aba..e1ba7504 100644
--- a/guest_os_primitives/include/berberis/guest_os_primitives/guest_thread.h
+++ b/guest_os_primitives/include/berberis/guest_os_primitives/guest_thread.h
@@ -130,6 +130,8 @@ class GuestThread {
   GuestAddr stack_top_ = {};
 
   void* static_tls_ = nullptr;
+  // apklayer patch: on a glibc host, this thread's own bionic records (pthread_internal_t, bionic_tls); see InitStaticTls.
+  void* glibc_host_records_ = nullptr;
 
   // Shadow call stack.
   void* scs_region_ = nullptr;
