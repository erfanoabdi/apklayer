+// apklayer patch (diagnostic, 0081): BERBERIS_HEAVY_DUMP=<file> appends one line per region the heavy tier compiles: its pc, the number of
+// instructions and their words (hex), for Arm64HeavyRegionReplay to run them again heavy vs interpreter. PGR's home scene stayed noise
+// after 0077/0078 while every generated test passed: its own regions are the corpus.
+void DumpHeavyRegion(GuestAddr pc, size_t count) {
+  static const int fd = [] {
+    const char* path = berberis::HostGetenv("BERBERIS_HEAVY_DUMP");
+    return path ? open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644) : -1;
+  }();
+  if (fd < 0 || count == 0) return;
+  std::string line = std::to_string(count);
+  char word[24];
+  snprintf(word, sizeof(word), "%lx ", static_cast<unsigned long>(pc));
+  line = word + line;
+  const uint32_t* insns = ToHostAddr<const uint32_t>(pc);
+  for (size_t i = 0; i < count; i++) {
+    snprintf(word, sizeof(word), " %08x", insns[i]);
+    line += word;
+  }
+  line += '\n';
+  if (write(fd, line.data(), line.size()) < 0) return;
+}
+
 }  // namespace
 
 // Optimizing (second-gear) translation of the ARM64 region at `pc`. Drives the
@@ -146,6 +172,7 @@ std::tuple<GuestAddr, bool, size_t> HeavyOptimizeRegion(GuestAddr pc,
   }
 
   x86_64::GenCode(&machine_ir, machine_code);
+  DumpHeavyRegion(pc, number_of_instructions);  // apklayer patch (diagnostic, 0081)
 
   return {stop_pc, frontend.success(), number_of_instructions};
 }
