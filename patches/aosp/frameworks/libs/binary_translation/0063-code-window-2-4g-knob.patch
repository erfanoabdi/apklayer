+#include "gtest/gtest.h"
+
+#include <cstdint>
+#include <cstdio>
+
+#include "berberis/base/mmap.h"
+#include "berberis/runtime/berberis.h"
+
+namespace {
+constexpr uintptr_t kExistingPage = 0x90200000;
+constexpr uint64_t kValue = 0x123456789abcdef0;
+
+TEST(CodeWindowStartup, PreservesExistingDataAndReservesItsChunkNeighbors) {
+  EXPECT_EQ(*reinterpret_cast<uint64_t*>(kExistingPage), kValue);
+  EXPECT_FALSE(berberis::IntersectsCodeWindow(reinterpret_cast<void*>(kExistingPage), 4096));
+  EXPECT_TRUE(berberis::IntersectsCodeWindow(reinterpret_cast<void*>(0x90400000), 4096));
+  EXPECT_TRUE(berberis::IntersectsCodeWindow(reinterpret_cast<void*>(0x93fff000), 4096));
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+  testing::InitGoogleTest(&argc, argv);
+  // Occupy part of one 64 MiB chunk before the production runtime reserves it.
+  void* page = mmap(reinterpret_cast<void*>(kExistingPage),
+                    berberis::kPageSize,
+                    PROT_READ | PROT_WRITE,
+                    MAP_PRIVATE | MAP_ANONYMOUS | berberis::kMmapFixedNoReplace,
+                    -1,
+                    0);
+  if (page != reinterpret_cast<void*>(kExistingPage)) {
+    std::fprintf(stderr, "Unable to create the startup collision mapping\n");
+    return 1;
+  }
+  *static_cast<uint64_t*>(page) = kValue;
+  berberis::InitBerberis();
+  return RUN_ALL_TESTS();
+}
