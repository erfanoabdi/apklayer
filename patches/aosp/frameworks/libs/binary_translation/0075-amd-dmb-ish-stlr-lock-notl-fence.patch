diff --git a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translate_region_exec_tests.cc b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translate_region_exec_tests.cc
index e449be5..0cf0678 100644
--- a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translate_region_exec_tests.cc
+++ b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translate_region_exec_tests.cc
@@ -602,13 +602,25 @@ TEST_F(Arm64LiteTranslateRegionTest, StoreLoadBarrierEmitsMfence) {
   auto has_mfence = [](const std::string& s) {
     return s.find("0f ae f0") != std::string::npos || s.find("0F AE F0") != std::string::npos;
   };
-  EXPECT_TRUE(has_mfence(region_bytes(0x889ffc01))) << "STLR W must emit MFENCE";
-  EXPECT_TRUE(has_mfence(region_bytes(0xc89ffc01))) << "STLR X must emit MFENCE";
-  EXPECT_TRUE(has_mfence(region_bytes(0xd5033bbf))) << "DMB ISH (full) must emit MFENCE";
-  EXPECT_TRUE(has_mfence(region_bytes(0xd5033fbf))) << "DMB SY (full) must emit MFENCE";
-  EXPECT_TRUE(has_mfence(region_bytes(0xd5033f9f))) << "DSB SY (full) must emit MFENCE";
-  EXPECT_FALSE(has_mfence(region_bytes(0xd5033abf))) << "DMB ISHST (store-only) needs no MFENCE";
-  EXPECT_FALSE(has_mfence(region_bytes(0x88dffc01))) << "LDAR needs no MFENCE (x86 acquire is free)";
+  // apklayer patch (0075): the full fence is LOCK NOTL of ThreadState::barrier_scratch (F0 F7 /2, ModRM 95: [RBP + disp32]).
+  auto has_lock_notl = [](const std::string& s) {
+    return s.find("f0 f7 95") != std::string::npos || s.find("F0 F7 95") != std::string::npos;
+  };
+  // STLR W/X and DMB ISH: the locked fence on AMD, MFENCE elsewhere.
+  for (uint32_t insn : {0x889ffc01u, 0xc89ffc01u, 0xd5033bbfu}) {
+    const auto bytes = region_bytes(insn);
+    EXPECT_EQ(has_lock_notl(bytes), host_platform::kIsAuthenticAMD) << std::hex << insn;
+    EXPECT_EQ(has_mfence(bytes), !host_platform::kIsAuthenticAMD) << std::hex << insn;
+  }
+  // DSB ISH, DMB SY, DSB SY: MFENCE on every host.
+  for (uint32_t insn : {0xd5033b9fu, 0xd5033fbfu, 0xd5033f9fu}) {
+    const auto bytes = region_bytes(insn);
+    EXPECT_TRUE(has_mfence(bytes)) << std::hex << insn << ": DSB and non-ISH DMB keep MFENCE";
+    EXPECT_FALSE(has_lock_notl(bytes)) << std::hex << insn;
+  }
+  EXPECT_FALSE(has_lock_notl(region_bytes(0xd5033abf))) << "DMB ISHST (store-only) needs no fence";
+  EXPECT_FALSE(has_mfence(region_bytes(0xd5033abf)));
+  EXPECT_FALSE(has_lock_notl(region_bytes(0x88dffc01))) << "LDAR needs no fence (x86 acquire is free)";
 }
 
