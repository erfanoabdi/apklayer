+// apklayer patch (0047): the guest's kernel identity. The host's /proc/version names its compiler ("x86_64-linux-gnu-gcc") and /proc/sys/kernel/arch says
+// "x86_64" while the guest's uname says aarch64 (an anti-cheat reads them: Unity's SystemInfo.processorType read "x86-64" under translation).
+// - /proc/version: the host's text with x86_64/amd64 spelled aarch64/arm64; with `berberis.kernel.release` (and `berberis.kernel.version`, the "#1 SMP ..."
+//   build string; properties, or BERBERIS_KERNEL_RELEASE/BERBERIS_KERNEL_VERSION) a device kernel's: "Linux version <release> (android-build@abfarm) (Android
+//   clang version 12.0.5) <version>".
+// - /proc/sys/kernel/arch: "aarch64"; /proc/sys/kernel/osrelease and /proc/sys/kernel/version: the two properties when set.
+// uname's release and version follow the same properties (arm64/syscall_emulation.cc). BERBERIS_SHOW_HOST_MAPS turns it off.
+// Returns a memfd for a path of this set opened for reading, else -1 with errno 0.
+int OpenKernelIdentityForGuest(const char* path, int host_flags) {
+  static const bool show_host = berberis::HostGetenv("BERBERIS_SHOW_HOST_MAPS") != nullptr;
+  errno = 0;
+  if (show_host || path == nullptr || strncmp(path, "/proc/", 6) != 0 || (host_flags & O_ACCMODE) != O_RDONLY) return -1;
+  const char* leaf = path + 6;
+  static ConfigStr release_prop("BERBERIS_KERNEL_RELEASE", "berberis.kernel.release");
+  static ConfigStr version_prop("BERBERIS_KERNEL_VERSION", "berberis.kernel.version");
+  const char* release = release_prop.get();
+  const char* version = version_prop.get();
+  if (release != nullptr && release[0] == '\0') release = nullptr;
+  if (version != nullptr && version[0] == '\0') version = nullptr;
+  std::string text;
+  if (strcmp(leaf, "version") == 0) {
+    struct utsname uts;
+    if (release != nullptr && uname(&uts) == 0) {
+      text = std::string("Linux version ") + release + " (android-build@abfarm-release-rbe-64) (Android clang version 12.0.5) " + (version != nullptr ? version : uts.version) + "\n";
+    } else {
+      int fd = open("/proc/version", O_RDONLY | O_CLOEXEC);
+      if (fd < 0) return -1;
+      char buf[1024];
+      ssize_t n = read(fd, buf, sizeof(buf) - 1);
+      close(fd);
+      if (n <= 0) return -1;
+      text.assign(buf, static_cast<size_t>(n));
+      for (const auto& [from, to] : {std::pair<const char*, const char*>{"x86_64", "aarch64"}, {"amd64", "arm64"}}) {
+        for (size_t at = text.find(from); at != std::string::npos; at = text.find(from, at + strlen(to))) text.replace(at, strlen(from), to);
+      }
+    }
+  } else if (strcmp(leaf, "sys/kernel/arch") == 0) {
+    text = "aarch64\n";
+  } else if (strcmp(leaf, "sys/kernel/osrelease") == 0 && release != nullptr) {
+    text = std::string(release) + "\n";
+  } else if (strcmp(leaf, "sys/kernel/version") == 0 && version != nullptr) {
+    text = std::string(version) + "\n";
+  } else {
+    return -1;
+  }
+  int mem_fd = CreateMemfdOrDie("[guest kernel identity]");
+  WriteFullyOrDie(mem_fd, text.c_str(), text.size());
+  lseek(mem_fd, 0, 0);
+  return mem_fd;
+}
+
+
 // In zygote this is not needed because native bridge is mounting
 // /proc/cpuinfo to point to the emulated version. But for executables
 // this does not happen and they end up reading host cpuinfo.
@@ -828,6 +882,9 @@ int OpenatForGuest(int dirfd, const char* path, int guest_flags, mode_t mode) {
     }
     return OpenAttrCurrentForGuest();
   }
+  if (const int kernel_fd = OpenKernelIdentityForGuest(path, host_flags); kernel_fd >= 0) {  // apklayer patch (0047)
+    return kernel_fd;
+  }
   if (IsProcSelfMaps(path, host_flags, "/proc/self/status")) {  // apklayer patch (0017): /proc/<own pid>/status is the same inode
     return OpenatProcSelfStatusForGuest(dirfd, host_flags, mode);
   }
