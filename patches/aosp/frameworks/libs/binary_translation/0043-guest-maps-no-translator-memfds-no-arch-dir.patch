 #include <cstring>  // memcpy
 
 #include "berberis/kernel_api/main_executable_real_path_emulation.h"
@@ -33,7 +34,14 @@
   }
   const char* real_path = TryReadLinkToMainExecutableRealPath(path);
   if (!real_path) {
-    return readlinkat(dirfd, path, buf, buf_size);
+    return SpellMapFilesLinkForGuest(dirfd, path, buf, readlinkat(dirfd, path, buf, buf_size), buf_size);  // apklayer patch (0043)
+  }
+  // apklayer patch (0043): a device's app_process64 is /system/bin/app_process64, not in the host's arm64 directory
+  static constexpr char kArchBin[] = "/system/bin/arm64/";
+  static thread_local char spelled[4096];
+  if (strncmp(real_path, kArchBin, sizeof(kArchBin) - 1) == 0 &&
+      snprintf(spelled, sizeof spelled, "/system/bin/%s", real_path + sizeof(kArchBin) - 1) < static_cast<int>(sizeof spelled)) {
+    real_path = spelled;
   }
   // readlink have quite unusual semantic WRT handling of buffer length.  readlink should not add
