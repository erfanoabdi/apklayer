 long RunGuestSyscall___NR_execveat(long arg_1, long arg_2, long arg_3, long arg_4, long arg_5) {
   UNUSED(arg_1, arg_2, arg_3, arg_4, arg_5);
   TRACE("unimplemented syscall __NR_execveat");
@@ -393,6 +499,7 @@
     }
   }
 
+  ReportGuestSyscall(state, guest_nr);  // apklayer patch: logging only (BERBERIS_LOG_SYSCALLS)
   ReportGuestSelfSignal(state, guest_nr);  // apklayer patch: logs only, before the signal is sent (it may end the process)
   long result = RunGuestSyscallImpl(guest_nr,
                                     state->cpu.x[0],
@@ -407,6 +514,8 @@
     state->cpu.x[0] = result;
   }
 
+  ReportGuestSyscallResult(state, guest_nr);  // apklayer patch: logging only
+
   if (kInstrumentSyscalls) {
     OnSyscallReturn(state, guest_nr);
   }
