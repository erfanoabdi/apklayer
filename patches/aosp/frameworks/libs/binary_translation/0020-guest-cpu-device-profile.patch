From: Erfan Abdi <erfangplus@gmail.com>
Subject: [PATCH] apklayer: the guest's CPU identity follows a device profile (berberis.cpuinfo = pixel5)

tools/device-profile.sh pixel5 makes an instance present a Google Pixel 5 (Build.*, ro.product.*, the SoC). The CPU the guest reads must agree with it:
with `berberis.cpuinfo=pixel5` (property, or BERBERIS_CPUINFO in the environment) the synthesized /proc/cpuinfo (FormatGuestCpuinfo) lists the
Snapdragon 765G's 8 cores, not the host's count: cpu0-5 Kryo 475 Silver (implementer 0x51, variant 0xd, part 0x805, revision 14), cpu6-7 Kryo 475
Gold/Prime (part 0x804), and a guest read of MIDR_EL1 (interpreter, the decoder already emulates the register) returns the Silver core's 0x51DF805E
instead of the generic Cortex-A53's. The Features line is untouched: it must stay what AT_HWCAP and the interpreter provide (0010). The identity values are
from memory of a Pixel 5, not captured from one. Without the property nothing changes. The host's online CPU count (sysconf, /sys/devices/system/cpu) is
still the host's; only /proc/cpuinfo and MIDR_EL1 are profiled. Applies after 0019. Module libberberis_arm64.

diff --git a/kernel_api/arm64/open_emulation.cc b/kernel_api/arm64/open_emulation.cc
--- a/kernel_api/arm64/open_emulation.cc
+++ b/kernel_api/arm64/open_emulation.cc
@@ -21,8 +21,10 @@
 #include <sys/types.h>
 
 #include <cstdio>
+#include <cstring>  // apklayer patch (0020)
 #include <string>
 
+#include "berberis/base/config_globals.h"  // apklayer patch (0020)
 #include "berberis/base/tracing.h"
 
 namespace berberis {
@@ -110,6 +112,31 @@
 
 const char* kGuestCpuinfoPath = "/system/etc/cpuinfo.arm64.txt";
 
+// apklayer patch (0020): the CPU a device profile presents (`berberis.cpuinfo`, BERBERIS_CPUINFO; tools/device-profile.sh). "pixel5": Snapdragon 765G
+// (SM7250), 8 cores: cpu0-5 Kryo 475 Silver (Cortex-A55 based, part 0x805), cpu6-7 Kryo 475 Gold/Prime (Cortex-A76 based, part 0x804), implementer
+// 0x51 (Qualcomm), variant 0xd, revision 14. Values from a Pixel 5's /proc/cpuinfo as remembered, not captured. The feature list stays the
+// translator's (0010: AT_HWCAP agrees with it); only the identity changes. Without the setting the generic core below.
+namespace {
+struct CoreIdentity {
+  int cpus;
+  const char* implementer;
+  const char* variant;
+  const char* part;
+  const char* revision;
+  const char* part_big;  // cores from `big_from` on
+  int big_from;
+};
+bool ProfileIdentity(CoreIdentity* id) {
+  static ConfigStr config("BERBERIS_CPUINFO", "berberis.cpuinfo");
+  const char* profile = config.get();
+  if (profile != nullptr && strcmp(profile, "pixel5") == 0) {
+    *id = {8, "0x51", "0xd", "0x805", "14", "0x804", 6};
+    return true;
+  }
+  return false;
+}
+}  // namespace
+
 std::string FormatGuestCpuinfo(int num_cpus) {
   if (num_cpus < 1) {
     num_cpus = 1;
@@ -122,6 +149,11 @@
   // describe a generic ARMv8 core (0x41 = 'ARM', 0xd05 = Cortex-A55); only the
   // CPU count is taken from the real device, so a guest sees the emulator's
   // actual online core count rather than a hard-coded value.
+  CoreIdentity identity;  // apklayer patch (0020)
+  const bool profile = ProfileIdentity(&identity);
+  if (profile) {
+    num_cpus = identity.cpus;
+  }
   std::string out;
   out.reserve(static_cast<size_t>(num_cpus) * 256);
   for (int i = 0; i < num_cpus; ++i) {
@@ -133,13 +165,14 @@
                      // (guest_loader_arch.cc) bit for bit, so code that cross-checks /proc/cpuinfo against getauxval agrees.
                      "Features\t: fp asimd aes pmull sha1 sha2 crc32 "
                      "atomics fphp asimdhp cpuid asimdrdm lrcpc dcpop asimddp\n"
-                     "CPU implementer\t: 0x41\n"
+                     "CPU implementer\t: %s\n"
                      "CPU architecture: 8\n"
-                     "CPU variant\t: 0x1\n"
-                     "CPU part\t: 0xd05\n"
-                     "CPU revision\t: 0\n"
+                     "CPU variant\t: %s\n"
+                     "CPU part\t: %s\n"
+                     "CPU revision\t: %s\n"
                      "\n",
-                     i);
+                     i, profile ? identity.implementer : "0x41", profile ? identity.variant : "0x1",
+                     profile ? (i >= identity.big_from ? identity.part_big : identity.part) : "0xd05", profile ? identity.revision : "0");
     if (n > 0) {
       out.append(block, static_cast<size_t>(n));
     }
diff --git a/cpu_emulation/interpreter/arm64/interpreter.h b/cpu_emulation/interpreter/arm64/interpreter.h
--- a/cpu_emulation/interpreter/arm64/interpreter.h
+++ b/cpu_emulation/interpreter/arm64/interpreter.h
@@ -30,6 +30,7 @@
 
 #include "berberis/base/bit_util.h"
 #include "berberis/base/checks.h"
+#include "berberis/base/config_globals.h"  // apklayer patch (0020)
 #include "berberis/decoder/arm64/decoder.h"
 #include "berberis/decoder/arm64/semantics_player.h"
 #include "berberis/guest_state/guest_addr.h"
@@ -558,6 +559,15 @@
         //   Implementer 0x41 ('A' = ARM Ltd)
         //   Variant 0x0, Architecture 0xF (defined by ID_AA64*_EL1)
         //   PartNum 0xD03 (Cortex-A53), Revision 0x4
+        // apklayer patch (0020): a device profile's core (berberis.cpuinfo, the same setting as /proc/cpuinfo): pixel5 = Kryo 475 Silver r13p14
+        // (implementer 0x51, variant 0xd, part 0x805, revision 14), so MIDR_EL1 agrees with the cpuinfo the guest reads.
+        {
+          static ConfigStr cpuinfo_profile("BERBERIS_CPUINFO", "berberis.cpuinfo");
+          const char* profile = cpuinfo_profile.get();
+          if (profile != nullptr && std::strcmp(profile, "pixel5") == 0) {
+            return 0x51DF805EULL;
+          }
+        }
         return 0x410FD034ULL;
       case Decoder::SystemReg::kRndr:
       case Decoder::SystemReg::kRndrrs: {
