--- /dev/null
+++ b/runtime_primitives/include/berberis/runtime_primitives/exclusive_epoch.h
@@ -0,0 +1,53 @@
+// apklayer patch (0084): exclusive-monitor epochs. LDXR/STXR are modelled as a compare-and-swap of the loaded value, which an ABA sequence defeats
+// (arm64: any store to the reserved granule by another thread clears the monitor, even of the same value): an untagged LL/SC free list loses nodes
+// (PGR's IL2CPP monitors, CHANGELOG 2026-11-22 run 11). A table of counters, indexed by address bits 4..13 (16 bytes apart), kept below 2 GB so
+// translated code can address it with a 32-bit displacement: LDXR saves its counter (before it loads the value) in the unused upper half of
+// cpu.reservation_value, STXR fails when the counter moved, a successful STXR bumps it. Stores that do not go through STXR stay invisible.
+#ifndef BERBERIS_RUNTIME_PRIMITIVES_EXCLUSIVE_EPOCH_H_
+#define BERBERIS_RUNTIME_PRIMITIVES_EXCLUSIVE_EPOCH_H_
+
+#include <sys/mman.h>
+
+#include <cstdint>
+
+namespace berberis {
+
+constexpr uintptr_t kExclEpochMask = 0x3ff0;  // byte offset of the entry (addr & mask), entries 16 bytes apart (a 4-byte counter each)
+
+inline uint32_t* ExclEpochTable() {
+  static uint32_t* table = []() -> uint32_t* {
+#ifdef MAP_32BIT
+    void* p = mmap(nullptr, kExclEpochMask + 16, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_32BIT, -1, 0);
+    if (p == MAP_FAILED || reinterpret_cast<uintptr_t>(p) + kExclEpochMask + 16 > 0x7fffffffULL) return nullptr;
+    return static_cast<uint32_t*>(p);
+#else
+    return nullptr;
+#endif
+  }();
+  return table;
+}
+inline uint32_t* ExclEpochSlot(uint64_t addr) {
+  uint32_t* t = ExclEpochTable();
+  return t ? reinterpret_cast<uint32_t*>(reinterpret_cast<uint8_t*>(t) + (addr & kExclEpochMask)) : nullptr;
+}
+// Entry layout (16 bytes): [0] 32-bit counter, [8] 64-bit lock word. A STXR checks the counter, does its compare-and-swap and bumps the counter under the lock, so no
+// other STXR to the entry is in between; LDXR reads without it (counter first, then the value).
+inline void ExclEpochLock(uint32_t* slot) {
+  uint64_t* lock = reinterpret_cast<uint64_t*>(slot + 2);
+  while (__atomic_exchange_n(lock, uint64_t{1}, __ATOMIC_ACQUIRE) != 0) {
+    while (__atomic_load_n(lock, __ATOMIC_RELAXED) != 0) __builtin_ia32_pause();
+  }
+}
+inline void ExclEpochUnlock(uint32_t* slot) { __atomic_store_n(reinterpret_cast<uint64_t*>(slot + 2), uint64_t{0}, __ATOMIC_RELEASE); }
+inline uint64_t ExclEpochLoad(uint64_t addr) {
+  uint32_t* s = ExclEpochSlot(addr);
+  return s ? __atomic_load_n(s, __ATOMIC_ACQUIRE) : 0;
+}
+inline void ExclEpochBump(uint64_t addr) {
+  uint32_t* s = ExclEpochSlot(addr);
+  if (s) __atomic_fetch_add(s, 1, __ATOMIC_RELEASE);
+}
+
+}  // namespace berberis
+
+#endif  // BERBERIS_RUNTIME_PRIMITIVES_EXCLUSIVE_EPOCH_H_
