-    if (analyzer->IsLiveIn(dst, disp)) {
+  // apklayer patch (0077): dead only if no byte it writes is read later in the block or live into a successor (it used to test
+  // the first byte, and only the reads in GET form: PGR's home scene went black in two-gear mode).
+  ContextByteAccess put = ClassifyContextAccess(analyzer->machine_ir(), *insn_it);
+  for (uint32_t b = put.begin; b < put.end; b++) {
+    if (seen_get.test(b)) {
       return ++insn_it;
     }
+    for (auto out_edge : bb->out_edges()) {
+      if (analyzer->IsLiveIn(out_edge->dst(), b)) {
+        return ++insn_it;
+      }
+    }
   }
 
   // The instruction writes to dead context.
@@ -233,9 +233,9 @@ void RemoveRedundantPut(MachineIR* ir) {
       if (ir->IsCPUStatePut(*insn_it)) {
         insn_it = RemovePutIfDead(&analyzer, bb, insn_it, seen_get);
       } else {
-        if (ir->IsCPUStateGet(*insn_it)) {
-          auto* insn = AsMachineInsnX86_64(*insn_it);
-          seen_get.set(insn->disp(), true);
+        ContextByteAccess access = ClassifyContextAccess(ir, *insn_it);  // apklayer patch (0077)
+        if (access.kind == ContextByteAccess::kGet || access.kind == ContextByteAccess::kOther) {
+          for (uint32_t b = access.begin; b < access.end; b++) seen_get.set(b, true);
         }
         insn_it++;
       }
diff --git a/cpu_emulation/backend/x86_64/machine_ir_opt_test.cc b/cpu_emulation/backend/x86_64/machine_ir_opt_test.cc
index a6ac2b7..7016f15 100644
--- a/cpu_emulation/backend/x86_64/machine_ir_opt_test.cc
+++ b/cpu_emulation/backend/x86_64/machine_ir_opt_test.cc
@@ -470,6 +470,74 @@ TEST(MachineIR, PutsInSuccessorsKillPut) {
