From: apklayer <noreply@apklayer.invalid>
Subject: [PATCH] apklayer patch: RemoveRedundantPut keeps a store that any later access reads

The heavy tier's RemoveRedundantPut and ContextLivenessAnalyzer saw only the four GET/PUT forms (MOVQ, MOVDQA, MOVW, MOVSD
off the CPU-state pointer) and tested only a slot's first byte. A read in another form or width (a 32-bit or byte access, a
compare with memory, a read starting inside the slot) did not keep the store before it, which was removed: stale guest
registers. ClassifyContextAccess gives every access its byte range; anything else addressed off the CPU-state pointer counts
as a read of up to 16 bytes. Found on PGR's home scene, black or noisy in two-gear mode only (bisected with 0079's switches:
clean with disable-heavy-opts and with the loop, local and put passes off). Tests: MachineIR.PutReadByMovlInSuccessorIsKept,
PutReadAtAnInnerByteIsKept. Module libberberis_arm64.

diff --git a/cpu_emulation/backend/include/berberis/backend/x86_64/context_liveness_analyzer.h b/cpu_emulation/backend/include/berberis/backend/x86_64/context_liveness_analyzer.h
index c5b0084..e5bda43 100644
--- a/cpu_emulation/backend/include/berberis/backend/x86_64/context_liveness_analyzer.h
+++ b/cpu_emulation/backend/include/berberis/backend/x86_64/context_liveness_analyzer.h
@@ -25,6 +25,16 @@
 
 namespace berberis::x86_64 {
 
+// apklayer patch (0077): how an instruction touches CPUState, by byte range. kGet/kPut are the forms the context optimizers move and
+// remove; kOther is any other instruction addressed off the CPUState pointer (a 32-bit or byte access, a compare with memory, a
+// reservation slot): it counts as a read of up to 16 bytes from its displacement, so a PUT it reads is never removed as dead.
+struct ContextByteAccess {
+  enum Kind : uint8_t { kNone, kGet, kPut, kOther } kind;
+  uint32_t begin;
+  uint32_t end;
+};
+ContextByteAccess ClassifyContextAccess(const MachineIR* ir, const berberis::MachineInsn* insn);
+
 class ContextLivenessAnalyzer {
  public:
   explicit ContextLivenessAnalyzer(const MachineIR* ir)
@@ -32,6 +42,7 @@ class ContextLivenessAnalyzer {
 
   void Init();
   bool IsLiveIn(const MachineBasicBlock* bb, uint32_t offset) const;
+  const MachineIR* machine_ir() const { return machine_ir_; }
 
  private:
   using ContextLiveness = std::bitset<sizeof(CPUState)>;
diff --git a/cpu_emulation/backend/x86_64/context_liveness_analyzer.cc b/cpu_emulation/backend/x86_64/context_liveness_analyzer.cc
index ff334b7..66f5251 100644
--- a/cpu_emulation/backend/x86_64/context_liveness_analyzer.cc
+++ b/cpu_emulation/backend/x86_64/context_liveness_analyzer.cc
@@ -47,6 +47,38 @@ bool ContextLivenessAnalyzer::IsLiveIn(const MachineBasicBlock* bb, uint32_t off
   return context_live_in_[bb->id()].test(offset);
 }
 
+ContextByteAccess ClassifyContextAccess(const MachineIR* ir, const berberis::MachineInsn* insn) {
+  constexpr uint32_t kSize = sizeof(CPUState);
+  auto range = [&](ContextByteAccess::Kind kind, uint32_t disp, uint32_t width) {
+    return ContextByteAccess{kind, disp, disp + width < kSize ? disp + width : kSize};
+  };
+  if (ir->IsCPUStatePut(insn)) {
+    uint32_t disp = AsMachineInsnX86_64(insn)->disp();
+    switch (insn->opcode()) {
+      case kMachineOpMovdqaMemBaseDispXReg: return range(ContextByteAccess::kPut, disp, 16);
+      case kMachineOpMovwMemBaseDispReg: return range(ContextByteAccess::kPut, disp, 2);
+      default: return range(ContextByteAccess::kPut, disp, 8);  // MOVQ (reg, imm), MOVSD
+    }
+  }
+  if (ir->IsCPUStateGet(insn)) {
+    uint32_t disp = AsMachineInsnX86_64(insn)->disp();
+    switch (insn->opcode()) {
+      case kMachineOpMovdqaXRegMemBaseDisp: return range(ContextByteAccess::kGet, disp, 16);
+      case kMachineOpMovwRegMemBaseDisp: return range(ContextByteAccess::kGet, disp, 2);
+      default: return range(ContextByteAccess::kGet, disp, 8);  // MOVQ, MOVSD
+    }
+  }
+  if (insn->opcode() <= kMachineOpJump) return ContextByteAccess{ContextByteAccess::kNone, 0, 0};  // pseudo instructions
+  for (int i = 0; i < insn->NumRegOperands(); i++) {
+    if (insn->RegAt(i) == kCPUStatePointer) {
+      uint32_t disp = AsMachineInsnX86_64(insn)->disp();
+      if (disp >= kSize) break;  // ThreadState outside CPUState
+      return range(ContextByteAccess::kOther, disp, 16);
+    }
+  }
+  return ContextByteAccess{ContextByteAccess::kNone, 0, 0};
+}
+
 bool ContextLivenessAnalyzer::VisitBasicBlock(const MachineBasicBlock* bb) {
   ContextLiveness running_liveness;
   if (bb->out_edges().size() == 0) {
@@ -57,13 +89,13 @@ bool ContextLivenessAnalyzer::VisitBasicBlock(const MachineBasicBlock* bb) {
     }
   }
 
+  // apklayer patch (0077): by byte range; any other CPUState access is a read (ClassifyContextAccess).
   for (auto insn_it = bb->insn_list().rbegin(); insn_it != bb->insn_list().rend(); insn_it++) {
-    if (machine_ir_->IsCPUStatePut(*insn_it)) {
-      auto* insn = AsMachineInsnX86_64(*insn_it);
-      running_liveness.reset(insn->disp());
-    } else if (machine_ir_->IsCPUStateGet(*insn_it)) {
-      auto* insn = AsMachineInsnX86_64(*insn_it);
-      running_liveness.set(insn->disp());
+    ContextByteAccess access = ClassifyContextAccess(machine_ir_, *insn_it);
+    if (access.kind == ContextByteAccess::kPut) {
+      for (uint32_t b = access.begin; b < access.end; b++) running_liveness.reset(b);
+    } else if (access.kind == ContextByteAccess::kGet || access.kind == ContextByteAccess::kOther) {
+      for (uint32_t b = access.begin; b < access.end; b++) running_liveness.set(b);
     }
   }
 
