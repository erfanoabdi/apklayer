From: wesley van neck
Subject: [PATCH] apklayer: berberis.large_mmap, the translator's 16 GB buffer reserved or absent

The translator's large-allocation buffer (InitLargeMmap: 16 GB MAP_NORESERVE, rw-p) is an unnamed rw-p pair of 8 GB + 5.8 GB in the
guest's /proc/self/maps (PGR on an x86_64 PC); no device process has it. berberis.large_mmap (BERBERIS_LARGE_MMAP) = "reserve" maps it
PROT_NONE (---p, like ART's reservations; LargeMmapImplOrDie maps every piece MAP_FIXED with its own protections), "off" makes no buffer
(allocations go to mmap directly), "hide" reserves it and leaves every maps line inside it (the GuestMapShadow's 8 GB rw-p, code cache
pieces, the reserved rest) out of the guest's /proc/self/maps. Default unchanged. Module libberberis_arm64.

--- a/base/include/berberis/base/large_mmap.h
+++ b/base/include/berberis/base/large_mmap.h
@@ -17,6 +17,8 @@
 #ifndef BERBERIS_BASE_LARGE_MMAP_H_
 #define BERBERIS_BASE_LARGE_MMAP_H_
 
+#include <cstdint>
+
 #include "berberis/base/mmap.h"
 
 namespace berberis {
@@ -26,6 +28,10 @@
 void* LargeMmapOrDie(size_t size);
 void* LargeMmapImplOrDie(MmapImplArgs args);
 
+// apklayer patch (0062): with berberis.large_mmap=hide, whether [start, end) lies inside the translator's buffer (left out of the
+// guest's /proc/self/maps: only translator memory is ever placed there).
+bool IsInHiddenLargeMmap(uintptr_t start, uintptr_t end);
+
 }  // namespace berberis
 
 #endif  // BERBERIS_BASE_LARGE_MMAP_H_
--- a/base/large_mmap.cc
+++ b/base/large_mmap.cc
@@ -20,6 +20,10 @@
 
 #include "berberis/base/mmap.h"
 
+#include <string.h>
+
+#include "berberis/base/config_globals.h"
+
 namespace berberis {
 
 #if defined(__LP64__)
@@ -52,6 +56,7 @@
 // ATTENTION: buffer allocation is not atomic! To make it atomic, use PointerAndCounter!
 std::atomic<uint8_t*> g_buffer = nullptr;
 uint8_t* g_buffer_end = nullptr;
+uintptr_t g_hidden_start = 0, g_hidden_end = 0;  // apklayer patch (0062): berberis.large_mmap=hide
 
 }  // namespace
 
@@ -60,12 +65,32 @@
   constexpr size_t kSpacingSize = size_t(1) << 35;  // 32gb
 
   // As explained above we expect mmap to work top-to-down, so spacing is at the higher addresses.
+  // apklayer patch (0062): berberis.large_mmap (BERBERIS_LARGE_MMAP). The buffer is 16 GB of unnamed rw-p in the guest's
+  // /proc/self/maps (PGR's 8 GB + 5.8 GB pair), which no device process has. "reserve" maps it PROT_NONE (---p, as ART's
+  // reservations on a device; every piece is mapped MAP_FIXED with its own protections), "off" makes no buffer (allocations
+  // go to mmap directly). Default: upstream's rw-p buffer.
+  static const ConfigStr large_mmap("BERBERIS_LARGE_MMAP", "berberis.large_mmap");
+  const char* mode = large_mmap.get();
+  if (mode != nullptr && strcmp(mode, "off") == 0) {
+    return;
+  }
+  // "hide": reserved as "reserve", and the whole buffer is left out of the guest's maps (IsInHiddenLargeMmap).
+  bool hide = mode != nullptr && strcmp(mode, "hide") == 0;
+  int prot = (hide || (mode != nullptr && strcmp(mode, "reserve") == 0)) ? PROT_NONE : PROT_READ | PROT_WRITE;
   auto* ptr = static_cast<uint8_t*>(MmapImplOrDie(
-      {.size = kBufferSize + kSpacingSize, .flags = MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE}));
+      {.size = kBufferSize + kSpacingSize, .prot = prot, .flags = MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE}));
   MunmapOrDie(ptr + kBufferSize, kSpacingSize);
 
   g_buffer.store(ptr);
   g_buffer_end = ptr + kBufferSize;
+  if (hide) {
+    g_hidden_start = reinterpret_cast<uintptr_t>(ptr);
+    g_hidden_end = reinterpret_cast<uintptr_t>(g_buffer_end);
+  }
+}
+
+bool IsInHiddenLargeMmap(uintptr_t start, uintptr_t end) {
+  return g_hidden_end != 0 && start >= g_hidden_start && end <= g_hidden_end;
 }
 
 void* LargeMmapImplOrDie(MmapImplArgs args) {
@@ -96,6 +121,10 @@
 
 void InitLargeMmap() {}
 
+bool IsInHiddenLargeMmap(uintptr_t, uintptr_t) {
+  return false;
+}
+
 void* LargeMmapImplOrDie(MmapImplArgs args) {
   return MmapImplOrDie(args);
 }
--- a/kernel_api/open_emulation.cc
+++ b/kernel_api/open_emulation.cc
@@ -44,6 +44,7 @@
 #include "berberis/base/checks.h"
 #include "berberis/base/fd.h"
 #include "berberis/base/forever_alloc.h"
+#include "berberis/base/large_mmap.h"  // apklayer patch (0062)
 #include "berberis/base/scoped_errno.h"  // apklayer patch (0014)
 #include "berberis/base/tracing.h"
 #include "berberis/guest_os_primitives/guest_map_shadow.h"
@@ -388,6 +389,10 @@
       guest_maps.append(cur_line + "\n");
       continue;
     }
+    // apklayer patch (0062): berberis.large_mmap=hide: the translator's buffer (its map shadow, code cache, the reserved rest) is not listed
+    if (IsInHiddenLargeMmap(start, end)) {
+      continue;
+    }
     // apklayer patch (0051): berberis.maps_view=arm64 (BERBERIS_MAPS_VIEW): no x86_64-only lines in the served maps: [vsyscall] (x86_64's
     // fixed page at ffffffffff600000) and [vvar_vclock] (arm64 shows [vvar] and [vdso] only). Default off.
