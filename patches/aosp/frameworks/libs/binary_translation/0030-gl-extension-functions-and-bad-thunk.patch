 namespace berberis {
 
-void DoBadThunk() {
-  LOG_ALWAYS_FATAL("Bad thunk call before %p", __builtin_return_address(0));
+// apklayer patch: a known function whose host library lacks it (Mesa has no glCopyTextureCHROMIUM and the like) used to abort the process here: Fennec's GPU
+// process died ("Bad thunk call"), the parent's main thread then waited for ever for a sync IPC reply. Log and answer 0 (NULL/false/no error), as the guest
+// would get from a driver without the function; the name is logged where the thunk is chosen (InterceptSymbol).
+uint64_t DoBadThunk() {
+  ALOGE("berberis: call of a function the host library lacks, before %p: returning 0", __builtin_return_address(0));
+  return 0;
 }
 
+namespace {
+
+extern "C" uint64_t BerberisHostLessFunctionCalled(const char* name) {
+  ALOGE("berberis: call of %s, which the host library lacks: returning 0", name);
+  return 0;
+}
+
+// A thunk of its own per name: `mov rdi, name; mov rax, BerberisHostLessFunctionCalled; jmp rax`, so the log says which function was called (the guest's
+// arguments are not needed for answering 0). x86_64 hosts only; elsewhere DoBadThunk.
+// The host's libGLESv2.so exports only the core entry points; extension functions (EXT, OES, KHR, ANGLE...) the driver supports are reached through
+// eglGetProcAddress only. The guest's libGLESv2 proxy knows them by name (Android's library exports them), so resolve those through the host's libEGL too.
+void* HostGlFunction(const char* library_name, const char* name) {
+  if (strncmp(library_name, "libGLES", 7) != 0) {
+    return nullptr;
+  }
+  using GetProc = void* (*)(const char*);
+  static const GetProc get_proc = [] {
+    void* egl = dlopen("libEGL.so", RTLD_NOW | RTLD_GLOBAL);
+    return egl ? reinterpret_cast<GetProc>(dlsym(egl, "eglGetProcAddress")) : nullptr;
+  }();
+  return get_proc ? get_proc(name) : nullptr;
+}
+
+void* NamedBadThunk(const char* library_name, const char* name) {
+#if defined(__x86_64__)
+  static std::mutex mutex;
+  static uint8_t* page = nullptr;
+  static size_t used = 0;
+  constexpr size_t kPage = 1 << 16, kStub = 32;
+  std::lock_guard<std::mutex> lock(mutex);
+  if (page == nullptr || used + kStub > kPage) {
+    void* mem = mmap(nullptr, kPage, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (mem == MAP_FAILED) {
+      return reinterpret_cast<void*>(DoBadThunk);
+    }
+    page = static_cast<uint8_t*>(mem);
+    used = 0;
+  }
+  char* text = nullptr;
+  if (asprintf(&text, "%s %s", library_name, name) < 0) {
+    return reinterpret_cast<void*>(DoBadThunk);
+  }
+  uint8_t* code = page + used;
+  used += kStub;
+  auto fn = reinterpret_cast<uintptr_t>(&BerberisHostLessFunctionCalled);
+  code[0] = 0x48; code[1] = 0xBF;  // mov rdi, imm64
+  memcpy(code + 2, &text, 8);
+  code[10] = 0x48; code[11] = 0xB8;  // mov rax, imm64
+  memcpy(code + 12, &fn, 8);
+  code[20] = 0xFF; code[21] = 0xE0;  // jmp rax
+  return code;
+#else
+  (void)library_name;
+  (void)name;
+  return reinterpret_cast<void*>(DoBadThunk);
+#endif
+}
+
+}  // namespace
