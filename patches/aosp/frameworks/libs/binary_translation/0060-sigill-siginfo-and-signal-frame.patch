+#if defined(NATIVE_BRIDGE_GUEST_ARCH_ARM64)
+  // apklayer patch (0060), knob berberis.sigframe (env BERBERIS_SIGFRAME) = "kernel": the frame of a SIGSEGV/SIGBUS fault carries fault_address
+  // and an esr_context, as the kernel's: EC 0x24 (data abort) or 0x20 (instruction abort: the address is the pc), WnR from the load/store
+  // instruction's L bit, DFSC translation (MAPERR), permission (ACCERR) or alignment. A SIGILL or SIGTRAP frame has none.
+  static const bool kernel_frame = [] {
+    ConfigStr knob("BERBERIS_SIGFRAME", "berberis.sigframe");
+    return knob.get() != nullptr && knob.get()[0] == 'k';
+  }();
+  uint64_t fault_address = 0;
+  uint32_t esr = 0;
+  if (kernel_frame && (info->si_signo == SIGSEGV || info->si_signo == SIGBUS) && info->si_code > 0) {
+    fault_address = reinterpret_cast<uint64_t>(info->si_addr);
+    uint64_t pc = GetInsnAddr(GetCPUState(*state));
+    bool exec = fault_address == pc || (info->si_signo == SIGBUS && (pc & 3) != 0);
+    uint32_t insn = 0;
+    if (!exec) memcpy(&insn, ToHostAddr<const void>(pc), sizeof(insn));
+    bool load_store = (insn & 0x0a000000) == 0x08000000;
+    uint32_t wnr = load_store && !((insn >> 22) & 1) ? 0x40 : 0;
+    uint32_t dfsc = info->si_signo == SIGBUS ? 0x21 : info->si_code == SEGV_ACCERR ? 0x0f : (fault_address < 0x100000 ? 0x06 : 0x07);
+    esr = exec ? ((info->si_signo == SIGBUS ? 0x8a000000u : 0x82000000u) | (dfsc & 0x3f)) : (0x92000000u | wnr | dfsc);
+  }
+  ctx.Save(&state->cpu, fault_address, esr, kernel_frame);
+#else
   ctx.Save(&state->cpu);
+#endif
 
