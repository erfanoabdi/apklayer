+  constexpr int kSyntheticSigillErrno = 0x41504b;  // "APK"
   auto* addr = ToHostAddr<const uint32_t>(pc);
   // ARM64 instructions are always 4 bytes.
   uint32_t code;
   memcpy(&code, addr, sizeof(code));
   TRACE_AND_ALOGE("Undefined arm64 instruction 0x%" PRIx32 " at %p", code, addr);
-#ifdef __GLIBC__
-  // Our old 2.17 glibc has a bug resulting in raise() failing after any CLONE_VM.
-  // Work around by calling tgkill directly.
+  // apklayer patch (0060): knob berberis.sigill_code (env BERBERIS_SIGILL_CODE) = "kernel": the architectural siginfo of an undefined
+  // instruction (ILL_ILLOPC, si_addr = the instruction), not tgkill's SI_TKILL with the sender's pid/uid in the union; a guest SIGILL
+  // handler (an anti-emulation probe: udf, an unallocated encoding, a privileged mrs) reads si_code. Sending kernel-style siginfo to
+  // oneself is permitted.
+  static const bool kernel_siginfo = [] {
+    ConfigStr knob("BERBERIS_SIGILL_CODE", "berberis.sigill_code");
+    return knob.get() != nullptr && knob.get()[0] == 'k';
+  }();
   pid_t pid = syscall(__NR_getpid);
   pid_t tid = syscall(__NR_gettid);
-  syscall(SYS_tgkill, pid, tid, SIGILL);
-#else
-  raise(SIGILL);
-#endif
+  if (!kernel_siginfo) {
+    // Our old 2.17 glibc has a bug resulting in raise() failing after any CLONE_VM. Work around by calling tgkill directly.
+    syscall(SYS_tgkill, pid, tid, SIGILL);
+    return;
+  }
+  siginfo_t info{};
+  info.si_signo = SIGILL;
+  info.si_code = ILL_ILLOPC;
+  info.si_errno = kSyntheticSigillErrno;  // marks it as the translator's own (HandleHostSignal: not a host fault); reset before the guest sees it
+  info.si_addr = ToHostAddr<void>(pc);
+  CHECK_EQ(syscall(__NR_rt_tgsigqueueinfo, pid, tid, SIGILL, &info), 0);
 }
 
