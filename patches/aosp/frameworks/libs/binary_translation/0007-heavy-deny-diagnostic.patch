From: Erfan Abdi <erfangplus@gmail.com>
Subject: [PATCH] apklayer: BERBERIS_HEAVY_DENY keeps ARM64 instruction groups out of the heavy optimizer (diagnostic)

PGR (Unity, arm64 on an x86_64 PC) draws its 3D home scene as block noise in the default two-gear mode and cleanly with
BERBERIS_MODE=lite-translate-or-interpret: the heavy tier miscompiles something. BERBERIS_HEAVY_DENY="simd,fp,ldst,simdldst,dpreg,dpimm,branch"
(any subset) makes a region with an instruction of those encoding groups bail as an unimplemented one does, so it stays lite: a
bisection of the group at run time, no rebuild per step. Without the variable nothing changes.

diff --git a/cpu_emulation/heavy_optimizer/arm64/heavy_optimize_region.cc b/cpu_emulation/heavy_optimizer/arm64/heavy_optimize_region.cc
index eff0b753..38a39431 100644
--- a/cpu_emulation/heavy_optimizer/arm64/heavy_optimize_region.cc
+++ b/cpu_emulation/heavy_optimizer/arm64/heavy_optimize_region.cc
@@ -18,6 +18,8 @@
 
 #include <cstddef>
 #include <cstdint>
+#include <cstdlib>
+#include <cstring>
 #include <tuple>
 
 #include "berberis/assembler/machine_code.h"
@@ -34,6 +36,49 @@
 
 namespace berberis {
 
+namespace {
+
+// apklayer patch (diagnostic): BERBERIS_HEAVY_DENY="simd,fp,ldst,simdldst,dpreg,dpimm,branch" (any subset, comma separated) keeps
+// regions with an instruction of those ARM64 encoding groups (op0, bits 28:25) out of the heavy optimizer: they bail as an
+// unimplemented instruction does and stay lite-translated. To find which group the heavy tier miscompiles (PGR's home scene: block
+// noise in two-gear mode, clean with BERBERIS_MODE=lite-translate-or-interpret).
+enum : unsigned {
+  kDenySimd = 1, kDenyFp = 2, kDenyLdst = 4, kDenySimdLdst = 8, kDenyDpReg = 16, kDenyDpImm = 32, kDenyBranch = 64,
+};
+
+unsigned HeavyDenyMask() {
+  static const unsigned mask = [] {
+    const char* env = getenv("BERBERIS_HEAVY_DENY");
+    unsigned m = 0;
+    if (env == nullptr) return m;
+    struct { const char* name; unsigned bit; } names[] = {{"simd", kDenySimd}, {"fp", kDenyFp}, {"ldst", kDenyLdst},
+        {"simdldst", kDenySimdLdst}, {"dpreg", kDenyDpReg}, {"dpimm", kDenyDpImm}, {"branch", kDenyBranch}};
+    const char* p = env;
+    while (*p) {
+      size_t len = strcspn(p, ",");
+      for (auto& n : names)
+        if (strlen(n.name) == len && strncmp(n.name, p, len) == 0) m |= n.bit;
+      p += len;
+      if (*p == ',') p++;
+    }
+    return m;
+  }();
+  return mask;
+}
+
+unsigned InsnGroup(uint32_t insn) {
+  uint32_t op0 = (insn >> 25) & 0xf;
+  if (op0 == 0x7) return kDenySimd;            // 0111: Advanced SIMD (vector)
+  if (op0 == 0xf) return kDenyFp;              // 1111: scalar FP and scalar SIMD
+  if ((op0 & 0x5) == 0x4) return (insn & (1u << 26)) ? kDenySimdLdst : kDenyLdst;  // x1x0: loads/stores (bit 26: SIMD&FP registers)
+  if ((op0 & 0x7) == 0x5) return kDenyDpReg;   // x101: data processing, register
+  if ((op0 & 0xe) == 0x8) return kDenyDpImm;   // 100x: data processing, immediate
+  if ((op0 & 0xe) == 0xa) return kDenyBranch;  // 101x: branches, exceptions, system
+  return 0;
+}
+
+}  // namespace
+
 // Optimizing (second-gear) translation of the ARM64 region at `pc`. Drives the
 // ARM64 decoder through the SemanticsPlayer into the HeavyOptimizerFrontend,
 // then lowers the resulting x86_64 MachineIR with x86_64::GenCode. Mirrors
@@ -56,6 +101,11 @@ std::tuple<GuestAddr, bool, size_t> HeavyOptimizeRegion(GuestAddr pc,
   while (number_of_instructions != params.max_number_of_instructions &&
          frontend.GetInsnAddr() < params.end_pc && !frontend.IsRegionEndReached()) {
     frontend.StartInsn();
+    if (unsigned deny = HeavyDenyMask();
+        deny != 0 && (InsnGroup(*ToHostAddr<const uint32_t>(frontend.GetInsnAddr())) & deny) != 0) {
+      frontend.Undefined(BailReason::kOther);  // apklayer patch: BERBERIS_HEAVY_DENY
+      break;
+    }
     auto size = decoder.Decode(ToHostAddr<const uint16_t>(frontend.GetInsnAddr()));
     if (!frontend.success()) {
       // Do not increment the insn counter if we could not generate the instruction.
