 constexpr size_t kKeptExitedRecords = 512;
+constexpr size_t kRecordSlotBits = 14;  // 16384 slots: the live threads' records and the kept ones; a full table registers nothing
+constexpr size_t kRecordSlots = size_t{1} << kRecordSlotBits;
