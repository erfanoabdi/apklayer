+ExitedRecords g_exited_records;
+ExitedRecords* GetExitedRecords() { return &g_exited_records; }
+
+size_t RecordHash(const void* record) {
+  return static_cast<size_t>((reinterpret_cast<uintptr_t>(record) >> 12) * 0x9E3779B97F4A7C15ull >> (64 - kRecordSlotBits));
+}
+
+// All of these with `kept->mutex` held.
+RecordSlot* FindRecordLocked(ExitedRecords* kept, const void* record) {
+  for (size_t i = RecordHash(record), n = 0; n < kRecordSlots; i = (i + 1) & (kRecordSlots - 1), n++) {
+    if (kept->slots[i].record == record) return &kept->slots[i];
+    if (kept->slots[i].record == nullptr) return nullptr;
+  }
+  return nullptr;
+}
+
+void PutRecordLocked(ExitedRecords* kept, const void* record, pthread_t host) {
+  for (size_t i = RecordHash(record), n = 0; n < kRecordSlots; i = (i + 1) & (kRecordSlots - 1), n++) {
+    if (kept->slots[i].record == record || kept->slots[i].record == nullptr) {
+      kept->slots[i] = {record, host};
+      return;
+    }
+  }
+}
+
+void EraseRecordLocked(ExitedRecords* kept, const void* record) {
+  RecordSlot* found = FindRecordLocked(kept, record);
+  if (found == nullptr) return;
+  size_t i = found - kept->slots;
+  for (size_t j = i;;) {
+    j = (j + 1) & (kRecordSlots - 1);
+    if (kept->slots[j].record == nullptr) break;
+    size_t k = RecordHash(kept->slots[j].record);
+    // the entry at j stays when its home k lies cyclically in (i, j]; otherwise it moves into the hole at i
+    if (i <= j ? (i < k && k <= j) : (i < k || k <= j)) continue;
+    kept->slots[i] = kept->slots[j];
+    i = j;
+  }
+  kept->slots[i].record = nullptr;
 }
