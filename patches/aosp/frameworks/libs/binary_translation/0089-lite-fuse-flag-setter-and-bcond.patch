--- a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translate_region_exec_tests.cc
+++ b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translate_region_exec_tests.cc
@@ -4276,6 +4276,97 @@
   }
 }
 
+// apklayer patch (0089): a flag-setting instruction followed by B.cond branches on the live x86 flags and stores NZCV on both paths. Every
+// flag setter x every condition x edge operands, JIT vs interpreter: where the branch goes, the NZCV left behind and the setter's result;
+// also the setter followed by a CSEL (the store must reach memory first) and a setter that ends the region.
+TEST_F(Arm64LiteTranslateRegionTest, FlagSetterBranchDifferential) {
+  struct Setter { const char* name; uint32_t insn; };
+  const Setter setters[] = {
+      {"subs x2,x0,x1", 0xEB010002}, {"cmp x0,x1", 0xEB01001F}, {"subs w2,w0,w1", 0x6B010002}, {"cmp w0,w1", 0x6B01001F},
+      {"adds x2,x0,x1", 0xAB010002}, {"cmn x0,x1", 0xAB01001F}, {"adds w2,w0,w1", 0x2B010002}, {"cmn w0,w1", 0x2B01001F},
+      {"ands x2,x0,x1", 0xEA010002}, {"tst x0,x1", 0xEA01001F}, {"ands w2,w0,w1", 0x6A010002}, {"tst w0,w1", 0x6A01001F},
+      {"cmp x0,#5", 0xF100141F},     {"cmp w0,#5", 0x7100141F}, {"adds x2,x0,#5", 0xB1001402}, {"tst x0,#1", 0xF240001F},
+      {"cmp x0,w1,uxtw", 0xEB21401F}, {"subs x2,x0,x1,lsl #3", 0xEB010C02}, {"adds x2,x0,w1,sxtw", 0xAB21C002},
+  };
+  const uint64_t vals[] = {0,          1,          2,           5,           0x7fffffffULL, 0x80000000ULL,
+                           0xffffffffULL, 0x100000000ULL, 0x7fffffffffffffffULL, 0x8000000000000000ULL, ~0ULL};
+  constexpr uint16_t kMask = 0xC101;  // N Z C V
+  auto run = [&](const uint32_t* code, uint64_t x0, uint64_t x1, uint16_t flags0) {
+    GuestAddr start = ToGuestAddr(code);
+    for (int i = 0; i < 31; i++) state_.cpu.x[i] = 0;
+    state_.cpu.x[0] = x0;
+    state_.cpu.x[1] = x1;
+    state_.cpu.x[4] = 0x1111;
+    state_.cpu.x[5] = 0x2222;
+    state_.cpu.flags = flags0;
+    state_.cpu.insn_addr = start;
+    return start;
+  };
+  uint32_t code[3];
+  uint64_t taken = 0, not_taken = 0, flagged = 0, results = 0;
+  for (const Setter& st : setters) {
+    for (uint32_t cond = 0; cond < 14; cond++) {
+      // [setter; b.cond +8; (fall-through end)] -> stops at +8, taken at +12.
+      code[0] = st.insn;
+      code[1] = 0x54000000u | (2u << 5) | cond;
+      code[2] = 0xd503201f;  // nop
+      GuestAddr start = ToGuestAddr(&code[0]);
+      MachineCode mc;
+      auto [ok, stop] = TryLiteTranslateRegion(start, &mc, LiteTranslateParams{.end_pc = start + 8, .allow_dispatch = false});
+      ASSERT_TRUE(ok) << st.name;
+      HostCodeAddr hc = GetDefaultCodePoolInstance()->Add(&mc);
+      for (uint64_t x0 : vals) {
+        for (uint64_t x1 : vals) {
+          run(code, x0, x1, 0);
+          TestingRunGeneratedCode(&state_, AsHostCode(hc), start);
+          uint64_t j_off = state_.cpu.insn_addr - start;
+          uint16_t j_flags = state_.cpu.flags & kMask;
+          uint64_t j_x2 = state_.cpu.x[2];
+          run(code, x0, x1, 0);
+          for (int k = 0; k < 2; k++) InterpretInsn(&state_);
+          (j_off == 12 ? taken : not_taken)++;
+          flagged += j_flags != 0;
+          results += j_x2 != 0;
+          EXPECT_EQ(j_off, state_.cpu.insn_addr - start) << st.name << " cond=" << cond << std::hex << " x0=" << x0 << " x1=" << x1;
+          EXPECT_EQ(j_flags, state_.cpu.flags & kMask) << st.name << " cond=" << cond << std::hex << " x0=" << x0 << " x1=" << x1;
+          EXPECT_EQ(j_x2, state_.cpu.x[2]) << st.name << " cond=" << cond << std::hex << " x0=" << x0 << " x1=" << x1;
+        }
+      }
+    }
+  }
+  EXPECT_GT(taken, 5000u);
+  EXPECT_GT(not_taken, 5000u);
+  EXPECT_GT(flagged, 5000u);
+  EXPECT_GT(results, 1000u);
+  // setter then CSEL x3, x4, x5, cond (reads the stored flags), and a setter that ends the region.
+  for (const Setter& st : setters) {
+    for (uint32_t cond = 0; cond < 14; cond++) {
+      code[0] = st.insn;
+      code[1] = 0x9a850083u | (cond << 12);  // csel x3, x4, x5, cond
+      GuestAddr start = ToGuestAddr(&code[0]);
+      for (size_t n : {size_t{1}, size_t{2}}) {
+        MachineCode mc;
+        auto [ok, stop] = TryLiteTranslateRegion(start, &mc, LiteTranslateParams{.end_pc = start + 4 * n, .allow_dispatch = false});
+        ASSERT_TRUE(ok) << st.name;
+        HostCodeAddr hc = GetDefaultCodePoolInstance()->Add(&mc);
+        for (uint64_t x0 : vals) {
+          for (uint64_t x1 : {uint64_t{0}, uint64_t{5}, ~uint64_t{0}, uint64_t{0x80000000}}) {
+            run(code, x0, x1, 0);
+            TestingRunGeneratedCode(&state_, AsHostCode(hc), start);
+            uint16_t j_flags = state_.cpu.flags & kMask;
+            uint64_t j_x3 = state_.cpu.x[3], j_x2 = state_.cpu.x[2];
+            run(code, x0, x1, 0);
+            for (size_t k = 0; k < n; k++) InterpretInsn(&state_);
+            EXPECT_EQ(j_flags, state_.cpu.flags & kMask) << st.name << " n=" << n << " cond=" << cond << std::hex << " x0=" << x0 << " x1=" << x1;
+            EXPECT_EQ(j_x3, state_.cpu.x[3]) << st.name << " n=" << n << " cond=" << cond;
+            EXPECT_EQ(j_x2, state_.cpu.x[2]) << st.name << " n=" << n << " cond=" << cond;
+          }
+        }
+      }
+    }
+  }
+}
