From: apklayer
Subject: [PATCH] lite tier: a flag-setting instruction followed by B.cond branches on the live x86 flags (0089)

ADDS/SUBS/CMP/CMN/ANDS/TST (imm, shifted, extended) defer their NZCV store (DeferStoreArmNZCV); the region driver stores it before any
instruction that is not B.cond (FlushPendingNzcvAtInsn) and at the end of the region; B.cond captures NZCV with LAHF/SETO (EFLAGS kept),
jumps on the x86 condition and stores NZCV on both paths. HI/LS after ADDS/ANDS use the old path. Test: FlagSetterBranchDifferential
(19 setters x 14 conditions x 121 operands, JIT vs interpreter; plus setter + CSEL and a setter that ends the region). Module libberberis_arm64.

--- a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator.h
+++ b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator.h
@@ -227,6 +227,7 @@
   [[nodiscard]] Assembler* as() { return &as_; }
   [[nodiscard]] bool success() const { return success_; }
   bool is_region_end_reached() const { return is_region_end_reached_; }
+  void FlushPendingNzcvAtInsn(uint32_t next_insn) { FlushPendingNzcv(next_insn); }  // apklayer patch (0089): for the region driver
 
   void FreeTempRegs() {
     gp_allocator_.FreeTemps();
@@ -520,9 +521,13 @@
   // use AL for overflow (avoids clobbering rcx in allocator pool).
   // LAHF stores SF|ZF|CF to AH (bits 8-15). SETCC OF stores to AL (bits 0-7).
   // AND kFlagsNZCVMask keeps N(bit15), Z(bit14), C(bit8), V(bit0). No rcx save/restore needed.
-  void EmitStoreArmNZCV(bool is_sub) {
+  // apklayer patch (0089): the NZCV store is split in two so that a flag-setting instruction followed by B.cond can branch on the live x86
+  // flags (no store, reload and bt through memory): EmitCaptureNZCV reads them (LAHF and SETO keep EFLAGS), EmitFinishNZCV masks and stores.
+  void EmitCaptureNZCV() {
     as_.Lahf();
     as_.Setcc(Condition::kOverflow, Assembler::rax);
+  }
+  void EmitFinishNZCV(bool is_sub) {
     as_.Andl(Assembler::rax, static_cast<int32_t>(kFlagsNZCVMask));
     if (is_sub) {
       as_.Xorl(Assembler::rax, static_cast<int32_t>(CPUState::kFlagCarry));  // invert ARM borrow
@@ -530,6 +535,26 @@
     int32_t flags_offset = offsetof(ThreadState, cpu.flags);
     as_.Movw({.base = Assembler::rbp, .disp = flags_offset}, Assembler::rax);
   }
+  void EmitStoreArmNZCV(bool is_sub) {
+    EmitCaptureNZCV();
+    EmitFinishNZCV(is_sub);
+  }
+
+  // Flag-setting integer instructions (ADDS/SUBS/CMP/CMN/ANDS/TST) call this instead of EmitStoreArmNZCV: the store waits in pending_nzcv_
+  // while EFLAGS stay live, until the driver (FlushPendingNzcv, before the next instruction) or BranchCond resolves it. Only emitted code
+  // that keeps EFLAGS (MOVs of the destination write) may sit between the instruction and the resolution.
+  void DeferStoreArmNZCV(bool is_sub) {
+    pending_nzcv_.valid = true;
+    pending_nzcv_.is_sub = is_sub;
+  }
+  // Called by the region driver before each instruction (next_insn: its word) and once at the end of the region (0): stores a pending NZCV
+  // unless the next instruction is B.cond, which resolves it itself.
+  void FlushPendingNzcv(uint32_t next_insn) {
+    if (!pending_nzcv_.valid) return;
+    if ((next_insn & 0xff000010u) == 0x54000000u) return;  // B.cond
+    pending_nzcv_.valid = false;
+    EmitStoreArmNZCV(pending_nzcv_.is_sub);
+  }
 
   // Emit a jump to `not_met` when the ARM64 condition `cond` is NOT satisfied
   // by the current NZCV in ThreadState.cpu.flags. Shared by every flag
@@ -738,6 +763,11 @@
   Assembler::Label* loop_head_ = nullptr;
   bool mapped_after_loop_head_ = false;
   bool saw_self_back_edge_ = false;
+  // A deferred NZCV store (DeferStoreArmNZCV): EFLAGS hold the flags of the last instruction.
+  struct PendingNzcv {
+    bool valid = false;
+    bool is_sub = false;
+  } pending_nzcv_;
 };
 
 }  // namespace berberis
--- a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator.cc
+++ b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator.cc
@@ -229,7 +229,43 @@
 
   // Jump over the branch-taken path (to cont) when the condition is not
   // satisfied. EmitJumpIfCondNotMet tests cpu.flags in memory directly.
-  EmitJumpIfCondNotMet(cond, *cont);
+  // apklayer patch (0089): right after a flag-setting instruction the x86 flags are live: branch on them, and store NZCV on both paths.
+  bool fused = false;
+  bool fused_is_sub = false;
+  if (pending_nzcv_.valid) {
+    fused_is_sub = pending_nzcv_.is_sub;
+    pending_nzcv_.valid = false;
+    Condition not_met = Condition::kInvalidCondition;
+    switch (cond) {
+      case Decoder::Condition::kEq: not_met = Condition::kNotEqual; break;
+      case Decoder::Condition::kNe: not_met = Condition::kEqual; break;
+      case Decoder::Condition::kCs: not_met = fused_is_sub ? Condition::kBelow : Condition::kAboveEqual; break;
+      case Decoder::Condition::kCc: not_met = fused_is_sub ? Condition::kAboveEqual : Condition::kBelow; break;
+      case Decoder::Condition::kMi: not_met = Condition::kPositiveOrZero; break;
+      case Decoder::Condition::kPl: not_met = Condition::kNegative; break;
+      case Decoder::Condition::kVs: not_met = Condition::kNoOverflow; break;
+      case Decoder::Condition::kVc: not_met = Condition::kOverflow; break;
+      case Decoder::Condition::kHi: if (fused_is_sub) not_met = Condition::kBelowEqual; break;
+      case Decoder::Condition::kLs: if (fused_is_sub) not_met = Condition::kAbove; break;
+      case Decoder::Condition::kGe: not_met = Condition::kLess; break;
+      case Decoder::Condition::kLt: not_met = Condition::kGreaterEqual; break;
+      case Decoder::Condition::kGt: not_met = Condition::kLessEqual; break;
+      case Decoder::Condition::kLe: not_met = Condition::kGreater; break;
+      default: break;
+    }
+    if (not_met != Condition::kInvalidCondition) {
+      EmitCaptureNZCV();  // LAHF/SETO keep EFLAGS
+      as_.Jcc(not_met, *cont);
+      fused = true;
+    } else {
+      EmitStoreArmNZCV(fused_is_sub);
+    }
+  }
+  if (fused) {
+    EmitFinishNZCV(fused_is_sub);  // taken path: eax still holds the captured flags
+  } else {
+    EmitJumpIfCondNotMet(cond, *cont);
+  }
 
   // forward branch extension with back-edge detection
   GuestAddr target = GetInsnAddr() + offset;
@@ -241,6 +277,7 @@
   ExitRegionOrLoop(target);
   // Fall-through: continue translating if forward branch (is_region_end_reached_ not set).
   as_.Bind(cont);
+  if (fused) EmitFinishNZCV(fused_is_sub);  // not-taken path: the jump came straight from the compare, eax is intact
 }
 
