From: apklayer <noreply@apklayer.invalid>
Subject: [PATCH] apklayer patch: full fences as LOCK NOTL of a private word, not MFENCE

Both translators lowered every full DMB/DSB and the store-load fence after STLR to MFENCE. MFENCE is dispatch-serializing on AMD Zen:
14.5 ns per fence on a Ryzen 5 5600 against ~1.8 ns for a locked RMW (microbenchmark, 2026-11-19). PGR's render thread was CPU-bound
in menus (94% running, UnityMain waiting on it 86%), and half of its samples sat on 3-byte pairs in two heavy regions of libunity.so
built from DMB/LDAR/LDAXR/STLXR loops (Unity's lock-free queues). EmitFullFence (lite: lite_translator_integer_ctrl.inc; heavy:
HeavyOptimizerFrontend) emits LOCK NOTL of the new ThreadState::barrier_scratch: a locked RMW orders earlier stores before later
loads like MFENCE for ordinary memory; NOT leaves EFLAGS alone and needs no register. Used by full DMB/DSB and STLR in both tiers;
store-only DMB and LDAR stay fence-free. The LOCK NOTL encoding and the scratch word are from a parallel patch on this PC
(/tmp/apklayer-cpu.yRiM1V, "use a locked fence for DMB ISH on AMD"), which kept MFENCE for DSB, STLR and non-AMD hosts.
Test: lite_translate_region_exec_tests StoreLoadBarrierEmitsMfence checks the locked fence for STLR W/X, DMB/DSB ISH/SY.
Module libberberis_arm64.

diff --git a/cpu_emulation/assembler/instructions/insn_def_x86.json b/cpu_emulation/assembler/instructions/insn_def_x86.json
index b16e699..25c7035 100644
--- a/cpu_emulation/assembler/instructions/insn_def_x86.json
+++ b/cpu_emulation/assembler/instructions/insn_def_x86.json
@@ -1784,6 +1784,14 @@
         { "class": "FLAGS", "usage": "def" }
       ]
     },
+    {
+      "encodings": {
+        "Lock Notl": { "opcodes": [ "F0", "F7", "2" ] }
+      },
+      "args": [
+        { "class": "Mem32", "usage": "use_def" }
+      ]
+    },
     {
       "encodings": {
         "Lock Xaddb": { "opcodes": [ "F0", "0F", "C0" ], "type": "reg_to_rm" },
diff --git a/cpu_emulation/heavy_optimizer/arm64/frontend.cc b/cpu_emulation/heavy_optimizer/arm64/frontend.cc
index 350c585..d164971 100644
--- a/cpu_emulation/heavy_optimizer/arm64/frontend.cc
+++ b/cpu_emulation/heavy_optimizer/arm64/frontend.cc
@@ -1846,7 +1846,7 @@ void HeavyOptimizerFrontend::LoadStoreExclusive(const Decoder::LoadStoreExclusiv
         return;
       }
       StoreUntagged(lss, base, 0, data);
-      GenRaw<x86_64::Mfence>();
+      EmitFullFence();  // apklayer patch (0075)
       return;
     }
 
@@ -2613,8 +2613,15 @@ void HeavyOptimizerFrontend::ClearExclusive() {
 }
 
 void HeavyOptimizerFrontend::DataMemoryBarrier() {
-  // Full DMB/DSB -> MFENCE: recover the StoreLoad ordering x86 TSO omits.
-  GenRaw<x86_64::Mfence>();
+  // Full DMB/DSB: recover the StoreLoad ordering x86 TSO omits.
+  EmitFullFence();  // apklayer patch (0075)
+}
+
+// apklayer patch (0075): as lite's EmitFullFence: LOCK NOTL of ThreadState::barrier_scratch instead of MFENCE (dispatch-serializing on
+// AMD Zen, ~8x the cost); a locked RMW, no EFLAGS, no register.
+void HeavyOptimizerFrontend::EmitFullFence() {
+  GenRaw<x86_64::LockNotlOp>(
+      {.base = x86_64::kMachineRegRBP, .disp = static_cast<int32_t>(offsetof(ThreadState, barrier_scratch))});
 }
 
 void HeavyOptimizerFrontend::RecordBail(BailReason reason) {
diff --git a/cpu_emulation/heavy_optimizer/arm64/frontend.h b/cpu_emulation/heavy_optimizer/arm64/frontend.h
index 66bbcf2..3979d5e 100644
--- a/cpu_emulation/heavy_optimizer/arm64/frontend.h
+++ b/cpu_emulation/heavy_optimizer/arm64/frontend.h
@@ -197,6 +197,7 @@ class HeavyOptimizerFrontend {
   // DMB/DSB full barrier: lowers to MFENCE (x86 TSO lacks StoreLoad ordering).
   // The store-only/load-only barrier variants are NOPed in the decoder.
   void DataMemoryBarrier();
+  void EmitFullFence();  // apklayer patch (0075)
 
   //
   // Immediate-form data processing.
diff --git a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translate_region_exec_tests.cc b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translate_region_exec_tests.cc
index e449be5..47550e4 100644
--- a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translate_region_exec_tests.cc
+++ b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translate_region_exec_tests.cc
@@ -602,13 +602,18 @@ TEST_F(Arm64LiteTranslateRegionTest, StoreLoadBarrierEmitsMfence) {
   auto has_mfence = [](const std::string& s) {
     return s.find("0f ae f0") != std::string::npos || s.find("0F AE F0") != std::string::npos;
   };
-  EXPECT_TRUE(has_mfence(region_bytes(0x889ffc01))) << "STLR W must emit MFENCE";
-  EXPECT_TRUE(has_mfence(region_bytes(0xc89ffc01))) << "STLR X must emit MFENCE";
-  EXPECT_TRUE(has_mfence(region_bytes(0xd5033bbf))) << "DMB ISH (full) must emit MFENCE";
-  EXPECT_TRUE(has_mfence(region_bytes(0xd5033fbf))) << "DMB SY (full) must emit MFENCE";
-  EXPECT_TRUE(has_mfence(region_bytes(0xd5033f9f))) << "DSB SY (full) must emit MFENCE";
-  EXPECT_FALSE(has_mfence(region_bytes(0xd5033abf))) << "DMB ISHST (store-only) needs no MFENCE";
-  EXPECT_FALSE(has_mfence(region_bytes(0x88dffc01))) << "LDAR needs no MFENCE (x86 acquire is free)";
+  // apklayer patch (0075): the full fence is LOCK NOTL of ThreadState::barrier_scratch (F0 F7 /2, ModRM 95: [RBP + disp32]).
+  auto has_lock_notl = [](const std::string& s) {
+    return s.find("f0 f7 95") != std::string::npos || s.find("F0 F7 95") != std::string::npos;
+  };
+  for (uint32_t insn : {0x889ffc01u, 0xc89ffc01u, 0xd5033bbfu, 0xd5033b9fu, 0xd5033fbfu, 0xd5033f9fu}) {
+    const auto bytes = region_bytes(insn);
+    EXPECT_TRUE(has_lock_notl(bytes)) << std::hex << insn << ": STLR and full DMB/DSB need the locked fence";
+    EXPECT_FALSE(has_mfence(bytes)) << std::hex << insn;
+  }
+  EXPECT_FALSE(has_lock_notl(region_bytes(0xd5033abf))) << "DMB ISHST (store-only) needs no fence";
+  EXPECT_FALSE(has_mfence(region_bytes(0xd5033abf)));
+  EXPECT_FALSE(has_lock_notl(region_bytes(0x88dffc01))) << "LDAR needs no fence (x86 acquire is free)";
 }
 
 // Interpreter-vs-EXPECTED for fused multiply-add (FMLA/FMLS vector, FMADD/FMSUB
diff --git a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_int_carry_excl.inc b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_int_carry_excl.inc
index d8c667a..d5ada30 100644
--- a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_int_carry_excl.inc
+++ b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_int_carry_excl.inc
@@ -292,7 +292,7 @@
         if (!success()) return;
         if (args.rt >= 31) as_.Xorl(data, data);
         StoreUntagged(lss, base, 0, data);
-        as_.Mfence();
+        EmitFullFence();  // apklayer patch (0075)
         break;
       }
 
diff --git a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_integer_ctrl.inc b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_integer_ctrl.inc
index 064f862..9bf3835 100644
--- a/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_integer_ctrl.inc
+++ b/cpu_emulation/lite_translator/arm64_to_x86_64/lite_translator_integer_ctrl.inc
@@ -1307,7 +1307,15 @@
   // DMB/DSB full barrier: x86 TSO lacks StoreLoad ordering, so a full guest
   // barrier must lower to MFENCE (the store-only/load-only variants are NOPed
   // upstream in the decoder).
-  void DataMemoryBarrier() { as_.Mfence(); }
+  void DataMemoryBarrier() { EmitFullFence(); }
+
+  // apklayer patch (0075): the full fence as LOCK NOTL of this thread's private ThreadState word: a locked RMW orders earlier stores
+  // before later loads like MFENCE for ordinary memory; NOT leaves EFLAGS alone and needs no register. MFENCE is dispatch-serializing
+  // on AMD Zen (14.5 ns against ~1.8 ns for a locked RMW on a Ryzen 5 5600) and was the hottest code of PGR's render thread (Unity's
+  // lock-free queues: DMB and STLR in a loop).
+  void EmitFullFence() {
+    as_.LockNotl({.base = Assembler::rbp, .disp = static_cast<int32_t>(offsetof(ThreadState, barrier_scratch))});
+  }
 
   // IC IVAU, Xt — invalidate the translation cache for self-modified code. The
   // address is only known at run time, so end the region here and let the
diff --git a/guest_state/arm64/include/berberis/guest_state/guest_state_arch.h b/guest_state/arm64/include/berberis/guest_state/guest_state_arch.h
index 4ac53df..966901e 100644
--- a/guest_state/arm64/include/berberis/guest_state/guest_state_arch.h
+++ b/guest_state/arm64/include/berberis/guest_state/guest_state_arch.h
@@ -62,6 +62,9 @@ struct ThreadState {
 
   // Is Optimized ABI currently enabled.
   bool is_optimized_inter_region_abi_enabled = false;
+
+  // Private host word for the locked instruction used as a full memory fence.
+  uint32_t barrier_scratch = 0;
 };
 
 inline constexpr unsigned kNumGuestRegs = std::size(CPUState{}.x);
