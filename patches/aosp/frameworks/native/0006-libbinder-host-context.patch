+// apklayer patch: names the instance has chosen the device for (hardware providers, docs/HALIUM.md) come from the host's
+// servicemanager when this one has none: one name or interface ("android.hardware.vibrator.IVibrator" covers its "/default")
+// per line of /data/apklayer/host_hals.conf, written by the stack from the instance's provider choice (Waydroid's hostaidls.conf).
+static bool isHostService(const std::string& name) {
+    [[clang::no_destroy]] static const std::vector<std::string> names = [] {
+        std::string text;
+        android::base::ReadFileToString("/data/apklayer/host_hals.conf", &text);
+        std::vector<std::string> out;
+        for (auto& line : android::base::Split(text, "\n")) {
+            std::string n = android::base::Trim(line.substr(0, line.find('#')));
+            if (!n.empty()) out.push_back(n);
+        }
+        return out;
+    }();
+    for (const auto& n : names)
+        if (name == n || (android::base::StartsWith(name, n) && name[n.size()] == '/')) return true;
+    return false;
+}
+
+// The host's servicemanager may be older (Halium 9-13): getService is FIRST_CALL_TRANSACTION in every version since
+// Android 11 (checkService moved), and its interface token header is the same since then.
+static sp<IBinder> hostService(const std::string& name) {
+    if (!isHostService(name)) return nullptr;
+    sp<ProcessState> host = ProcessState::self(true);
+    if (host == nullptr) {
+        ALOGW("%s: listed for the host, but there is no host binder context", name.c_str());
+        return nullptr;
+    }
+    static std::once_flag pool;
+    std::call_once(pool, [&] { host->startThreadPool(); });  // callbacks and death notices from the host
+    sp<IBinder> sm = host->getContextObject(nullptr);
+    if (sm == nullptr) return nullptr;
+    Parcel data, reply;
+    data.writeInterfaceToken(String16(u"android.os.IServiceManager"));
+    data.writeString16(String16(name.c_str()));
+    sp<IBinder> out;
+    if (sm->transact(IBinder::FIRST_CALL_TRANSACTION, data, &reply) != OK || reply.readExceptionCode() != 0 ||
+        reply.readNullableStrongBinder(&out) != OK)
+        ALOGW("%s: the host's servicemanager did not answer", name.c_str());
+    ALOGI("%s: %s on the host", name.c_str(), out ? "found" : "not found");
+    return out;
+}
