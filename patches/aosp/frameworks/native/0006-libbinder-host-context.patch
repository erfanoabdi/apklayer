+// apklayer patch: the host binder context (Waydroid's dual driver, frameworks/native 0015): a second ProcessState on
+// /dev/host_binder (apklayer's path layer maps it to the device's binder, $APKLAYER_HOST_BINDER), absent when that is not there.
+[[clang::no_destroy]] static sp<ProcessState> gHostProcess;
+static std::atomic<uintptr_t> gHostVMStart{0};
+
+sp<ProcessState> ProcessState::self(bool host) {
+    if (!host) return self();
+    [[clang::no_destroy]] static std::once_flag once;
+    std::call_once(once, []() {
+        const char* driver = "/dev/host_binder";
+        if (access(driver, R_OK | W_OK) == -1) return;
+        self();  // the default context first: it installs the fork handlers, which close both
+        sp<ProcessState> p = sp<ProcessState>::make(driver);
+        if (p->mDriverFD < 0) return;
+        p->mHost = true;
+        gHostVMStart.store(reinterpret_cast<uintptr_t>(p->mVMStart), std::memory_order_release);
+        std::lock_guard<std::mutex> l(gProcessMutex);
+        gHostProcess = p;
+    });
+    std::lock_guard<std::mutex> l(gProcessMutex);
+    if (gHostProcess) verifyNotForked(gHostProcess->mForked);
+    return gHostProcess;
+}
+
+bool ProcessState::isHostBuffer(const void* data) {
+    uintptr_t start = gHostVMStart.load(std::memory_order_acquire), p = reinterpret_cast<uintptr_t>(data);
+    return start != 0 && p >= start && p - start < static_cast<uintptr_t>(BINDER_VM_SIZE);
+}
