From: Erfan Abdi <erfangplus@gmail.com>
Subject: [PATCH] apklayer: file descriptor helpers on HotSpot

Public descriptor helpers in file_descriptor_jni.c and JNIPlatformHelp.c use the actual FileDescriptor
class and constructor, Android's descriptor/setInt$ when available and HotSpot's fd field when needed,
avoiding eager initialization of unrelated Android NIO constants. Native MediaExtractor descriptor-source
tests verify nonzero offset, track/sample/seek, caller ownership and immediate caller close after setup.
Formerly scripts/patch-nativehelper.sh.
Against libnativehelper 5b63a7e308ca (REVISION). Apply: patches/apply aosp <LineageOS tree>.
---
diff --git a/JNIPlatformHelp.c b/JNIPlatformHelp.c
index 464e964..9fbf5d6 100644
--- a/JNIPlatformHelp.c
+++ b/JNIPlatformHelp.c
@@ -17,49 +17,58 @@
 #include "include_platform/nativehelper/JNIPlatformHelp.h"
 
 #include <stddef.h>
+#include <stdint.h>
 
-#include "JniConstants.h"
-
-static int GetBufferPosition(JNIEnv* env, jobject nioBuffer) {
-    return(*env)->GetIntField(env, nioBuffer, JniConstants_NioBuffer_position(env));
-}
-
-static int GetBufferLimit(JNIEnv* env, jobject nioBuffer) {
-    return(*env)->GetIntField(env, nioBuffer, JniConstants_NioBuffer_limit(env));
+/* apklayer patch: Buffer layout differs between libcore and OpenJDK. */
+static jint BufferInt(JNIEnv* env, jobject buffer, const char* name) {
+    jclass cls = (*env)->GetObjectClass(env, buffer);
+    jmethodID method = (*env)->GetMethodID(env, cls, name, "()I");
+    jint value = (*env)->CallIntMethod(env, buffer, method);
+    (*env)->DeleteLocalRef(env, cls);
+    return value;
 }
 
-static int GetBufferElementSizeShift(JNIEnv* env, jobject nioBuffer) {
-    return(*env)->GetIntField(env, nioBuffer, JniConstants_NioBuffer__elementSizeShift(env));
+static jint ElementShift(JNIEnv* env, jobject buffer) {
+    const char* types[] = {"java/nio/ByteBuffer", "java/nio/CharBuffer",
+        "java/nio/ShortBuffer", "java/nio/IntBuffer", "java/nio/FloatBuffer",
+        "java/nio/LongBuffer", "java/nio/DoubleBuffer"};
+    const int shifts[] = {0, 1, 1, 2, 2, 3, 3};
+    for (int i = 0; i < 7; i++) {
+        jclass cls = (*env)->FindClass(env, types[i]);
+        jboolean match = (*env)->IsInstanceOf(env, buffer, cls);
+        (*env)->DeleteLocalRef(env, cls);
+        if (match) return shifts[i];
+    }
+    return 0;
 }
 
-jarray jniGetNioBufferBaseArray(JNIEnv* env, jobject nioBuffer) {
-    jclass nioAccessClass = JniConstants_NIOAccessClass(env);
-    jmethodID getBaseArrayMethod = JniConstants_NIOAccess_getBaseArray(env);
-    jobject object = (*env)->CallStaticObjectMethod(env,
-                                                    nioAccessClass, getBaseArrayMethod, nioBuffer);
-    return (jarray) object;
+jarray jniGetNioBufferBaseArray(JNIEnv* env, jobject buffer) {
+    jclass cls = (*env)->GetObjectClass(env, buffer);
+    jmethodID has = (*env)->GetMethodID(env, cls, "hasArray", "()Z");
+    jarray array = NULL;
+    if ((*env)->CallBooleanMethod(env, buffer, has)) {
+        jmethodID get = (*env)->GetMethodID(env, cls, "array", "()Ljava/lang/Object;");
+        array = (jarray)(*env)->CallObjectMethod(env, buffer, get);
+    }
+    (*env)->DeleteLocalRef(env, cls);
+    return array;
 }
 
-int jniGetNioBufferBaseArrayOffset(JNIEnv* env, jobject nioBuffer) {
-    jclass nioAccessClass = JniConstants_NIOAccessClass(env);
-    jmethodID getBaseArrayOffsetMethod = JniConstants_NIOAccess_getBaseArrayOffset(env);
-    return (*env)->CallStaticIntMethod(env, nioAccessClass, getBaseArrayOffsetMethod, nioBuffer);
+int jniGetNioBufferBaseArrayOffset(JNIEnv* env, jobject buffer) {
+    return (BufferInt(env, buffer, "arrayOffset") + BufferInt(env, buffer, "position"))
+        << ElementShift(env, buffer);
 }
 
-jlong jniGetNioBufferPointer(JNIEnv* env, jobject nioBuffer) {
-    jlong baseAddress = (*env)->GetLongField(env, nioBuffer, JniConstants_NioBuffer_address(env));
-    if (baseAddress != 0) {
-        const int position = GetBufferPosition(env, nioBuffer);
-        const int shift = GetBufferElementSizeShift(env, nioBuffer);
-        baseAddress += position << shift;
-    }
-    return baseAddress;
+jlong jniGetNioBufferFields(JNIEnv* env, jobject buffer,
+        jint* position, jint* limit, jint* shift) {
+    *position = BufferInt(env, buffer, "position");
+    *limit = BufferInt(env, buffer, "limit");
+    *shift = ElementShift(env, buffer);
+    return (jlong)(uintptr_t)(*env)->GetDirectBufferAddress(env, buffer);
 }
 
-jlong jniGetNioBufferFields(JNIEnv* env, jobject nioBuffer,
-                            jint* position, jint* limit, jint* elementSizeShift) {
-    *position = GetBufferPosition(env, nioBuffer);
-    *limit = GetBufferLimit(env, nioBuffer);
-    *elementSizeShift = GetBufferElementSizeShift(env, nioBuffer);
-    return (*env)->GetLongField(env, nioBuffer, JniConstants_NioBuffer_address(env));
+jlong jniGetNioBufferPointer(JNIEnv* env, jobject buffer) {
+    jint position, limit, shift;
+    jlong address = jniGetNioBufferFields(env, buffer, &position, &limit, &shift);
+    return address ? address + ((jlong)position << shift) : 0;
 }
diff --git a/file_descriptor_jni.c b/file_descriptor_jni.c
index 81ed323..9ec8eeb 100644
--- a/file_descriptor_jni.c
+++ b/file_descriptor_jni.c
@@ -23,25 +23,51 @@
 
 #include "JniConstants.h"
 
-static void EnsureArgumentIsFileDescriptor(JNIEnv* env, jobject instance) {
+/* apklayer patch: descriptor APIs do not initialize unrelated Android-only NIO constants. */
+static jclass FileDescriptorClass(JNIEnv* env) {
+    jclass cls = (*env)->FindClass(env, "java/io/FileDescriptor");
+    ALOG_ALWAYS_FATAL_IF(cls == NULL, "FileDescriptor class not found");
+    return cls;
+}
+
+static jfieldID DescriptorField(JNIEnv* env, jclass cls) {
+    jfieldID field = (*env)->GetFieldID(env, cls, "descriptor", "I");
+    if (field == NULL) {
+        (*env)->ExceptionClear(env); /* Android name absent on HotSpot. */
+        field = (*env)->GetFieldID(env, cls, "fd", "I");
+    }
+    ALOG_ALWAYS_FATAL_IF(field == NULL, "FileDescriptor integer field not found");
+    return field;
+}
+
+static jclass EnsureArgumentIsFileDescriptor(JNIEnv* env, jobject instance) {
     ALOG_ALWAYS_FATAL_IF(instance == NULL, "FileDescriptor is NULL");
-    jclass jifd = JniConstants_FileDescriptorClass(env);
-    ALOG_ALWAYS_FATAL_IF(!(*env)->IsInstanceOf(env, instance, jifd),
-                         "Argument is not a FileDescriptor");
+    jclass cls = FileDescriptorClass(env);
+    ALOG_ALWAYS_FATAL_IF(!(*env)->IsInstanceOf(env, instance, cls), "Argument is not a FileDescriptor");
+    return cls;
 }
 
 JNIEXPORT _Nullable jobject AFileDescriptor_create(JNIEnv* env) {
-    return (*env)->NewObject(env,
-                             JniConstants_FileDescriptorClass(env),
-                             JniConstants_FileDescriptor_init(env));
+    jclass cls = FileDescriptorClass(env);
+    jobject result = (*env)->NewObject(env, cls, (*env)->GetMethodID(env, cls, "<init>", "()V"));
+    (*env)->DeleteLocalRef(env, cls);
+    return result;
 }
 
-JNIEXPORT int AFileDescriptor_getFd(JNIEnv* env, jobject fileDescriptor) {
-    EnsureArgumentIsFileDescriptor(env, fileDescriptor);
-    return (*env)->GetIntField(env, fileDescriptor, JniConstants_FileDescriptor_descriptor(env));
+JNIEXPORT int AFileDescriptor_getFd(JNIEnv* env, jobject instance) {
+    jclass cls = EnsureArgumentIsFileDescriptor(env, instance);
+    int result = (*env)->GetIntField(env, instance, DescriptorField(env, cls));
+    (*env)->DeleteLocalRef(env, cls);
+    return result;
 }
 
-JNIEXPORT void AFileDescriptor_setFd(JNIEnv* env, jobject fileDescriptor, int fd) {
-    EnsureArgumentIsFileDescriptor(env, fileDescriptor);
-    (*env)->CallVoidMethod(env, fileDescriptor, JniConstants_FileDescriptor_setInt$(env), fd);
+JNIEXPORT void AFileDescriptor_setFd(JNIEnv* env, jobject instance, int fd) {
+    jclass cls = EnsureArgumentIsFileDescriptor(env, instance);
+    jmethodID setter = (*env)->GetMethodID(env, cls, "setInt$", "(I)V");
+    if (setter != NULL) (*env)->CallVoidMethod(env, instance, setter, fd);
+    else {
+        (*env)->ExceptionClear(env); /* HotSpot uses its real fd field. */
+        (*env)->SetIntField(env, instance, DescriptorField(env, cls), fd);
+    }
+    (*env)->DeleteLocalRef(env, cls);
 }
