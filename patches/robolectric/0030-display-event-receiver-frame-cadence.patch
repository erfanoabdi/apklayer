@@ -255,7 +270,8 @@
         FrameTimelineReflector frameTimelineReflector = reflector(FrameTimelineReflector.class);
         Object timelineArray = Array.newInstance(frameTimelineClass, timelineArrayLength);
         for (int i = 0; i < timelineArrayLength; i++) {
