From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: apklayer <apklayer@localhost>
Subject: [PATCH] DefaultNativeRuntimeLoader: arm64 Linux, real window and media natives

apklayer patch (docs/PATCHES.md): isSupported() also accepts Linux aarch64, because the
shim and the device libraries are arm64. The natives of SurfaceControl, SurfaceSession, BLASTBufferQueue and HardwareBuffer are
registered (windows are real SurfaceFlinger layers fed by a real BLASTBufferQueue), and Parcel and the resource classes
(ApkAssets, AssetManager, StringBlock, XmlBlock: the NDK asset and configuration APIs need real resource pointers) are always
real. Hyphen data is neither copied nor set: the device flavor uses the instance's staged system data and instance startup sets
ro.hyphen.data.dir once (ro.* is write-once). The media classes (MediaCodec, MediaCodecList, MediaExtractor, MediaPlayer) and
GLES20 run their static initializers after the device JNI is registered, because they call their own natives during class init.

Against external/robolectric 87aa52b08 (REVISION). Applied by scripts/build-runtime-overlay.sh onto the staged
upstream sources (<native>/aosp/robolectric-src); the result is compiled into native-runtime.jar ahead of Robolectric_all.jar.
---
diff --git a/nativeruntime/src/main/java/org/robolectric/nativeruntime/DefaultNativeRuntimeLoader.java b/nativeruntime/src/main/java/org/robolectric/nativeruntime/DefaultNativeRuntimeLoader.java
--- a/nativeruntime/src/main/java/org/robolectric/nativeruntime/DefaultNativeRuntimeLoader.java
+++ b/nativeruntime/src/main/java/org/robolectric/nativeruntime/DefaultNativeRuntimeLoader.java
@@ -90,6 +90,11 @@
             "android.os.SystemProperties",
             "android.text.Hyphenator",
             "android.view.Surface",
+            "android.hardware.HardwareBuffer", // Bitmap.getHardwareBuffer / HardwareBuffer objects (JNI class info is set up by the registration)
+            // apklayer patch: windows are real SurfaceFlinger layers fed by a real BLASTBufferQueue
+            "android.view.SurfaceControl",
+            "android.view.SurfaceSession",
+            "android.graphics.BLASTBufferQueue",
             "com.android.internal.util.VirtualRefBasePtr",
             "libcore.util.NativeAllocationRegistry",
           });
@@ -185,7 +190,11 @@
 
   /** Overridable in Android, due to changing shadows in private branches. */
   protected List<String> getCoreClassNatives() {
-    return CORE_CLASS_NATIVES;
+    ImmutableList.Builder<String> classes = ImmutableList.<String>builder().addAll(CORE_CLASS_NATIVES);
+    // apklayer patch: Parcel, the resource classes (NDK asset/configuration APIs need real resource pointers) and the media natives are always real
+    classes.add("android.os.Parcel", "android.content.res.ApkAssets", "android.content.res.AssetManager",
+        "android.content.res.StringBlock", "android.content.res.XmlBlock");
+    return classes.build();
   }
 
   /** Overridable in Android, due to changing shadows in private branches. */
@@ -222,7 +231,7 @@
                 if (VERSION.SDK_INT >= O) {
                   // Only copy fonts if graphics is supported, not just SQLite.
                   maybeCopyFonts(extractDirectory);
-                  maybeCopyHyphenData(extractDirectory);
+                  // apklayer patch: the device flavor uses the instance's real system data.
                 }
                 Map<String, String> originalProperties = new HashMap<>();
                 maybeCopyIcuData(extractDirectory);
@@ -249,7 +258,7 @@
                         .getAbsolutePath();
                 if (isAndroidVOrGreater()) {
                   invokeDeferredStaticInitializers();
-                  setNativeSystemProperty("ro.hyphen.data.dir", hyphenDataDir);
+                  // apklayer patch: set once by instance startup, shared by all app JVMs.
                   Typeface.loadPreinstalledSystemFontMap();
                 } else {
                   System.setProperty("hyphen.data.dir", hyphenDataDir);
@@ -412,7 +421,7 @@
   private static boolean isSupported() {
     return (OsUtil.isMac()
             && (Objects.equals(arch(), "aarch64") || Objects.equals(arch(), "x86_64")))
-        || (OsUtil.isLinux() && Objects.equals(arch(), "x86_64"))
+        || (OsUtil.isLinux() && (Objects.equals(arch(), "x86_64") || Objects.equals(arch(), "aarch64"))) // apklayer patch: arm64 Linux (the shim and the device libraries are arm64)
         || (OsUtil.isWindows() && Objects.equals(arch(), "x86_64"));
   }
 
@@ -469,6 +478,15 @@
       ReflectionHelpers.callStaticMethod(
           Shadow.class.getClassLoader(), className, "__staticInitializer__");
     }
+    // apklayer patch: media classes also call their own natives during class init.
+    // Finish them before Application.onCreate can query codec capabilities.
+    for (String className : new String[] {"android.media.MediaCodec", "android.media.MediaCodecList", "android.media.MediaExtractor"}) {
+      ReflectionHelpers.callStaticMethod(
+          Shadow.class.getClassLoader(), className, "__staticInitializer__");
+    }
+    // apklayer patch: GLES20 initializes only after original device JNI is registered.
+    ReflectionHelpers.callStaticMethod(Shadow.class.getClassLoader(), "android.opengl.GLES20", "__staticInitializer__");
+    ReflectionHelpers.callStaticMethod(Shadow.class.getClassLoader(), "android.media.MediaPlayer", "__staticInitializer__");
   }
 
   private static boolean isAndroidVOrGreater() {
