+    /**
+     * apklayer patch: whether this window's requested bars decide the screen's, as DisplayPolicy's top fullscreen window does
+     * (canBeTopFullscreenOpaqueWindow): an application window that fills the display. A dialog, a popup or a toast keeps the bars of
+     * the activity under it (its default, every bar visible, had made a fullscreen game a window again).
+     */
+    private static boolean controlsSystemBars(@Nullable WindowManager.LayoutParams attrs) {
+      return attrs != null
+          && attrs.type >= WindowManager.LayoutParams.FIRST_APPLICATION_WINDOW
+          && attrs.type <= WindowManager.LayoutParams.LAST_APPLICATION_WINDOW
+          && attrs.width == WindowManager.LayoutParams.MATCH_PARENT
+          && attrs.height == WindowManager.LayoutParams.MATCH_PARENT;
+    }
