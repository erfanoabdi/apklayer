<?xml version="1.0" encoding="utf-8"?>
<!-- A static shared library (<static-library>, HostAppLibraries): hello-applib-user names it with its version and this key's digest; carried in hello-sharedlib's assets -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="hello.applib">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
  <application android:label="applib">
    <static-library android:name="hello.applib" android:version="3"/>
  </application>
</manifest>
