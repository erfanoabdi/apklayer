<?xml version="1.0" encoding="utf-8"?>
<!-- No configChanges: a host settings change (night mode, locale, font scale) recreates the activity, as on a device. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="hello.settings">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
  <application android:label="settings-check" android:theme="@android:style/Theme.DeviceDefault.DayNight">
    <activity android:name=".Main" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <activity android:name=".Top"/>
  </application>
</manifest>
