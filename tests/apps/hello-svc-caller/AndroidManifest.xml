<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="hello.svccaller">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="34"/>
  <uses-permission android:name="hello.svctarget.permission.HELD"/>
  <application android:label="svc-caller">
    <activity android:name=".Main" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".LockService" android:exported="false"/>
    <service android:name=".PidService" android:exported="false">
      <intent-filter><action android:name="hello.svccaller.PID"/></intent-filter>
    </service>
    <service android:name=".OtherPidService" android:process=":other" android:exported="false">
      <intent-filter><action android:name="hello.svccaller.OTHER_PID"/></intent-filter>
    </service>
    <service android:name=".ExitService" android:process=":exit"/>
    <service android:name=".IsolatedPidService" android:isolatedProcess="true" android:exported="false"/>
    <provider android:name=".ProbeProvider" android:authorities="hello.svccaller.probe" android:multiprocess="true" android:exported="false"/>
  </application>
</manifest>
