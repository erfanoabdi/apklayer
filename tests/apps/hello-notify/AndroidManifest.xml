<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="hello.notify">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="34"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
  <application android:label="notify">
    <activity android:name=".Main" android:exported="true" android:screenOrientation="portrait">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".Fg" android:exported="false" android:foregroundServiceType="dataSync"/>
  </application>
</manifest>
