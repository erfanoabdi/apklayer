<?xml version="1.0" encoding="utf-8"?>
<!-- hello-keystore's code (src links to it) as a second package: the keystore keeps its keys apart (scenario "other", tests/vm/keystore.sh) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="hello.keystoreother">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
  <application android:label="keystore-other">
    <activity android:name="hello.keystore.Main" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
  </application>
</manifest>
