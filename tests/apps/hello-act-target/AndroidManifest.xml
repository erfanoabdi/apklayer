<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="hello.acttarget">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="34"/>
  <application android:label="act-target">
    <activity android:name=".Main" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <activity android:name=".PickActivity" android:exported="true" android:launchMode="singleTask">
      <intent-filter><action android:name="hello.act.PICK"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
    </activity>
    <activity android:name=".PrivateActivity" android:exported="false"/>
  </application>
</manifest>
