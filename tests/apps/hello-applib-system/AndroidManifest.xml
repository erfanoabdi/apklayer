<?xml version="1.0" encoding="utf-8"?>
<!-- A system app's <library> (installed as a system app, HostAppLibraries): hello-applib-user's <uses-library> gets its code; carried in hello-sharedlib's assets -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="hello.applib.system">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
  <application android:label="applib-system">
    <library android:name="hello.applib.shared"/>
  </application>
</manifest>
