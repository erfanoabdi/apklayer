#!/usr/bin/env python3
"""tests/run [-j N] [group...]: the VM test groups of tests/groups.toml (no group: all of them), each in an apklayer instance of its own, in parallel.
Pushes the working tree to the VM and builds it once, builds and installs the groups' test apps once, then runs the groups: up to N at a time
(default: by the VM's free memory, ~1 GB per instance, and half its CPUs; a group starts only while 3 GB are available, at most 4 at a time), the groups marked `alone` afterwards one by one. Logs: build/tests/<group>.log."""
import argparse
import os
import concurrent.futures
import signal
import subprocess
import sys
import threading
import time
import tomllib
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / 'lib'))
import vm  # noqa: E402

GROUPS = tomllib.loads((vm.REPO / 'tests/groups.toml').read_text())
LOGS = vm.REPO / 'build/tests'
print_lock = threading.Lock()
INSTANCE_MB = 1350  # what one running instance (stack, hub, app JVMs, shell, the instance spare: ~340 MB) takes
MIN_FREE_MB = 3000  # a group starts only while the VM has this much available (room for the other users of the VM)


def say(*args):
    with print_lock: print(*args, flush=True)


def available():
    """MemAvailable of the VM in MB."""
    out = vm.ssh("awk '/MemAvailable/ {print int($2 / 1024)}' /proc/meminfo", capture_output=True, text=True).stdout
    return int(out or 0)


# the runtime built and staged by Meson into <repo copy>/inst (docs/INSTALL.md): ninja rebuilds exactly what changed; the tree's CLI (bin/apklayer)
# uses that install. -Dprebuilts comes from $APKLAYER_PREBUILTS (APKLY_VM_ENV).
BUILD = (# a host's prebuilts behind the lock would be installed silently: the groups would test old native code
         '{ [ -z "${APKLAYER_PREBUILTS:-}" ] || sh tools/check-prebuilts.sh "$APKLAYER_PREBUILTS"; } && '
         '{ [ -f b/build.ninja ] || meson setup b --prefix "$PWD/inst" >/dev/null; } && '
         '{ grep -q "\\"$PWD/inst\\"" b/meson-info/intro-buildoptions.json || meson configure b --prefix "$PWD/inst" >/dev/null; } && '
         # meson lists the patch files when it configures: a new one is applied only after a reconfigure
         '{ [ -z "$(find patches -newer b/build.ninja -name \'*.patch\' | head -1)" ] || ninja -C b reconfigure >/dev/null; } && '
         # and the runtime's Java sources: a new file is compiled only after a reconfigure (ninja does not know it and keeps the old jar)
         '{ find runtime -name \'*.java\' | sort > b/java-files.new; cmp -s b/java-files.new b/java-files || ninja -C b reconfigure >/dev/null; } && mv b/java-files.new b/java-files && '
         'ninja -C b && meson install -C b --skip-subprojects --only-changed --quiet >/dev/null')


def prepare(groups, slots):
    t = time.monotonic()
    vm.push()
    # kernel binder devices for the slots only when the VM environment or a group (groups.toml binder = "kernel") picks the kernel's binder: the
    # userspace one, the default (docs/BINDER.md), needs none (no sudo when the slots' devices are there already: a VM whose sudo asks for a password)
    kernel = 'APKLAYER_BINDER=kernel' in vm.config.ENV or any(GROUPS[g].get('binder') == 'kernel' for g in groups)
    devices = '' if not kernel else ' && { %s || sudo -n sh tools/host-setup/binder.sh %s >/dev/null; }' % (
        ' && '.join('[ -e /dev/binderfs/%sbinder-%s ]' % (b, s) for s in slots for b in ('', 'hw', 'vnd')), ' '.join(slots))
    build = vm.ssh(vm.instance_env(slots[0]) + BUILD + devices,
                   capture_output=True, text=True)
    assert build.returncode == 0, 'VM build failed:\n' + build.stdout[-3000:] + build.stderr[-3000:]
    apps = sorted({a for g in groups for a in GROUPS[g].get('apps', [])})
    if apps:
        LOGS.mkdir(parents=True, exist_ok=True)
        with concurrent.futures.ThreadPoolExecutor(6) as pool:
            built = list(pool.map(lambda a: subprocess.run(['tests/apps/build.sh', a], cwd=vm.REPO, capture_output=True, text=True), apps))
        for app, b in zip(apps, built): assert b.returncode == 0, 'building %s failed:\n%s' % (app, b.stderr[-2000:])
        vm.copy([vm.REPO / 'build' / (a + '.apk') for a in apps], vm.WORK + '/apks')
        # a test app left by another tree's keys (worktrees make their own build/keys): replaced, it is only a test app
        install = ('for a in %s; do out=$(bin/apklayer install %s/apks/$a.apk 2>&1); '
                   'p=$(sed -n "s/.*INSTALL_FAILED_UPDATE_INCOMPATIBLE: \\([^ ]*\\) is installed with another signature.*/\\1/p" <<<"$out"); '
                   '[ -z "$p" ] || { bin/apklayer uninstall "$p" >/dev/null 2>&1; out=$(bin/apklayer install %s/apks/$a.apk 2>&1); }; '
                   '{ grep -aq "installed" <<<"$out" && ! grep -aq "INSTALL_FAILED" <<<"$out"; } || { tail -5 <<<"$out"; echo "install $a failed"; exit 1; }; done') % (' '.join(apps), vm.WORK, vm.WORK)
        assert vm.ssh(vm.instance_env(slots[0]) + install).returncode == 0, 'installing the test apps failed'
    setup = [c for g in groups for c in GROUPS[g].get('setup', [])]
    for command in dict.fromkeys(setup):
        assert vm.ssh(vm.instance_env(slots[0]) + command).returncode == 0, 'setup failed: ' + command
    # the installs start a stack in the first slot: a group there found it running (started without the group's environment), and when
    # no group takes that slot it stayed up after the run
    vm.ssh(vm.instance_env(slots[0]) + 'bin/apklayer stop', stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    say('prepared (push, build, %d apps) in %.0f s' % (len(apps), time.monotonic() - t))


SILENCE_S = int(os.environ.get('APKLY_SILENCE', 300))  # a group command whose log does not grow this long is hung (groups.toml: silence = N)


def run_watched(argv, out, silence):
    """The command's exit status; a command that writes nothing to its log for `silence` seconds is ended (HUNG in the log, a failure).
    The instance stop after the group then ends what it left on the VM."""
    proc = subprocess.Popen(argv, cwd=vm.REPO, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    size, quiet_since = -1, time.monotonic()
    while True:
        try: return proc.wait(timeout=5)
        except subprocess.TimeoutExpired: pass
        now_size = os.fstat(out.fileno()).st_size
        if now_size != size: size, quiet_since = now_size, time.monotonic()
        elif time.monotonic() - quiet_since > silence:
            os.killpg(proc.pid, signal.SIGTERM)
            try: proc.wait(timeout=10)
            except subprocess.TimeoutExpired: os.killpg(proc.pid, signal.SIGKILL); proc.wait()
            out.write('HUNG: no output for %d s, ended (tests/run silence limit; groups.toml silence = N to raise it)\n' % silence)
            out.flush()
            return -1


def run_group(name, slot):
    group = GROUPS[name]
    t = time.monotonic()
    log = LOGS / (name + '.log')
    env = vm.instance_env(slot, '%s/out/%s' % (vm.WORK, name))
    if group.get('binder'): env += 'export APKLAYER_BINDER=%s; ' % group['binder']  # a group pinned to one binder (the kernel's next to the default)
    ok = True
    with log.open('w') as out:
        commands = [(c, [*vm.SSH, env + c]) for c in group.get('run', [])] + [(c, ['sh', '-c', c]) for c in group.get('mac', [])]
        for command, argv in commands:
            out.write('$ ' + command + '\n')
            out.flush()
            if run_watched(argv, out, group.get('silence', SILENCE_S)) != 0:
                ok = False
                break
        vm.ssh(env + 'python3 -c "import sys; sys.path.insert(0, \'tests/lib\'); import instance; instance.stop()"', stdout=out, stderr=subprocess.STDOUT)
    seconds = time.monotonic() - t
    say('%s %-16s %4.0f s  [%s]' % ('PASS' if ok else 'FAIL', name, seconds, slot))
    if not ok:
        say(''.join('    | ' + line for line in log.read_text(errors='replace').splitlines(True)[-25:]))
    return name, ok, seconds


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('-j', type=int, help='groups at a time (default: by free VM memory)')
    parser.add_argument('groups', nargs='*', help='default: ' + ' '.join(GROUPS))
    args = parser.parse_args()
    groups = args.groups or [g for g in GROUPS if not GROUPS[g].get('optional')]
    unknown = [g for g in groups if g not in GROUPS]
    if unknown: parser.error('unknown group(s): %s' % ' '.join(unknown))
    # one runner per VM: its push and runtime rebuild replace files under another runner's running groups, and both take the same instance names
    # (parallel groups: -j). An agent with its own tree and instances (APKLY_VM_ROOT, APKLY_SLOTS) is another runner and takes its own lock file.
    import fcntl
    LOGS.mkdir(parents=True, exist_ok=True)
    global RUNNER
    RUNNER = open(LOGS / ('runner-%s-%s.lock' % (vm.config.VM.replace('@', '_'), vm.ROOT.replace('/', '_').replace('$', ''))), 'w')
    try: fcntl.flock(RUNNER, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError: parser.error('another tests/run uses %s on %s now: wait for it, or add groups to one run with -j' % (vm.ROOT, vm.config.VM))
    # a group's stack, hub and app JVMs keep about two CPUs busy while they start: on a 4-CPU host three at a time stalled the silence checks of hub-smoke, input and webview
    cpus = int(vm.ssh('nproc', capture_output=True, text=True).stdout or 2)
    jobs = args.j or max(1, min(4, cpus // 2, (available() - MIN_FREE_MB) // INSTANCE_MB + 1))
    prefix = os.environ.get('APKLY_INSTANCES', 'tests')  # instance names: another runner on the same VM (an agent's worktree) takes its own
    slots = (vm.config.SLOTS or [prefix] + ['%s%d' % (prefix, i) for i in range(2, jobs + 1)])[:jobs]  # APKLY_SLOTS: an explicit list of one's own
    jobs = len(slots)
    start = time.monotonic()
    LOGS.mkdir(parents=True, exist_ok=True)
    prepare(groups, slots)
    ready = time.monotonic()
    have = vm.ssh(vm.instance_env(slots[0]) + 'bin/apklayer list', capture_output=True, text=True).stdout
    # a fresh data home lacks the system apps (providers, WebView): the ones the groups need are installed from the prebuilts (tests/vm/sysapps.sh)
    lacking = sorted({p for g in groups for p in GROUPS[g].get('needs', []) if p not in have})
    if lacking:
        vm.ssh(vm.instance_env(slots[0]) + 'sh tests/vm/sysapps.sh ' + ' '.join(lacking) + '; bin/apklayer stop >/dev/null 2>&1', stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT)
        have = vm.ssh(vm.instance_env(slots[0]) + 'bin/apklayer list; bin/apklayer stop >/dev/null 2>&1', capture_output=True, text=True).stdout
    results = []
    for g in groups:
        missing = [p for p in GROUPS[g].get('needs', []) if p not in have]
        if missing:
            say('SKIP %-16s needs %s installed' % (g, ' '.join(missing)))
            groups = [x for x in groups if x != g]
    free_slots = list(slots)
    changed = threading.Condition()

    def job(name):
        # a group starts when the VM has room for one more instance (other users' instances count too); while it has not, it waits for one of
        # ours to end (none running: it starts anyway)
        with changed:
            while len(free_slots) < len(slots) and available() < MIN_FREE_MB: changed.wait()
            slot = free_slots.pop()
        try: return run_group(name, slot)
        finally:
            with changed:
                free_slots.append(slot)
                changed.notify_all()

    together = [g for g in groups if not GROUPS[g].get('alone')]
    with concurrent.futures.ThreadPoolExecutor(jobs) as pool:
        results += list(pool.map(job, together))
    results += [job(g) for g in groups if GROUPS[g].get('alone')]
    failed = [n for n, ok, _ in results if not ok]
    say('%d groups in %.0f s wall after %.0f s of preparation (%.0f s of group time, the sequential cost), %d at a time: %s' % (len(results), time.monotonic() - ready, ready - start, sum(s for *_, s in results), jobs,
        'all passed' if not failed else 'FAILED: ' + ' '.join(failed)))
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main())
