#!/usr/bin/make -f
# The apklayer deb (docs/RELEASES.md): the Meson build and install of a development tree (docs/INSTALL.md) with prefix /usr and without the
# Android half, which the per-user runtime bundle brings. tools/release/build-deb.sh writes debian/changelog and the codename's substvars, then
# runs dpkg-buildpackage with APKLAYER_PREBUILTS (a joined prebuilts checkout) and APKLAYER_SLINT (manager/fetch-slint.sh).
export APKLAYER_VERSION ?= $(shell dpkg-parsechangelog -S Version)
B := $(CURDIR)/debian/build
# the flags the tree is built and tested with (meson's), not dpkg-buildflags' (LTO, Ubuntu's -Bsymbolic-functions): the path layer and
# bionic_translation interpose symbols across libraries
MESON := env -u CFLAGS -u CXXFLAGS -u CPPFLAGS -u LDFLAGS -u OBJCFLAGS -u OBJCXXFLAGS -u FFLAGS -u FCFLAGS meson

%:
	dh $@

override_dh_auto_configure:
	$(MESON) setup $(B) --prefix=/usr -Dprebuilts=$(APKLAYER_PREBUILTS) -Dandroid_runtime=false -Dpackage_version=$(APKLAYER_VERSION)
	$(MESON) setup $(B)-manager manager --prefix=/usr -Dlibdir=lib/apklayer -Dslint=$(APKLAYER_SLINT)

override_dh_auto_build:
	ninja -C $(B)
	ninja -C $(B)-manager apklayer-manager

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/apklayer meson install -C $(B) --skip-subprojects --no-rebuild --quiet
	DESTDIR=$(CURDIR)/debian/apklayer meson install -C $(B)-manager --no-rebuild --quiet
	install -D -m644 debian/instances debian/apklayer/etc/apklayer/instances
	# the per-app sandbox (cli/sandbox.cpp): the AppArmor profile that allows its user namespaces (postinst puts it in place where AppArmor
	# knows userns rules), render nodes for app uids, apklayerd's user unit (not enabled: `systemctl --user enable --now apklayerd`)
	install -d debian/apklayer/usr/share/apklayer/apparmor
	sed 's#@NAME@##; s#@BIN@#/usr/lib/apklayer/cli/apklayer#' tools/host-setup/apklayer.apparmor > debian/apklayer/usr/share/apklayer/apparmor/apklayer
	install -D -m644 tools/host-setup/70-apklayer-render.rules debian/apklayer/usr/lib/udev/rules.d/70-apklayer-render.rules
	install -D -m644 tools/host-setup/apklayerd.service debian/apklayer/usr/lib/systemd/user/apklayerd.service
	# apklayer-dev: the hardware plugin API (headers, apklayer-plugin.pc: docs/PLUGINS.md)
	mkdir -p debian/apklayer-dev/usr/lib/$(DEB_HOST_MULTIARCH)
	mv debian/apklayer/usr/include debian/apklayer-dev/usr/
	mv debian/apklayer/usr/lib/$(DEB_HOST_MULTIARCH)/pkgconfig debian/apklayer-dev/usr/lib/$(DEB_HOST_MULTIARCH)/
	rmdir debian/apklayer/usr/lib/$(DEB_HOST_MULTIARCH)

override_dh_auto_test:

override_dh_auto_clean:
	rm -rf $(B) $(B)-manager

override_dh_installsystemd:
	# kernel binder only (apklayer binder kernel): the userspace binder, the default, needs no root step; `systemctl enable --now apklayer-binder` turns it on
	dh_installsystemd --name=apklayer-binder --no-enable --no-start

# private libraries: bionic_translation's, and Android's (the native runtime links against them; the runtime bundle brings them)
override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/apklayer/usr/lib/apklayer/bionic_translation/b:$(APKLAYER_PREBUILTS)/$(if $(filter arm64,$(DEB_HOST_ARCH)),arm64,x86_64)/android-libs/lib64 -- --ignore-missing-info

# the OS release's own dependencies (tools/release/build-deb.sh writes debian/<codename>.substvars)
override_dh_gencontrol:
	cat debian/$(shell dpkg-parsechangelog -S Distribution).substvars >> debian/apklayer.substvars
	dh_gencontrol

override_dh_makeshlibs:

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_dwz:
