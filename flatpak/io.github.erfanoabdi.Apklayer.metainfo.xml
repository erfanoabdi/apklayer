<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.erfanoabdi.Apklayer</id>
  <name>Apklayer</name>
  <summary>Run Android apps in their own windows</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <developer id="io.github.erfanoabdi">
    <name>Erfan Abdi</name>
  </developer>
  <description>
    <p>Apklayer runs Android apps (APKs) as Linux processes, each in its own Wayland window. The manager installs, opens and manages them
      and adds their launchers to the app menu.</p>
    <p>The first run downloads the Android runtime bundle. Apps use the GPU, sound, the camera through PipeWire, location and notifications
      of the desktop.</p>
  </description>
  <launchable type="desktop-id">io.github.erfanoabdi.Apklayer.desktop</launchable>
  <provides>
    <binary>apklayer</binary>
  </provides>
  <url type="homepage">https://github.com/erfanoabdi/apklayer</url>
  <url type="bugtracker">https://github.com/erfanoabdi/apklayer/issues</url>
  <url type="vcs-browser">https://github.com/erfanoabdi/apklayer</url>
  <screenshots>
    <screenshot type="default">
      <caption>An Android app in its own window</caption>
      <image>https://raw.githubusercontent.com/erfanoabdi/apklayer/main/docs/img/mobile/mobile-desktop.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd8d8</color>
    <color type="primary" scheme_preference="dark">#18464d</color>
  </branding>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.4.8" date="2026-11-09"/>
  </releases>
</component>
